# Antigüedad mínima de una versión antes de instalarla: 7 días. Los paquetes
# comprometidos de la cadena de suministro se detectan y se retiran casi
# siempre en las primeras horas; esperar una semana deja pasar esa ventana sin
# congelar el proyecto. El valor va en DÍAS (npm 11.6 o superior). Actúa al
# añadir o actualizar dependencias, no en el `npm ci` del despliegue, que
# instala exactamente lo que dice package-lock.json.
min-release-age=7
