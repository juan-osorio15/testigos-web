---
/**
 * /programacion/ se retiró el 2026-09-29: repetía la agenda de la portada
 * y cada charla ya tiene su página (/programacion/<slug>/). Queda solo esta
 * redirección, sin índice, para enlaces guardados y resultados de búsqueda.
 * GitHub Pages no hace redirecciones de servidor: va por meta refresh y
 * canonical a la portada.
 */
import { SITE_URL } from '../config';

const target = '/#agenda';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Programación · Testigos de la Memoria</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={`${SITE_URL}/`} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p>La programación está en la <a href={target}>agenda de la portada</a>.</p>
  </body>
</html>
