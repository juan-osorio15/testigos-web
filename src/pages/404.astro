---
/**
 * 404 bilingüe con diseño de marca, noindex (FR-021 — reemplaza y mejora
 * el 404.html del placeholder). GitHub Pages sirve dist/404.html.
 */
import EventLayout from '../layouts/EventLayout.astro';
import { t } from '../i18n/ui';
import LogoSymbol from '../assets/logo/logo-symbol.svg';
---

<EventLayout
  locale="es"
  title="Página no encontrada — Testigos de la Memoria"
  description="Página no encontrada."
  noindex
>
  <main id="contenido" class="nf">
    <div class="container nf-inner">
      <LogoSymbol class="nf-symbol" aria-hidden="true" />
      <p class="nf-code" aria-hidden="true">404</p>
      <h1>{t('notfound.title', 'es')}</h1>
      <p>{t('notfound.body', 'es')}</p>
      <p lang="en" class="nf-en">{t('notfound.title', 'en')} — {t('notfound.body', 'en')}</p>
      <div class="nf-actions">
        <a class="cta" href="/">{t('notfound.back', 'es')}</a>
        <a class="nf-en-link" href="/en/" lang="en" hreflang="en">{t('notfound.back', 'en')} →</a>
      </div>
    </div>
  </main>
</EventLayout>

<style>
  .nf {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    display: grid;
    align-content: center;
    background-color: var(--ink);
    color: var(--cream);
    padding-block: calc(var(--header-h) + var(--space-5)) var(--space-5);
  }
  .nf-inner {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }
  .nf-symbol {
    width: 120px;
    height: auto;
    color: var(--terracotta);
  }
  .nf-code {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-display);
    color: var(--terracotta);
    line-height: 1;
  }
  h1 {
    font-size: var(--text-h2);
  }
  .nf-en {
    opacity: 0.75;
  }
  .nf-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
  .nf-en-link {
    font-weight: 700;
  }
</style>
