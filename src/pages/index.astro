---
import EventLayout from '../layouts/EventLayout.astro';
import Hero from '../components/Hero.astro';
import TicketSection from '../components/TicketSection.astro';
import KeyFacts from '../components/KeyFacts.astro';
import Opportunity from '../components/Opportunity.astro';
import SpeakerGrid from '../components/SpeakerGrid.astro';
import Schedule from '../components/Schedule.astro';
import Interlude from '../components/Interlude.astro';
import VenueMap from '../components/VenueMap.astro';
import FAQ from '../components/FAQ.astro';
import { homeGraph } from '../seo/jsonld';

/* Título y descripción: src/routes.ts (aprobados el 2026-09-16, ≤ 60 y ≤ 155) */
---

<EventLayout hero path="/" jsonld={homeGraph()}>
  <Hero />
  {/* Orden (2026-09-18): primero lo urgente para quien no lee: quién
      (caras en el hero y carrusel), precio, cuándo y dónde; el argumento
      largo ("Qué es") va después, para quien quiera profundizar. */}
  <main id="contenido">
    <KeyFacts />
    <SpeakerGrid />
    <TicketSection />
    <Schedule />
    <VenueMap />
    <Opportunity />
    <Interlude />
    <FAQ />
  </main>
</EventLayout>

<style>
  main {
    position: relative;
    z-index: 1;
    background-color: var(--cream);
  }
</style>
