---
/**
 * Marco de las páginas interiores indexables (feature 002): cabecera en
 * bloque de color con antetítulo, migas y h1; cuerpo en crema; y al pie el
 * bloque de hechos del encuentro en texto plano. El header nace sólido.
 * Los metadatos salen de src/routes.ts por `path`; el JSON-LD, del grafo
 * que pase la página (por defecto migas + WebPage).
 */
import EventLayout from './EventLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import EventFacts from '../components/EventFacts.astro';
import { pageGraph } from '../seo/jsonld';

interface Props {
  path: string;
  /** Antetítulo del bloque de cabecera */
  eyebrow: string;
  heading: string;
  lead?: string;
  /** Color del bloque de cabecera (rotación de la fórmula visual) */
  tone?: 'terracotta' | 'sky' | 'olive' | 'brick';
  jsonld?: Record<string, unknown>;
}

const { path, eyebrow, heading, lead, tone = 'terracotta', jsonld = pageGraph(path) } = Astro.props;
---

<EventLayout path={path} jsonld={jsonld}>
  <main id="contenido" class="inner">
    <header class:list={['inner-head', `inner-head--${tone}`]}>
      <div class="container inner-head-inner">
        <Breadcrumbs path={path} />
        <p class="eyebrow">{eyebrow}</p>
        <h1>{heading}</h1>
        {lead && <p class="inner-lead">{lead}</p>}
        <slot name="head-extra" />
      </div>
    </header>
    <div class="inner-body">
      <slot />
    </div>
    <EventFacts />
  </main>
</EventLayout>

<style>
  .inner {
    position: relative;
    z-index: 1;
    background-color: var(--cream);
  }
  .inner-head {
    padding-block: calc(var(--header-h) + var(--space-4)) var(--space-5);
    color: var(--ink);
  }
  .inner-head--terracotta {
    background-color: var(--terracotta);
  }
  .inner-head--sky {
    background-color: var(--sky);
  }
  .inner-head--olive {
    background-color: var(--olive);
    color: var(--cream);
  }
  .inner-head--brick {
    background-color: var(--brick);
    color: var(--cream);
  }
  .inner-head-inner {
    display: grid;
    gap: var(--space-2);
  }
  .inner-head h1 {
    font-size: var(--text-h2);
    max-width: 22ch;
  }
  .inner-lead {
    font-size: var(--text-lead);
    line-height: 1.45;
    max-width: 58ch;
    text-wrap: pretty;
  }
  .inner-body {
    padding-block: var(--space-5) var(--space-6);
  }
</style>
