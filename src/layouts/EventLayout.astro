---
import '../styles/tokens.css';
import '../styles/global.css';
import {
  SITE_URL,
  PRETIX_EVENT_URL,
  PRETIX_WIDGET_CSS,
  PRETIX_WIDGET_SCRIPT,
  pretixReady,
} from '../config';
import { event, venues } from '../data/event';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import archivoUrl from '../assets/fonts/archivo-var.woff2?url';
import frauncesUrl from '../assets/fonts/fraunces-var.woff2?url';
import frauncesItalicUrl from '../assets/fonts/fraunces-var-italic.woff2?url';

interface Props {
  title: string;
  description: string;
  /** noindex para páginas utilitarias (404) */
  noindex?: boolean;
  /** La página abre con el hero: el header nace recogido y baja al hacer
      scroll. Sin hero (404, política de datos) nace visible y sólido. */
  hero?: boolean;
}

const {
  title,
  description,
  noindex = false,
  hero = false,
} = Astro.props;

/* Tienda de Pretix (widget en la cabecera y oferta en JSON-LD): la decide
   el interruptor `pretixReady` de config.ts. */
const pretixLive = pretixReady;

/* Base del despliegue (siempre '/'; se conserva por si cambia el hosting). */
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const forceNoindex = noindex;

/* Canonical de la página actual (la raíz o /tratamiento-de-datos/). */
const canonical = SITE_URL + Astro.url.pathname;
const ogImage = `${SITE_URL}${base}og/og-image.png`;

/* JSON-LD Event — una sola fuente de verdad (src/data/event.ts).
   `offers` solo cuando la tienda de Pretix exista (contrato pretix-embed). */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.name,
  description: event.description,
  startDate: event.startDate,
  endDate: event.endDate,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  inLanguage: 'es',
  image: [ogImage],
  location: venues.map((v) => ({
    '@type': 'Place',
    name: v.name,
    address: {
      '@type': 'PostalAddress',
      streetAddress: v.address,
      addressLocality: 'Villa de Leyva',
      addressRegion: 'Boyacá',
      addressCountry: 'CO',
    },
  })),
  organizer: event.organizers.map((name) => ({ '@type': 'Person', name })),
  ...(pretixLive
    ? {
        offers: {
          '@type': 'Offer',
          url: PRETIX_EVENT_URL,
          availability: 'https://schema.org/InStock',
        },
      }
    : {}),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {forceNoindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesItalicUrl} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={event.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta
      property="og:image:alt"
      content="Testigos de la Memoria: la historia reciente de Colombia, contada por quienes la ven de frente. Villa de Leyva, 5 al 8 de noviembre de 2026."
    />
    <meta property="og:locale" content="es_CO" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {/* Widget de Pretix (v2), tal como lo indica la propia tienda: en <head> */}
    {
      pretixLive && (
        <>
          <link rel="stylesheet" type="text/css" href={PRETIX_WIDGET_CSS} crossorigin="anonymous" />
          <script is:inline type="text/javascript" src={PRETIX_WIDGET_SCRIPT} async crossorigin="anonymous" />
        </>
      )
    }
    <!-- Marca temprana: solo con JS las secciones parten ocultas (R7) -->
    <script is:inline>
      document.documentElement.classList.add('js-reveal');
    </script>
  </head>
  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <Header solid={!hero} />
    <slot />
    <Footer />

    <script>
      /* Header de dos estados + scroll reveal.
         Un solo archivo, dos IntersectionObserver, cero listeners de scroll (R7). */

      // 1. Header: recogido sobre el hero, baja al pasar el primer quinto
      //    del recorrido (el centinela mide 20svh desde arriba).
      const header = document.querySelector('header[data-header]');
      const sentinel = document.querySelector('[data-header-sentinel]');
      if (header && sentinel) {
        new IntersectionObserver(
          ([entry]) => {
            header.classList.toggle('is-solid', !entry.isIntersecting);
          },
          { threshold: 0 }
        ).observe(sentinel);
      } else if (header) {
        // Páginas sin hero (404): header siempre sólido.
        header.classList.add('is-solid');
      }

      // 2. Scrollspy: un punto en el nav marca la sección actual.
      //    La sección que cruza la banda media del viewport activa su enlace.
      const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('header nav a[href*="#"]')];
      const idOf = (a: HTMLAnchorElement) => a.getAttribute('href')!.split('#')[1] ?? '';
      const linkById = new Map(navLinks.map((a) => [idOf(a), a]));
      const inView = new Set<string>();
      const spy = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) inView.add(entry.target.id);
            else inView.delete(entry.target.id);
          }
          const activeId = [...linkById.keys()].find((id) => inView.has(id));
          navLinks.forEach((a) => a.classList.toggle('is-active', idOf(a) === activeId));
        },
        { rootMargin: '-40% 0px -55% 0px' }
      );
      linkById.forEach((_, id) => {
        const section = document.getElementById(id);
        if (section) spy.observe(section);
      });

      // 3. Reveal por sección: una sola vez, unobserve tras disparar.
      const revealer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              revealer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => revealer.observe(el));
    </script>
  </body>
</html>
