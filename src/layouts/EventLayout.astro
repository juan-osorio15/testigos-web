---
import '../styles/tokens.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import {
  SITE_URL,
  PRETIX_WIDGET_CSS,
  PRETIX_WIDGET_SCRIPT,
  measurement,
  pretixReady,
} from '../config';
import { event } from '../data/event';
import { assertAgenda } from '../data/agenda';
import { heroImage } from '../seo/hero';
import { noindexMeta, pageMeta, type PageMeta } from '../seo/meta';
import { routeByPath } from '../routes';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentNotice from '../components/ConsentNotice.astro';
import archivoUrl from '../assets/fonts/archivo-var.woff2?url';
import frauncesUrl from '../assets/fonts/fraunces-var.woff2?url';
import frauncesItalicUrl from '../assets/fonts/fraunces-var-italic.woff2?url';

interface Props {
  /**
   * Ruta registrada en src/routes.ts: de ahí salen título, descripción,
   * canonical e imagen de vista previa. Las páginas noindex (legales, 404)
   * no tienen ruta y pasan `title` y `description` a mano.
   */
  path?: string;
  title?: string;
  description?: string;
  /** noindex, follow: páginas utilitarias y legales */
  noindex?: boolean;
  /** La página abre con el hero: el header nace recogido y baja al hacer
      scroll. Sin hero (404, política de datos) nace visible y sólido. */
  hero?: boolean;
  /** Grafo JSON-LD de la página (src/seo/jsonld.ts); sin él no se emite marcado */
  jsonld?: Record<string, unknown>;
}

const { path, title, description, noindex = false, hero = false, jsonld } = Astro.props;

/* Datos de la agenda coherentes antes de emitir cualquier marcado */
assertAgenda();

/* Base del despliegue (siempre '/'; se conserva por si cambia el hosting). */
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';

/* Metadatos: por ruta registrada o a mano (noindex). */
const homeOg = `${SITE_URL}${base}og/og-image-v2.png`;
let meta: PageMeta;
if (path) {
  meta = pageMeta(routeByPath(path));
} else {
  if (!title || !description) throw new Error('EventLayout: sin `path` hacen falta `title` y `description`');
  meta = noindexMeta(title, description, Astro.url.pathname, homeOg);
  if (!noindex) throw new Error(`EventLayout: la página ${Astro.url.pathname} debe registrarse en src/routes.ts o llevar noindex`);
}

/* Tienda de Pretix (widget en la cabecera): la decide `pretixReady`. */
const pretixLive = pretixReady;

/* Precarga de la imagen principal: mismo srcset que la <Image> del hero. */
const heroPreload = hero
  ? await getImage({ src: heroImage.src, widths: [...heroImage.widths], format: 'webp' })
  : null;

/* Medición: solo con identificadores; sin ellos el HTML no menciona a Google ni a Meta. */
const ga4 = measurement.ga4Id;
const consentGranted = JSON.stringify({
  analytics_storage: 'granted',
  ad_storage: 'granted',
  ad_user_data: 'granted',
  ad_personalization: 'granted',
});
/* Consent Mode antes de gtag: todo denegado; concedido si ya hay aceptación
   vigente guardada (dictamen legal: sin cookies antes de Aceptar). */
const consentBootstrap = ga4
  ? `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}window.gtag=gtag;` +
    `gtag('consent','default',{analytics_storage:'denied',ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',wait_for_update:500});` +
    `try{var c=JSON.parse(localStorage.getItem('tdm.consent')||'null');if(c&&c.version===${JSON.stringify(measurement.consentVersion)}&&c.acceptedAt){gtag('consent','update',${consentGranted});}}catch(e){}` +
    `gtag('js',new Date());gtag('config',${JSON.stringify(ga4)},{send_page_view:true});`
  : '';

---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="robots" content={meta.robots} />
    <link rel="canonical" href={meta.canonical} />
    {measurement.metaDomainVerification && (
      <meta name="facebook-domain-verification" content={measurement.metaDomainVerification} />
    )}
    {/* Favicon en cuatro formas: el .ico en la raíz y el PNG de 96/192 son
        los que Google lee para el resultado de búsqueda (múltiplos de 48);
        el SVG lo prefieren los navegadores modernos; el apple-touch-icon,
        iOS al guardar en la pantalla de inicio. */}
    <link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
    <link rel="icon" href={`${base}favicon-96.png`} type="image/png" sizes="96x96" />
    <link rel="icon" href={`${base}favicon-192.png`} type="image/png" sizes="192x192" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    {
      heroPreload && (
        <link
          rel="preload"
          as="image"
          href={heroPreload.src}
          imagesrcset={heroPreload.srcSet.attribute}
          imagesizes={heroImage.sizes}
          fetchpriority="high"
        />
      )
    }
    {ga4 && <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />}
    {pretixLive && <link rel="preconnect" href="https://pretix.eventalist.co" crossorigin />}
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesItalicUrl} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={event.name} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={meta.canonical} />
    <meta property="og:image" content={meta.ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content={meta.ogImage.endsWith('.jpg') ? 'image/jpeg' : 'image/png'} />
    <meta property="og:image:alt" content={`${meta.title}. ${meta.description}`} />
    <meta property="og:locale" content="es_CO" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={meta.ogImage} />
    {jsonld && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    {/* GA4 en Consent Mode (denegado hasta Aceptar); async detrás de la imagen principal */}
    {
      ga4 && (
        <>
          <script is:inline set:html={consentBootstrap} />
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`} />
        </>
      )
    }
    {/* Widget de Pretix (v2), tal como lo indica la propia tienda: en <head> */}
    {
      pretixLive && (
        <>
          <link rel="stylesheet" type="text/css" href={PRETIX_WIDGET_CSS} crossorigin="anonymous" />
          <script is:inline type="text/javascript" src={PRETIX_WIDGET_SCRIPT} async crossorigin="anonymous" />
        </>
      )
    }
    <!-- Marca temprana: solo con JS las secciones parten ocultas (R7) -->
    <script is:inline>
      document.documentElement.classList.add('js-reveal');
    </script>
  </head>
  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <Header solid={!hero} />
    <slot />
    <Footer />
    <ConsentNotice />

    <script>
      import { initMeasurement } from '../measurement/tags';

      /* Header de dos estados + scroll reveal.
         Un solo archivo, dos IntersectionObserver, cero listeners de scroll (R7). */

      // 1. Header: recogido sobre el hero, baja al pasar el primer quinto
      //    del recorrido (el centinela mide 20svh desde arriba).
      const header = document.querySelector('header[data-header]');
      const sentinel = document.querySelector('[data-header-sentinel]');
      if (header && sentinel) {
        new IntersectionObserver(
          ([entry]) => {
            header.classList.toggle('is-solid', !entry.isIntersecting);
          },
          { threshold: 0 }
        ).observe(sentinel);
      } else if (header) {
        // Páginas sin hero (404): header siempre sólido.
        header.classList.add('is-solid');
      }

      // 2. Scrollspy: un punto en el nav marca la sección actual.
      //    La sección que cruza la banda media del viewport activa su enlace.
      const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('header nav a[href*="#"]')];
      const idOf = (a: HTMLAnchorElement) => a.getAttribute('href')!.split('#')[1] ?? '';
      const linkById = new Map(navLinks.map((a) => [idOf(a), a]));
      const inView = new Set<string>();
      const spy = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) inView.add(entry.target.id);
            else inView.delete(entry.target.id);
          }
          const activeId = [...linkById.keys()].find((id) => inView.has(id));
          navLinks.forEach((a) => a.classList.toggle('is-active', idOf(a) === activeId));
        },
        { rootMargin: '-40% 0px -55% 0px' }
      );
      linkById.forEach((_, id) => {
        const section = document.getElementById(id);
        if (section) spy.observe(section);
      });

      // 3. Reveal por sección: una sola vez, unobserve tras disparar.
      const revealer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              revealer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => revealer.observe(el));

      // 4. Medición: consentimiento, etiquetas e intención de compra
      //    (feature 002). Nada viaja al widget de Pretix.
      initMeasurement();
    </script>
  </body>
</html>
