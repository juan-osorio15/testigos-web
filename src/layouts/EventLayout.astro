---
import '../styles/tokens.css';
import '../styles/global.css';
import { SITE_URL, PRETIX_EVENT_URL, pretixReady } from '../config';
import { t, type Locale } from '../i18n/ui';
import { localePath } from '../i18n/routes';
import { event, venues } from '../data/event';
import Header from '../components/Header.astro';
import LogoSymbol from '../assets/logo/logo-symbol.svg';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** noindex para páginas utilitarias (404) */
  noindex?: boolean;
}

const { locale, title, description, noindex = false } = Astro.props;

const canonical = SITE_URL + localePath(locale);
const esUrl = SITE_URL + localePath('es');
const enUrl = SITE_URL + localePath('en');
const ogLocale = locale === 'es' ? 'es_CO' : 'en_US';
const ogLocaleAlt = locale === 'es' ? 'en_US' : 'es_CO';

/* JSON-LD Event — una sola fuente de verdad (src/data/event.ts).
   `offers` solo cuando la tienda de Pretix exista (contrato pretix-embed). */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.name,
  description: event.description[locale],
  startDate: event.startDate,
  endDate: event.endDate,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  inLanguage: locale,
  image: [`${SITE_URL}/og/og-image.png`],
  location: venues.map((v) => ({
    '@type': 'Place',
    name: v.name,
    address: {
      '@type': 'PostalAddress',
      streetAddress: v.address,
      addressLocality: 'Villa de Leyva',
      addressRegion: 'Boyacá',
      addressCountry: 'CO',
    },
  })),
  organizer: event.organizers.map((name) => ({ '@type': 'Person', name })),
  ...(pretixReady
    ? {
        offers: {
          '@type': 'Offer',
          url: PRETIX_EVENT_URL,
          availability: 'https://schema.org/InStock',
        },
      }
    : {}),
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={noindex ? SITE_URL + '/' : canonical} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/archivo-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/fraunces-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/fraunces-var-italic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={event.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE_URL}/og/og-image.png`} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <!-- Marca temprana: solo con JS las secciones parten ocultas (R7) -->
    <script is:inline>
      document.documentElement.classList.add('js-reveal');
    </script>
  </head>
  <body>
    <a href="#contenido" class="skip-link">{locale === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <Header locale={locale} />
    <slot />
    <footer class="footer">
      <div class="container footer-inner">
        <LogoSymbol class="footer-symbol" aria-hidden="true" width={94} height={25} />
        <p class="footer-org">
          <span class="eyebrow">{t('footer.organizedBy', locale)}</span>
          {event.organizers.join(' · ')}
        </p>
        <p class="footer-small">{t('footer.rights', locale)}</p>
      </div>
    </footer>

    <script>
      /* Header de dos estados + scroll reveal.
         Un solo archivo, dos IntersectionObserver, cero listeners de scroll (R7). */

      // 1. Header: translúcido sobre el hero, sólido después.
      const header = document.querySelector('header[data-header]');
      const sentinel = document.querySelector('[data-header-sentinel]');
      if (header && sentinel) {
        new IntersectionObserver(
          ([entry]) => {
            header.classList.toggle('is-solid', !entry.isIntersecting);
          },
          { rootMargin: '-72px 0px 0px 0px' }
        ).observe(sentinel);
      } else if (header) {
        // Páginas sin hero (404): header siempre sólido.
        header.classList.add('is-solid');
      }

      // 2. Reveal por sección: una sola vez, unobserve tras disparar.
      const revealer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              revealer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => revealer.observe(el));

      // 3. Selector de idioma: preservar la sección activa (mejora progresiva).
      const langLink = document.querySelector<HTMLAnchorElement>('[data-lang-link]');
      if (langLink) {
        const base = langLink.getAttribute('href') ?? '/';
        addEventListener('hashchange', () => {
          langLink.href = base + location.hash;
        });
        if (location.hash) langLink.href = base + location.hash;
      }
    </script>
  </body>
</html>

<style>
  .footer {
    /* Sobre el hero fijo (z 0), como el resto de la cortina */
    position: relative;
    z-index: 1;
    background-color: var(--ink);
    color: var(--cream);
    padding-block: var(--space-5);
  }
  .footer-inner {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }
  .footer-symbol {
    width: 94px;
  }
  .footer-org {
    display: grid;
    gap: 0.35rem;
    font-weight: 500;
  }
  .footer-org .eyebrow {
    color: var(--terracotta);
  }
  .footer-small {
    font-size: var(--text-small);
    opacity: 0.7;
  }
</style>
