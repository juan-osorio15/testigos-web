---
/**
 * Aviso de cookies y gestor de preferencias (feature 002, dictamen legal
 * 2026-09-15). Dos formas, según `measurement.consentUi`: 'bar' es un
 * bloque de tinta al pie de la pantalla, fijo hasta que se acepta o se
 * cierra; 'modal' (prueba del 2026-09-18) es un <dialog> centrado.
 *
 * Modal estándar desde el 2026-10-15: "Usamos cookies" en una línea, un
 * botón grande de "Aceptar" y, en pequeño, "Configurar". No se cierra de
 * otra forma: ni ×, ni Escape, ni clic fuera (las cookies son la base de
 * la medición). "Configurar" muestra analítica y publicidad, las dos
 * activadas: quien no las quiere las apaga una por una y pulsa "Guardar"
 * (con las dos apagadas no acepta nada y el aviso no vuelve en la sesión).
 * El gestor (<dialog>) lo abre el enlace "Cookies y preferencias" del pie
 * y permite cambiar o retirar la aceptación. Sin JS no aparece nada y no
 * se carga ninguna etiqueta: el HTML del aviso vive en un <template>.
 *
 * Con identificadores de medición vacíos el aviso tampoco se muestra:
 * no habría nada que autorizar.
 */
import { measurement } from '../config';
import { tFor } from '../ui';

const t = tFor(Astro.url.pathname);

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const policyHref = `${base}tratamiento-de-datos/#cookies`;
const enabled = !!(measurement.ga4Id || measurement.metaPixelId);
const options = [
  { name: 'analytics', label: t('consent.analytics'), text: t('consent.analyticsText') },
  { name: 'advertising', label: t('consent.advertising'), text: t('consent.advertisingText') },
] as const;
---

{
  enabled && (
    <>
      <template data-consent-template>
        <aside class="consent" data-consent role="region" aria-label={t('consent.prefsTitle')}>
          <div class="container consent-inner">
            <p class="consent-text">
              {t('consent.text')}
              <a href={policyHref}>{t('consent.more')}</a>
            </p>
            <div class="consent-actions">
              <button type="button" class="consent-accept" data-consent-accept>
                {t('consent.accept')}
              </button>
              <button type="button" class="consent-close" data-consent-close aria-label={t('consent.close')}>
                ×
              </button>
            </div>
          </div>
        </aside>
      </template>

      {
        measurement.consentUi === 'modal' && (
          <dialog class="prefs consent-modal" data-consent-modal aria-labelledby="consent-modal-title">
            <div class="prefs-body consent-modal-body" data-modal-step="1">
              <h2 id="consent-modal-title" class="prefs-title">
                {t('consent.modalTitle')}
              </h2>
              <p class="prefs-text">
                {t('consent.text')} <a href={policyHref}>{t('consent.more')}</a>
              </p>
              <button type="button" class="consent-accept consent-modal-accept" data-modal-accept autofocus>
                {t('consent.accept')}
              </button>
              <button type="button" class="consent-modal-skip" data-modal-more>
                {t('consent.configure')}
              </button>
            </div>
            <div class="prefs-body consent-modal-body" data-modal-step="2" hidden>
              <h2 class="prefs-title">{t('consent.optionsTitle')}</h2>
              {options.map((o) => (
                <label class="prefs-option">
                  <span class="prefs-option-text">
                    <strong>{o.label}</strong>
                    <span>{o.text}</span>
                  </span>
                  <input type="checkbox" role="switch" name={o.name} checked />
                </label>
              ))}
              <button type="button" class="consent-accept consent-modal-accept" data-modal-accept>
                {t('consent.acceptAll')}
              </button>
              <button type="button" class="consent-modal-skip" data-modal-save>
                {t('consent.save')}
              </button>
              <a class="consent-options-policy" href={policyHref}>{t('consent.policy')}</a>
            </div>
          </dialog>
        )
      }

      <dialog
        class="prefs"
        data-consent-prefs
        data-text-accepted={t('consent.prefsAccepted')}
        data-text-none={t('consent.prefsNone')}
        aria-labelledby="prefs-title"
      >
        <div class="prefs-body">
          <p class="eyebrow">{t('consent.prefsTitle')}</p>
          <h2 id="prefs-title" class="prefs-title" data-prefs-status />
          <p class="prefs-id" data-prefs-id hidden>
            <span>{t('consent.prefsId')}</span> <code data-prefs-id-value />
          </p>
          {options.map((o) => (
            <label class="prefs-option">
              <span class="prefs-option-text">
                <strong>{o.label}</strong>
                <span>{o.text}</span>
              </span>
              <input type="checkbox" role="switch" name={o.name} />
            </label>
          ))}
          <p class="prefs-feedback" data-prefs-feedback hidden>
            {t('consent.saved')}
          </p>
          <div class="prefs-actions">
            <button type="button" class="prefs-revoke" data-prefs-save>
              {t('consent.save')}
            </button>
            <a class="prefs-policy" href={policyHref}>
              {t('consent.policy')}
            </a>
          </div>
          <button type="button" class="prefs-close" data-prefs-close aria-label={t('consent.close')}>
            ×
          </button>
        </div>
      </dialog>

      <script>
        import { getConsent, wasDismissed, dismiss, type ConsentScope } from '../measurement/consent';
        import { acceptConsent, revokeConsent, consentAccepted, consentScope } from '../measurement/tags';

        // Categorías marcadas en un panel (modal o gestor)
        const checkedScope = (root: ParentNode): ConsentScope[] =>
          (['analytics', 'advertising'] as const).filter(
            (k) => root.querySelector<HTMLInputElement>(`input[name="${k}"]`)?.checked,
          );

        const tpl = document.querySelector<HTMLTemplateElement>('[data-consent-template]');
        const dialog = document.querySelector<HTMLDialogElement>('[data-consent-prefs]');
        const strings = {
          accepted: dialog?.dataset.textAccepted ?? '',
          none: dialog?.dataset.textNone ?? '',
        };

        let bar: HTMLElement | null = null;
        let sizer: ResizeObserver | null = null;
        const modal = document.querySelector<HTMLDialogElement>('[data-consent-modal]');

        // Publica el alto del aviso en --consent-h para que el hero fijo de
        // la portada se recorte y su franja con el CTA no quede tapada.
        const root = document.documentElement;
        const publishHeight = () => {
          root.style.setProperty('--consent-h', bar ? `${bar.offsetHeight}px` : '0px');
        };

        const showBar = () => {
          if (!tpl || bar || consentAccepted() || wasDismissed()) return;
          const node = tpl.content.firstElementChild?.cloneNode(true) as HTMLElement | null;
          if (!node) return;
          document.body.appendChild(node);
          bar = node;
          publishHeight();
          if (typeof ResizeObserver === 'function') {
            sizer = new ResizeObserver(publishHeight);
            sizer.observe(node);
          } else {
            window.addEventListener('resize', publishHeight);
          }
          node.querySelector('[data-consent-accept]')?.addEventListener('click', async () => {
            await acceptConsent();
            hideBar();
          });
          node.querySelector('[data-consent-close]')?.addEventListener('click', () => {
            dismiss();
            hideBar();
          });
        };
        const hideBar = () => {
          sizer?.disconnect();
          sizer = null;
          window.removeEventListener('resize', publishHeight);
          bar?.remove();
          bar = null;
          publishHeight();
        };

        // --- Gestor de preferencias ---
        const fmt = (iso: string) =>
          new Date(iso).toLocaleString(document.documentElement.lang === 'en' ? 'en-US' : 'es-CO', {
            dateStyle: 'long',
            timeStyle: 'short',
            timeZone: 'America/Bogota',
          });

        const render = () => {
          if (!dialog) return;
          const state = getConsent();
          const ok = consentAccepted();
          const status = dialog.querySelector<HTMLElement>('[data-prefs-status]');
          const idRow = dialog.querySelector<HTMLElement>('[data-prefs-id]');
          const idVal = dialog.querySelector<HTMLElement>('[data-prefs-id-value]');
          if (status) status.textContent = ok && state?.acceptedAt ? strings.accepted.replace('{date}', fmt(state.acceptedAt)) : strings.none;
          if (idRow && idVal) {
            idRow.hidden = !(ok && state?.id);
            idVal.textContent = state?.id ?? '';
          }
          // Los interruptores muestran lo aceptado hoy en este navegador
          const scope = consentScope();
          dialog.querySelectorAll<HTMLInputElement>('input[role="switch"]').forEach((i) => {
            i.checked = scope.includes(i.name as ConsentScope);
          });
        };

        const openPrefs = () => {
          if (!dialog || typeof dialog.showModal !== 'function') return false;
          const fb = dialog.querySelector<HTMLElement>('[data-prefs-feedback]');
          if (fb) fb.hidden = true;
          render();
          dialog.showModal();
          return true;
        };

        if (dialog) {
          dialog.querySelector('[data-prefs-close]')?.addEventListener('click', () => dialog.close());
          dialog.addEventListener('click', (e) => {
            if (e.target === dialog) dialog.close();
          });
          // Guardar: acepta lo marcado; con todo apagado retira la aceptación
          dialog.querySelector('[data-prefs-save]')?.addEventListener('click', async () => {
            const scope = checkedScope(dialog);
            if (scope.length > 0) {
              await acceptConsent(scope);
              hideBar();
              if (modal?.open) modal.close();
            } else if (consentAccepted()) {
              await revokeConsent();
            }
            render();
            const fb = dialog.querySelector<HTMLElement>('[data-prefs-feedback]');
            if (fb) fb.hidden = false;
          });
        }

        // El enlace del pie abre el gestor; sin JS lleva a la política.
        document.querySelectorAll<HTMLAnchorElement>('[data-open-consent-prefs]').forEach((a) => {
          a.addEventListener('click', (e) => {
            if (openPrefs()) e.preventDefault();
          });
        });

        // --- Aviso: modal si está configurado y el navegador lo soporta;
        // si no, la franja. El modal espera medio segundo para que la
        // primera impresión sea el hero, no el aviso.
        const showModal = (): boolean => {
          if (!modal || typeof modal.showModal !== 'function') return false;
          if (consentAccepted() || wasDismissed()) return true;
          const close = () => {
            if (modal.open) modal.close();
          };
          let decided = false;
          const finish = () => {
            decided = true;
            close();
          };
          modal.querySelectorAll('[data-modal-accept]').forEach((b) =>
            b.addEventListener('click', async () => {
              await acceptConsent();
              finish();
            }),
          );
          // "Configurar": segundo paso con las dos categorías activadas
          modal.querySelector('[data-modal-more]')?.addEventListener('click', () => {
            const [one, two] = modal.querySelectorAll<HTMLElement>('[data-modal-step]');
            if (!one || !two) return;
            one.hidden = true;
            two.hidden = false;
            two.querySelector<HTMLElement>('input')?.focus();
          });
          // "Guardar": acepta lo que siga encendido; con todo apagado no
          // acepta nada y el aviso no vuelve en la sesión
          modal.querySelector('[data-modal-save]')?.addEventListener('click', async () => {
            const scope = checkedScope(modal);
            if (scope.length > 0) await acceptConsent(scope);
            else dismiss();
            finish();
          });
          // Solo se sale por los botones: Escape y clic fuera no hacen nada.
          // Si el navegador lo cierra igual (Escape repetido), vuelve a abrir.
          modal.addEventListener('cancel', (e) => e.preventDefault());
          modal.addEventListener('close', () => {
            if (!decided && !consentAccepted() && !wasDismissed()) modal.showModal();
          });
          window.setTimeout(() => {
            if (!consentAccepted() && !wasDismissed() && !modal.open) modal.showModal();
          }, 500);
          return true;
        };
        if (!showModal()) showBar();
      </script>
    </>
  )
}

<style is:global>
  /* --- Aviso: franja baja en tinta con el botón de aceptar en terracota,
     para que se vea y se acepte (2026-09-18: antes pasaba desapercibida
     y sin aceptación no hay medición útil). Sin filo de color arriba: el
     bloque de tinta se toca con lo que haya encima, como el resto de
     bloques. Dos líneas en escritorio, tres o cuatro en móvil. ---------- */
  .consent {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 60;
    background-color: var(--ink);
    color: var(--cream);
    padding-block: 1rem;
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .consent-inner {
    display: flex;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
  .consent-text {
    flex: 1 1 auto;
    max-width: 70ch;
    text-wrap: pretty;
  }
  .consent-text a {
    margin-left: 0.35em;
    text-underline-offset: 0.2em;
    white-space: nowrap;
  }
  .consent-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
    flex: 0 0 auto;
  }
  .consent-accept {
    padding: 0.7em 1.6em;
    border: 1px solid var(--terracotta);
    border-radius: 0;
    background-color: var(--terracotta);
    color: var(--ink);
    font-weight: 800;
    font-size: 1rem;
    transition: background-color 160ms var(--ease-out), border-color 160ms var(--ease-out), color 160ms var(--ease-out);
  }
  .consent-accept:hover,
  .consent-accept:focus-visible {
    background-color: var(--cream);
    border-color: var(--cream);
    color: var(--ink);
  }
  .consent-close {
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    color: var(--cream);
    font-size: 1.25rem;
    line-height: 1;
    opacity: 0.7;
  }
  .consent-close:hover,
  .consent-close:focus-visible {
    opacity: 1;
  }
  @media (max-width: 47.9rem) {
    .consent-inner {
      flex-wrap: wrap;
      row-gap: 0.5rem;
    }
    .consent-text {
      flex-basis: 100%;
    }
    .consent-actions {
      margin-left: 0;
    }
  }

  /* --- Aviso modal: la tarjeta del gestor, con un solo botón grande y el
     "seguir sin aceptar" en texto pequeño debajo, visible pero sin competir */
  .consent-modal-body {
    justify-items: start;
  }
  .consent-modal .prefs-title {
    padding-right: 0;
  }
  .consent-modal .prefs-text a {
    margin-left: 0.35em;
    text-underline-offset: 0.2em;
  }
  .prefs .consent-modal-accept {
    margin-top: var(--space-1);
    padding: 0.9em 2em;
    font-size: 1.0625rem;
  }
  .consent-modal-skip {
    padding: 0.2em 0;
    border: 0;
    border-radius: 0;
    background: none;
    color: var(--ink);
    font-size: var(--text-small);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    opacity: 0.75;
    cursor: pointer;
  }
  .consent-modal-skip:hover,
  .consent-modal-skip:focus-visible {
    opacity: 1;
  }
  .consent-modal-body[hidden] {
    display: none;
  }
  /* --- Interruptores de analítica y publicidad (modal y gestor) */
  .prefs-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    width: 100%;
    padding-block: var(--space-2);
    border-top: 1px solid rgba(33, 8, 4, 0.15);
    cursor: pointer;
  }
  .prefs-option-text {
    display: grid;
    gap: 0.15rem;
    font-size: var(--text-small);
    line-height: 1.45;
  }
  .prefs-option-text strong {
    font-size: 1rem;
  }
  /* El checkbox nativo con forma de switch */
  .prefs-option input {
    appearance: none;
    flex: 0 0 auto;
    position: relative;
    width: 2.75rem;
    height: 1.5rem;
    margin: 0;
    border: var(--border) var(--ink);
    border-radius: 999px;
    background-color: #fff;
    cursor: pointer;
    transition: background-color 160ms var(--ease-out);
  }
  .prefs-option input::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0.2rem;
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 999px;
    background-color: var(--ink);
    transform: translateY(-50%);
    transition: transform 160ms var(--ease-out), background-color 160ms var(--ease-out);
  }
  .prefs-option input:checked {
    background-color: var(--olive);
    border-color: var(--olive);
  }
  .prefs-option input:checked::after {
    background-color: #fff;
    transform: translate(1.2rem, -50%);
  }
  .prefs-option input:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .consent-options-policy {
    font-size: var(--text-small);
    color: var(--ink);
    text-underline-offset: 0.2em;
  }

  /* --- Gestor de preferencias: la misma tarjeta que el modal "avísame" */
  .prefs {
    margin: auto;
    width: min(100% - 2rem, 32rem);
    max-height: calc(100dvh - 2rem);
    padding: 0;
    border: var(--border) var(--ink);
    border-radius: 0;
    background-color: #fff;
    color: var(--ink);
    overflow: auto;
  }
  .prefs::backdrop {
    background-color: rgba(33, 8, 4, 0.65);
  }
  .prefs-body {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
  }
  .prefs-body .eyebrow {
    color: var(--brick);
  }
  .prefs-title {
    font-size: var(--text-h3);
    line-height: 1.25;
    padding-right: 2.5rem;
  }
  .prefs-text,
  .prefs-id,
  .prefs-feedback {
    font-size: var(--text-small);
    line-height: 1.5;
  }
  .prefs-id code {
    font-size: 0.8125rem;
    word-break: break-all;
  }
  .prefs-feedback {
    font-weight: 700;
    color: var(--olive);
  }
  .prefs-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }
  .prefs .consent-accept {
    padding: 0.7em 1.5em;
    border: var(--border) var(--terracotta);
    background-color: var(--terracotta);
    color: var(--ink);
    font-size: 0.9375rem;
  }
  .prefs .consent-accept:hover,
  .prefs .consent-accept:focus-visible {
    background-color: var(--brick);
    border-color: var(--brick);
    color: var(--cream);
  }
  .prefs-revoke {
    padding: 0.7em 1.5em;
    border: var(--border) var(--ink);
    border-radius: 0;
    background: none;
    color: var(--ink);
    font-weight: 800;
    font-size: 0.9375rem;
  }
  .prefs-revoke:hover,
  .prefs-revoke:focus-visible {
    background-color: var(--ink);
    color: var(--cream);
  }
  .prefs-policy {
    font-size: var(--text-small);
    font-weight: 700;
    text-underline-offset: 0.2em;
  }
  .prefs-close {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: var(--border) var(--ink);
    border-radius: 0;
    background-color: var(--cream);
    color: var(--ink);
    font-size: 1.5rem;
    line-height: 1;
  }
  .prefs-close:hover,
  .prefs-close:focus-visible {
    background-color: var(--ink);
    color: var(--cream);
  }
</style>
