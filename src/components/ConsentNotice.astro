---
/**
 * Aviso de cookies y gestor de preferencias (feature 002, dictamen legal
 * 2026-09-15).
 *
 * Panel al pie desde el 2026-10-26: el modal centrado bloqueaba la página
 * y generaba fricción, y una barrita delgada se ignora. El panel ocupa
 * cerca de un cuarto de la pantalla, de lado a lado: la página se ve y se
 * recorre detrás, pero el panel sigue ahí, en todas las páginas, hasta que
 * la persona decide. Solo se quita con "Aceptar" (botón grande) o con
 * "Configurar" (en pequeño): ni ×, ni Escape (las cookies son la base de
 * la medición). Arriba, el texto estándar ("Usamos cookies") y tres frases
 * cortas que tranquilizan.
 *
 * Mientras la persona mira el hero no hay aviso. Cuando baja más de un
 * cuarto de pantalla, el panel sube desde el borde inferior y todo lo de
 * encima se oscurece, con la misma curva; ya no se va aunque vuelva a
 * subir. En una página demasiado corta para bajar, sale de una vez. En
 * cada página empieza de nuevo. Si a los 7 segundos de oscurecerse sigue sin decidir, el botón
 * de aceptar empieza a palpitar, para quien no relacione el velo con él.
 *
 * "Configurar" abre una tarjeta centrada con esas tres frases explicadas
 * y las dos categorías, analítica y publicidad, activadas: quien no las
 * quiere las apaga una por una y pulsa "Guardar" (con las dos apagadas no
 * acepta nada y el aviso no vuelve en la sesión). Si la cierra sin
 * decidir, vuelve al panel.
 *
 * El gestor (<dialog>) lo abre el enlace "Cookies y preferencias" del pie
 * y permite cambiar o retirar la aceptación. Sin JS no aparece nada y no
 * se carga ninguna etiqueta: el HTML del aviso vive en un <template>.
 *
 * Con identificadores de medición vacíos el aviso tampoco se muestra:
 * no habría nada que autorizar.
 */
import { measurement } from '../config';
import { tFor } from '../ui';

const t = tFor(Astro.url.pathname);

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const policyHref = `${base}tratamiento-de-datos/#cookies`;
const enabled = !!(measurement.ga4Id || measurement.metaPixelId);
const options = [
  { name: 'analytics', label: t('consent.analytics'), text: t('consent.analyticsText') },
  { name: 'advertising', label: t('consent.advertising'), text: t('consent.advertisingText') },
] as const;
const points = [
  { title: t('consent.point1'), text: t('consent.point1Text') },
  { title: t('consent.point2'), text: t('consent.point2Text') },
  { title: t('consent.point3'), text: t('consent.point3Text') },
];
---

{
  enabled && (
    <>
      <template data-consent-template>
        <aside class="consent" data-consent role="region" aria-labelledby="consent-title">
          <div class="container consent-inner">
            <div class="consent-copy">
              <h2 id="consent-title" class="consent-title">
                {t('consent.title')}
              </h2>
              <p class="consent-text">
                {t('consent.text')} <a href={policyHref}>{t('consent.more')}</a>
              </p>
              <ul class="consent-points">
                {points.map((p) => (
                  <li>{p.title}</li>
                ))}
              </ul>
            </div>
            <div class="consent-actions">
              <button type="button" class="consent-accept" data-consent-accept>
                {t('consent.accept')}
              </button>
              <button type="button" class="consent-more" data-consent-more>
                {t('consent.configure')}
              </button>
            </div>
          </div>
        </aside>
      </template>

      <dialog class="prefs consent-config" data-consent-config aria-labelledby="consent-config-title">
        <div class="prefs-body">
          <h2 id="consent-config-title" class="prefs-title">
            {t('consent.optionsTitle')}
          </h2>
          <ul class="consent-reasons">
            {points.map((p) => (
              <li>
                <strong>{p.title}</strong>
                <span>{p.text}</span>
              </li>
            ))}
          </ul>
          {options.map((o) => (
            <label class="prefs-option">
              <span class="prefs-option-text">
                <strong>{o.label}</strong>
                <span>{o.text}</span>
              </span>
              <input type="checkbox" role="switch" name={o.name} checked />
            </label>
          ))}
          <button type="button" class="prefs-revoke consent-config-save" data-config-save>
            {t('consent.save')}
          </button>
          <button type="button" class="consent-accept consent-config-accept" data-config-accept>
            {t('consent.acceptAll')}
          </button>
          <a class="consent-options-policy" href={policyHref}>{t('consent.policy')}</a>
        </div>
      </dialog>

      <dialog
        class="prefs"
        data-consent-prefs
        data-text-accepted={t('consent.prefsAccepted')}
        data-text-none={t('consent.prefsNone')}
        aria-labelledby="prefs-title"
      >
        <div class="prefs-body">
          <p class="eyebrow">{t('consent.prefsTitle')}</p>
          <h2 id="prefs-title" class="prefs-title" data-prefs-status />
          <p class="prefs-id" data-prefs-id hidden>
            <span>{t('consent.prefsId')}</span> <code data-prefs-id-value />
          </p>
          {options.map((o) => (
            <label class="prefs-option">
              <span class="prefs-option-text">
                <strong>{o.label}</strong>
                <span>{o.text}</span>
              </span>
              <input type="checkbox" role="switch" name={o.name} />
            </label>
          ))}
          <p class="prefs-feedback" data-prefs-feedback hidden>
            {t('consent.saved')}
          </p>
          <div class="prefs-actions">
            <button type="button" class="prefs-revoke" data-prefs-save>
              {t('consent.save')}
            </button>
            <a class="prefs-policy" href={policyHref}>
              {t('consent.policy')}
            </a>
          </div>
          <button type="button" class="prefs-close" data-prefs-close aria-label={t('consent.close')}>
            ×
          </button>
        </div>
      </dialog>

      <script>
        import { getConsent, wasDismissed, dismiss, type ConsentScope } from '../measurement/consent';
        import { acceptConsent, revokeConsent, consentAccepted, consentScope } from '../measurement/tags';

        // Categorías marcadas en un panel (configuración o gestor)
        const checkedScope = (root: ParentNode): ConsentScope[] =>
          (['analytics', 'advertising'] as const).filter(
            (k) => root.querySelector<HTMLInputElement>(`input[name="${k}"]`)?.checked,
          );

        const tpl = document.querySelector<HTMLTemplateElement>('[data-consent-template]');
        const config = document.querySelector<HTMLDialogElement>('[data-consent-config]');
        const dialog = document.querySelector<HTMLDialogElement>('[data-consent-prefs]');
        const strings = {
          accepted: dialog?.dataset.textAccepted ?? '',
          none: dialog?.dataset.textNone ?? '',
        };

        let bar: HTMLElement | null = null;
        let sizer: ResizeObserver | null = null;
        let nudgeTimer = 0;

        // Panel y velo: salen al bajar más de un cuarto de pantalla y se
        // quedan en esa página aunque la persona vuelva a subir
        const reveal = () => {
          if (!bar || bar.classList.contains('is-shown')) return;
          bar.classList.add('is-shown');
          window.removeEventListener('scroll', onScroll);
          publishHeight();
          // Si a los 7 s sigue sin decidir, el botón de aceptar palpita
          nudgeTimer = window.setTimeout(() => bar?.classList.add('is-nudging'), 7000);
        };
        const onScroll = () => {
          if (window.scrollY > window.innerHeight * 0.25) reveal();
        };

        // Publica el alto del aviso a la vista en --consent-h: las páginas
        // ganan ese espacio al final para que el panel no tape lo último.
        const root = document.documentElement;
        const publishHeight = () => {
          const shown = bar?.classList.contains('is-shown');
          root.style.setProperty('--consent-h', bar && shown ? `${bar.offsetHeight}px` : '0px');
        };

        const hideBar = () => {
          window.removeEventListener('scroll', onScroll);
          window.clearTimeout(nudgeTimer);
          sizer?.disconnect();
          sizer = null;
          window.removeEventListener('resize', publishHeight);
          bar?.remove();
          bar = null;
          publishHeight();
        };

        // "Configurar": la tarjeta con las razones y las dos categorías
        // activadas. Cerrarla sin decidir deja el panel donde estaba.
        const openConfig = () => {
          if (!config || typeof config.showModal !== 'function') return;
          config.querySelectorAll<HTMLInputElement>('input[role="switch"]').forEach((i) => {
            i.checked = true;
          });
          config.showModal();
        };
        if (config) {
          config.addEventListener('click', (e) => {
            if (e.target === config) config.close();
          });
          config.querySelector('[data-config-accept]')?.addEventListener('click', async () => {
            await acceptConsent();
            config.close();
            hideBar();
          });
          // "Guardar": acepta lo que siga encendido; con todo apagado no
          // acepta nada y el aviso no vuelve en la sesión
          config.querySelector('[data-config-save]')?.addEventListener('click', async () => {
            const scope = checkedScope(config);
            if (scope.length > 0) await acceptConsent(scope);
            else dismiss();
            config.close();
            hideBar();
          });
        }

        const showBar = () => {
          if (!tpl || bar || consentAccepted() || wasDismissed()) return;
          const node = tpl.content.firstElementChild?.cloneNode(true) as HTMLElement | null;
          if (!node) return;
          document.body.appendChild(node);
          bar = node;
          publishHeight();
          if (typeof ResizeObserver === 'function') {
            sizer = new ResizeObserver(publishHeight);
            sizer.observe(node);
          } else {
            window.addEventListener('resize', publishHeight);
          }
          node.querySelector('[data-consent-accept]')?.addEventListener('click', async () => {
            await acceptConsent();
            hideBar();
          });
          node.querySelector('[data-consent-more]')?.addEventListener('click', openConfig);
          // Sin recorrido suficiente para bajar, sale de una vez
          const room = document.documentElement.scrollHeight - window.innerHeight;
          if (room < window.innerHeight * 0.5) window.requestAnimationFrame(reveal);
          else window.addEventListener('scroll', onScroll, { passive: true });
        };

        // --- Gestor de preferencias ---
        const fmt = (iso: string) =>
          new Date(iso).toLocaleString(document.documentElement.lang === 'en' ? 'en-US' : 'es-CO', {
            dateStyle: 'long',
            timeStyle: 'short',
            timeZone: 'America/Bogota',
          });

        const render = () => {
          if (!dialog) return;
          const state = getConsent();
          const ok = consentAccepted();
          const status = dialog.querySelector<HTMLElement>('[data-prefs-status]');
          const idRow = dialog.querySelector<HTMLElement>('[data-prefs-id]');
          const idVal = dialog.querySelector<HTMLElement>('[data-prefs-id-value]');
          if (status) status.textContent = ok && state?.acceptedAt ? strings.accepted.replace('{date}', fmt(state.acceptedAt)) : strings.none;
          if (idRow && idVal) {
            idRow.hidden = !(ok && state?.id);
            idVal.textContent = state?.id ?? '';
          }
          // Los interruptores muestran lo aceptado hoy en este navegador
          const scope = consentScope();
          dialog.querySelectorAll<HTMLInputElement>('input[role="switch"]').forEach((i) => {
            i.checked = scope.includes(i.name as ConsentScope);
          });
        };

        const openPrefs = () => {
          if (!dialog || typeof dialog.showModal !== 'function') return false;
          const fb = dialog.querySelector<HTMLElement>('[data-prefs-feedback]');
          if (fb) fb.hidden = true;
          render();
          dialog.showModal();
          return true;
        };

        if (dialog) {
          dialog.querySelector('[data-prefs-close]')?.addEventListener('click', () => dialog.close());
          dialog.addEventListener('click', (e) => {
            if (e.target === dialog) dialog.close();
          });
          // Guardar: acepta lo marcado; con todo apagado retira la aceptación
          dialog.querySelector('[data-prefs-save]')?.addEventListener('click', async () => {
            const scope = checkedScope(dialog);
            if (scope.length > 0) {
              await acceptConsent(scope);
              hideBar();
            } else if (consentAccepted()) {
              await revokeConsent();
            }
            render();
            const fb = dialog.querySelector<HTMLElement>('[data-prefs-feedback]');
            if (fb) fb.hidden = false;
          });
        }

        // El enlace del pie abre el gestor; sin JS lleva a la política.
        document.querySelectorAll<HTMLAnchorElement>('[data-open-consent-prefs]').forEach((a) => {
          a.addEventListener('click', (e) => {
            if (openPrefs()) e.preventDefault();
          });
        });

        showBar();
      </script>
    </>
  )
}

<style is:global>
  /* El final de cada página queda a la vista mientras el panel está abierto */
  body {
    padding-bottom: var(--consent-h, 0px);
  }

  /* --- Aviso: panel crema al pie, un cuarto de la pantalla, sin filo.
     Todo lo de encima queda oscurecido de forma pareja, para
     que el panel salte y estorbe lo suficiente para que se resuelva; el
     velo no captura clics, así que la página sigue usable (2026-10-26: en
     tinta y sin velo pasaba como parte del sitio). Aceptar en terracota;
     "Configurar" en texto pequeño. */
  .consent {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 60;
    display: grid;
    align-items: center;
    min-height: 25svh;
    background-color: var(--cream);
    /* Escondido bajo el borde hasta que la persona baja; sube parejo, sin
       brinco, mientras el velo cae */
    transform: translateY(100%);
    visibility: hidden;
    transition:
      transform 500ms linear,
      visibility 0s 500ms;
    color: var(--ink);
    padding-block: var(--space-4);
    line-height: 1.45;
  }
  /* El velo: cubre la pantalla por encima del panel, sin tapar el panel.
     Aparece cuando la persona empieza a bajar (clase is-shown). */
  .consent::before {
    content: '';
    position: absolute;
    inset: auto 0 100% 0;
    height: 100vh;
    background-color: rgba(33, 8, 4, 0.5);
    pointer-events: none;
    opacity: 0;
    /* Arranque inmediato y frenada suave: se nota el golpe sin brinco */
    transition: opacity 450ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .consent.is-shown {
    transform: none;
    visibility: visible;
    transition:
      transform 500ms linear,
      visibility 0s;
  }
  .consent.is-shown::before {
    opacity: 1;
  }
  /* Palpitar del botón: solo un halo terracota que sale y se desvanece;
     el botón no se mueve */
  .consent.is-nudging .consent-accept {
    animation: consent-pulse 1.6s var(--ease-out) infinite;
  }
  @keyframes consent-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(212, 91, 48, 0.6);
    }
    70% {
      box-shadow: 0 0 0 1rem rgba(212, 91, 48, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(212, 91, 48, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .consent.is-nudging .consent-accept {
      animation: none;
      outline: 3px solid var(--ink);
      outline-offset: 3px;
    }
  }
  .consent-inner {
    display: flex;
    align-items: center;
    gap: var(--space-3) var(--space-5);
  }
  .consent-copy {
    flex: 1 1 auto;
    display: grid;
    gap: 0.5rem;
  }
  .consent-title {
    font-size: var(--text-h2);
    line-height: 1.1;
    color: var(--ink);
  }
  .consent-text {
    font-size: 1.0625rem;
    text-wrap: pretty;
  }
  .consent-text a {
    margin-left: 0.35em;
    color: var(--ink);
    text-underline-offset: 0.2em;
    white-space: nowrap;
  }
  .consent-points {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem var(--space-3);
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 1rem;
    font-weight: 700;
  }
  .consent-points li::before,
  .consent-reasons strong::before {
    content: '✓';
    margin-right: 0.45em;
    color: var(--olive);
    font-weight: 800;
  }
  .consent-actions {
    flex: 0 0 auto;
    display: grid;
    justify-items: center;
    gap: 0.6rem;
  }
  .consent-accept {
    padding: 0.9em 3em;
    border: 1px solid var(--terracotta);
    border-radius: 0;
    background-color: var(--terracotta);
    color: var(--ink);
    font-weight: 800;
    font-size: 1.125rem;
    transition: background-color 160ms var(--ease-out), border-color 160ms var(--ease-out), color 160ms var(--ease-out);
  }
  .consent-accept:hover,
  .consent-accept:focus-visible {
    background-color: var(--ink);
    border-color: var(--ink);
    color: var(--cream);
  }
  .consent-more {
    padding: 0.2em 0;
    border: 0;
    border-radius: 0;
    background: none;
    color: inherit;
    font-size: var(--text-small);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    opacity: 0.75;
    cursor: pointer;
  }
  .consent-more:hover,
  .consent-more:focus-visible {
    opacity: 1;
  }
  @media (max-width: 47.9rem) {
    .consent {
      padding-block: var(--space-3);
    }
    .consent-title {
      font-size: var(--text-h3);
    }
    .consent-inner {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-2);
    }
    .consent-copy {
      gap: 0.35rem;
    }
    .consent-text,
    .consent-points {
      font-size: 0.875rem;
    }
    .consent-points {
      flex-direction: column;
      gap: 0.15rem;
    }
    .consent-actions {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: var(--space-3);
    }
    .consent-accept {
      justify-self: stretch;
      padding-inline: 1em;
    }
  }

  /* --- "Configurar": las tres razones en negrilla oliva, para escanear,
     debajo las categorías con su "Guardar" y al final el botón grande */
  .consent-config .prefs-body {
    justify-items: start;
  }
  .consent-config .prefs-title {
    padding-right: 0;
  }
  .consent-reasons {
    display: grid;
    gap: var(--space-1);
    margin: 0 0 var(--space-1);
    padding: 0;
    list-style: none;
    font-size: var(--text-small);
    line-height: 1.45;
  }
  .consent-reasons li {
    display: grid;
    gap: 0.1rem;
  }
  .consent-reasons strong {
    color: var(--olive);
    font-size: 1rem;
  }
  .consent-reasons span {
    padding-left: 1.3em;
  }
  .prefs .consent-config-accept {
    margin-top: var(--space-1);
    padding: 0.9em 2em;
    font-size: 1.0625rem;
  }
  /* "Guardar" justo debajo de los interruptores, como botón de borde:
     quien llegó hasta aquí ve dónde guardar lo que apagó */
  .consent-config-save {
    justify-self: end;
  }

  /* --- Interruptores de analítica y publicidad (configuración y gestor) */
  .prefs-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    width: 100%;
    padding-block: var(--space-2);
    border-top: 1px solid rgba(33, 8, 4, 0.15);
    cursor: pointer;
  }
  .prefs-option-text {
    display: grid;
    gap: 0.15rem;
    font-size: var(--text-small);
    line-height: 1.45;
  }
  .prefs-option-text strong {
    font-size: 1rem;
  }
  /* El checkbox nativo con forma de switch */
  .prefs-option input {
    appearance: none;
    flex: 0 0 auto;
    position: relative;
    width: 2.75rem;
    height: 1.5rem;
    margin: 0;
    border: var(--border) var(--ink);
    border-radius: 999px;
    background-color: #fff;
    cursor: pointer;
    transition: background-color 160ms var(--ease-out);
  }
  .prefs-option input::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0.2rem;
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 999px;
    background-color: var(--ink);
    transform: translateY(-50%);
    transition: transform 160ms var(--ease-out), background-color 160ms var(--ease-out);
  }
  .prefs-option input:checked {
    background-color: var(--olive);
    border-color: var(--olive);
  }
  .prefs-option input:checked::after {
    background-color: #fff;
    transform: translate(1.2rem, -50%);
  }
  .prefs-option input:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .consent-options-policy {
    font-size: var(--text-small);
    color: var(--ink);
    text-underline-offset: 0.2em;
  }

  /* --- Gestor de preferencias: la misma tarjeta que el modal "avísame" */
  .prefs {
    margin: auto;
    width: min(100% - 2rem, 32rem);
    max-height: calc(100dvh - 2rem);
    padding: 0;
    border: var(--border) var(--ink);
    border-radius: 0;
    background-color: #fff;
    color: var(--ink);
    overflow: auto;
  }
  .prefs::backdrop {
    background-color: rgba(33, 8, 4, 0.65);
  }
  .prefs-body {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
  }
  .prefs-body .eyebrow {
    color: var(--brick);
  }
  .prefs-title {
    font-size: var(--text-h3);
    line-height: 1.25;
    padding-right: 2.5rem;
  }
  .prefs-text,
  .prefs-id,
  .prefs-feedback {
    font-size: var(--text-small);
    line-height: 1.5;
  }
  .prefs-id code {
    font-size: 0.8125rem;
    word-break: break-all;
  }
  .prefs-feedback {
    font-weight: 700;
    color: var(--olive);
  }
  .prefs-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }
  .prefs .consent-accept {
    padding: 0.7em 1.5em;
    border: var(--border) var(--terracotta);
    background-color: var(--terracotta);
    color: var(--ink);
    font-size: 0.9375rem;
  }
  .prefs .consent-accept:hover,
  .prefs .consent-accept:focus-visible {
    background-color: var(--brick);
    border-color: var(--brick);
    color: var(--cream);
  }
  .prefs-revoke {
    padding: 0.7em 1.5em;
    border: var(--border) var(--ink);
    border-radius: 0;
    background: none;
    color: var(--ink);
    font-weight: 800;
    font-size: 0.9375rem;
  }
