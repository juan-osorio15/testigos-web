---
/**
 * Aviso de cookies y configuración (feature 002, dictamen legal
 * 2026-09-15). Estándar desde el 2026-10-15: una franja al pie con una
 * línea de texto, "Configurar" y "Aceptar" (el modal de dos pasos con
 * texto persuasivo interrumpía). "Configurar" abre un panel con dos
 * interruptores, analítica y publicidad, sin marcar; "Guardar" acepta lo
 * marcado y "Aceptar todas", todo. La × cierra la franja por la sesión sin
 * aceptar nada. El enlace "Cookies y preferencias" del pie abre el mismo
 * panel, que también sirve para retirar la aceptación (desmarcar y
 * guardar). Sin JS no aparece nada y no se carga ninguna etiqueta: el HTML
 * de la franja vive en un <template>.
 *
 * Con identificadores de medición vacíos el aviso tampoco se muestra:
 * no habría nada que autorizar.
 */
import { measurement } from '../config';
import { tFor } from '../ui';

const t = tFor(Astro.url.pathname);

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const policyHref = `${base}tratamiento-de-datos/#cookies`;
const enabled = !!(measurement.ga4Id || measurement.metaPixelId);
---

{
  enabled && (
    <>
      <template data-consent-template>
        <aside class="consent" data-consent role="region" aria-label={t('consent.prefsLink')}>
          <div class="container consent-inner">
            <p class="consent-text">
              {t('consent.text')}
              <a href={policyHref}>{t('consent.more')}</a>
            </p>
            <div class="consent-actions">
              <button type="button" class="consent-configure" data-consent-configure>
                {t('consent.configure')}
              </button>
              <button type="button" class="consent-accept" data-consent-accept>
                {t('consent.accept')}
              </button>
              <button type="button" class="consent-close" data-consent-close aria-label={t('consent.close')}>
                ×
              </button>
            </div>
          </div>
        </aside>
      </template>

      <dialog class="prefs" data-consent-prefs aria-labelledby="prefs-title">
        <form class="prefs-body" method="dialog" data-prefs-form>
          <h2 id="prefs-title" class="prefs-title">{t('consent.prefsTitle')}</h2>
          <label class="prefs-option">
            <span class="prefs-option-text">
              <strong>{t('consent.analytics')}</strong>
              <span>{t('consent.analyticsText')}</span>
            </span>
            <input type="checkbox" role="switch" name="analytics" />
          </label>
          <label class="prefs-option">
            <span class="prefs-option-text">
              <strong>{t('consent.advertising')}</strong>
              <span>{t('consent.advertisingText')}</span>
            </span>
            <input type="checkbox" role="switch" name="advertising" />
          </label>
          <div class="prefs-actions">
            <button type="button" class="prefs-save" data-prefs-save>
              {t('consent.save')}
            </button>
            <button type="button" class="consent-accept" data-prefs-accept-all>
              {t('consent.acceptAll')}
            </button>
          </div>
          <p class="prefs-foot">
            <a href={policyHref}>{t('consent.policy')}</a>
            <span class="prefs-id" data-prefs-id hidden>
              {t('consent.prefsId')} <code data-prefs-id-value />
            </span>
          </p>
          <button type="button" class="prefs-close" data-prefs-close aria-label={t('consent.close')}>
            ×
          </button>
        </form>
      </dialog>

      <script>
        import { getConsent, wasDismissed, dismiss, type ConsentScope } from '../measurement/consent';
        import { acceptConsent, revokeConsent, consentAccepted, consentScope } from '../measurement/tags';

        const tpl = document.querySelector<HTMLTemplateElement>('[data-consent-template]');
        const dialog = document.querySelector<HTMLDialogElement>('[data-consent-prefs]');

        let bar: HTMLElement | null = null;
        let sizer: ResizeObserver | null = null;

        // Publica el alto del aviso en --consent-h para que el hero fijo de
        // la portada se recorte y su franja con el CTA no quede tapada.
        const root = document.documentElement;
        const publishHeight = () => {
          root.style.setProperty('--consent-h', bar ? `${bar.offsetHeight}px` : '0px');
        };

        const hideBar = () => {
          sizer?.disconnect();
          sizer = null;
          window.removeEventListener('resize', publishHeight);
          bar?.remove();
          bar = null;
          publishHeight();
        };

        // --- Panel de configuración ---
        const box = (name: ConsentScope) =>
          dialog?.querySelector<HTMLInputElement>(`input[name="${name}"]`) ?? null;

        const openPrefs = () => {
          if (!dialog || typeof dialog.showModal !== 'function') return false;
          const scope = consentScope();
          const a = box('analytics');
          const ad = box('advertising');
          if (a) a.checked = scope.includes('analytics');
          if (ad) ad.checked = scope.includes('advertising');
          const state = getConsent();
          const idRow = dialog.querySelector<HTMLElement>('[data-prefs-id]');
          const idVal = dialog.querySelector<HTMLElement>('[data-prefs-id-value]');
          if (idRow && idVal) {
            idRow.hidden = !(consentAccepted() && state?.id);
            idVal.textContent = state?.id ?? '';
          }
          dialog.showModal();
          return true;
        };

        const done = () => {
          hideBar();
          if (dialog?.open) dialog.close();
        };

        if (dialog) {
          dialog.querySelector('[data-prefs-close]')?.addEventListener('click', () => dialog.close());
          dialog.addEventListener('click', (e) => {
            if (e.target === dialog) dialog.close();
          });
          dialog.querySelector('[data-prefs-accept-all]')?.addEventListener('click', async () => {
            await acceptConsent();
            done();
          });
          // Guardar: acepta lo marcado; sin nada marcado retira la
          // aceptación si la había y, si no, cierra el aviso por la sesión
          dialog.querySelector('[data-prefs-save]')?.addEventListener('click', async () => {
            const scope: ConsentScope[] = [];
            if (box('analytics')?.checked) scope.push('analytics');
            if (box('advertising')?.checked) scope.push('advertising');
            if (scope.length > 0) await acceptConsent(scope);
            else if (consentAccepted()) await revokeConsent();
            else dismiss();
            done();
          });
        }

        // El enlace del pie abre el panel; sin JS lleva a la política.
        document.querySelectorAll<HTMLAnchorElement>('[data-open-consent-prefs]').forEach((a) => {
          a.addEventListener('click', (e) => {
            if (openPrefs()) e.preventDefault();
          });
        });

        // --- Franja ---
        const showBar = () => {
          if (!tpl || bar || consentAccepted() || wasDismissed()) return;
          const node = tpl.content.firstElementChild?.cloneNode(true) as HTMLElement | null;
          if (!node) return;
          document.body.appendChild(node);
          bar = node;
          publishHeight();
          if (typeof ResizeObserver === 'function') {
            sizer = new ResizeObserver(publishHeight);
            sizer.observe(node);
          } else {
            window.addEventListener('resize', publishHeight);
          }
          node.querySelector('[data-consent-accept]')?.addEventListener('click', async () => {
            await acceptConsent();
            hideBar();
          });
          const configure = node.querySelector<HTMLElement>('[data-consent-configure]');
          if (dialog && typeof dialog.showModal === 'function') {
            configure?.addEventListener('click', openPrefs);
          } else {
            configure?.remove();
          }
          node.querySelector('[data-consent-close]')?.addEventListener('click', () => {
            dismiss();
            hideBar();
          });
        };
        showBar();
      </script>
    </>
  )
}

<style is:global>
  /* --- Franja baja en tinta: una línea de texto, "Configurar" en borde
     crema y "Aceptar" en terracota. Dos líneas en móvil. ---------------- */
  .consent {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 60;
    background-color: var(--ink);
    color: var(--cream);
    padding-block: 0.85rem;
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .consent-inner {
    display: flex;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
  .consent-text {
    flex: 1 1 auto;
    max-width: 70ch;
    text-wrap: pretty;
  }
  .consent-text a {
    margin-left: 0.35em;
    text-underline-offset: 0.2em;
    white-space: nowrap;
  }
  .consent-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
    flex: 0 0 auto;
  }
  .consent-accept,
  .consent-configure {
    padding: 0.6em 1.4em;
    border-radius: 0;
    font-weight: 800;
    font-size: 0.9375rem;
    cursor: pointer;
    transition: background-color 160ms var(--ease-out), border-color 160ms var(--ease-out), color 160ms var(--ease-out);
  }
  .consent-accept {
    border: 1px solid var(--terracotta);
    background-color: var(--terracotta);
    color: var(--ink);
  }
  .consent-accept:hover,
  .consent-accept:focus-visible {
    background-color: var(--cream);
    border-color: var(--cream);
    color: var(--ink);
  }
  .consent-configure {
    border: 1px solid var(--cream);
    background: none;
    color: var(--cream);
  }
  .consent-configure:hover,
  .consent-configure:focus-visible {
    background-color: var(--cream);
    color: var(--ink);
  }
  .consent-close {
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    color: var(--cream);
    font-size: 1.25rem;
    line-height: 1;
    opacity: 0.7;
  }
  .consent-close:hover,
  .consent-close:focus-visible {
    opacity: 1;
  }
  @media (max-width: 47.9rem) {
    .consent-inner {
      flex-wrap: wrap;
      row-gap: 0.5rem;
    }
    .consent-text {
      flex-basis: 100%;
    }
    .consent-actions {
      margin-left: 0;
      width: 100%;
    }
    .consent-accept,
    .consent-configure {
      flex: 1 1 0;
    }
  }

  /* --- Panel de configuración: la misma tarjeta que el modal "avísame" */
  .prefs {
    margin: auto;
    width: min(100% - 2rem, 30rem);
    max-height: calc(100dvh - 2rem);
    padding: 0;
    border: var(--border) var(--ink);
    border-radius: 0;
    background-color: #fff;
    color: var(--ink);
    overflow: auto;
  }
  .prefs::backdrop {
    background-color: rgba(33, 8, 4, 0.65);
  }
  .prefs-body {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
  }
  .prefs-title {
    font-size: var(--text-h3);
    line-height: 1.25;
    padding-right: 2.5rem;
  }
  .prefs-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-block: var(--space-2);
    border-top: 1px solid rgba(33, 8, 4, 0.15);
    cursor: pointer;
  }
  .prefs-option-text {
    display: grid;
    gap: 0.15rem;
    font-size: var(--text-small);
    line-height: 1.45;
  }
  .prefs-option-text strong {
    font-size: 1rem;
  }
  /* Interruptor: el checkbox nativo con forma de switch */
  .prefs-option input {
    appearance: none;
    flex: 0 0 auto;
    position: relative;
    width: 2.75rem;
    height: 1.5rem;
    margin: 0;
    border: var(--border) var(--ink);
    border-radius: 999px;
    background-color: #fff;
    cursor: pointer;
    transition: background-color 160ms var(--ease-out);
  }
  .prefs-option input::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0.2rem;
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 999px;
    background-color: var(--ink);
    transform: translateY(-50%);
    transition: transform 160ms var(--ease-out), background-color 160ms var(--ease-out);
  }
  .prefs-option input:checked {
    background-color: var(--olive);
    border-color: var(--olive);
  }
  .prefs-option input:checked::after {
    background-color: #fff;
    transform: translate(1.2rem, -50%);
  }
  .prefs-option input:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .prefs-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }
  .prefs-actions button {
    flex: 1 1 auto;
  }
  .prefs .consent-accept {
    border: var(--border) var(--terracotta);
  }
  .prefs .consent-accept:hover,
  .prefs .consent-accept:focus-visible {
    background-color: var(--brick);
    border-color: var(--brick);
    color: var(--cream);
  }
  .prefs-save {
    padding: 0.6em 1.4em;
    border: var(--border) var(--ink);
    border-radius: 0;
    background: none;
    color: var(--ink);
    font-weight: 800;
    font-size: 0.9375rem;
    cursor: pointer;
  }
  .prefs-save:hover,
  .prefs-save:focus-visible {
    background-color: var(--ink);
    color: var(--cream);
  }
  .prefs-foot {
    display: grid;
    gap: 0.35rem;
    font-size: var(--text-small);
  }
  .prefs-foot a {
    text-underline-offset: 0.2em;
  }
  .prefs-id {
    opacity: 0.75;
  }
  .prefs-id[hidden] {
    display: none;
  }
  .prefs-id code {
    font-size: 0.8125rem;
    word-break: break-all;
  }
  .prefs-close {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: var(--border) var(--ink);
    border-radius: 0;
    background-color: var(--cream);
    color: var(--ink);
    font-size: 1.5rem;
    line-height: 1;
  }
  .prefs-close:hover,
  .prefs-close:focus-visible {
    background-color: var(--ink);
    color: var(--cream);
  }
</style>
