---
/**
 * Tarjeta de panelista: bloque de color sólido con esquinas redondeadas,
 * como las tarjetas del manual (pág. 5). Foto en b/n con grano (pág. 6)
 * cuando exista; si `photo: null`, placeholder de marca con el símbolo. Al pie, iconos
 * con las redes y enlaces públicos del panelista (solo los verificados).
 */
import { Image } from 'astro:assets';
import { t } from '../ui';
import type { Speaker, SpeakerLinkKey } from '../data/speakers';
import LogoSymbol from '../assets/logo/logo-symbol.svg';

interface Props {
  speaker: Speaker;
  /** rota los bloques de color como en las piezas del manual */
  tone: 'olive' | 'sky' | 'brick';
}

const { speaker, tone } = Astro.props;

/* Orden fijo de los iconos; solo se pintan los enlaces presentes. */
const linkOrder: SpeakerLinkKey[] = ['x', 'instagram', 'linkedin', 'facebook', 'web', 'wikipedia'];
const links = linkOrder
  .filter((k) => speaker.links?.[k])
  .map((k) => ({ key: k, href: speaker.links![k]!, label: t(`links.${k}`) }));
---

<article class:list={['card', `card--${tone}`]}>
  <div class="card-media">
    {
      speaker.photo ? (
        <div class="grain card-photo">
          <Image
            src={speaker.photo}
            alt={speaker.name}
            widths={[320, 480, 640]}
            sizes="(max-width: 48rem) 78vw, 320px"
          />
        </div>
      ) : (
        <LogoSymbol class="card-symbol" aria-hidden="true" />
      )
    }
  </div>
  <h3 class="card-name">{speaker.name}</h3>
  <p class="card-credential">{speaker.credential}</p>
  <p class="card-bio">{speaker.bio}</p>
  {
    links.length > 0 && (
      <ul class="card-links" aria-label={`${t('speakers.links')} ${speaker.name}`}>
        {links.map(({ key, href, label }) => (
          <li>
            <a href={href} target="_blank" rel="noopener noreferrer" aria-label={`${speaker.name} en ${label}`} title={label}>
              {key === 'x' && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M17.7 3h3.1l-6.8 7.8L22 21h-6.3l-4.9-6.4L5.2 21H2.1l7.3-8.3L1.7 3h6.4l4.4 5.9L17.7 3Zm-1.1 16.2h1.7L7 4.7H5.2l11.4 14.5Z" />
                </svg>
              )}
              {key === 'instagram' && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2Zm0 1.8c-3.1 0-3.5 0-4.7.1-1.1.1-1.7.2-2.1.4-.5.2-.9.4-1.3.8-.4.4-.6.8-.8 1.3-.2.4-.3 1-.4 2.1C2.6 9.5 2.6 9.9 2.6 12s0 3.5.1 4.7c.1 1.1.2 1.7.4 2.1.2.5.4.9.8 1.3.4.4.8.6 1.3.8.4.2 1 .3 2.1.4 1.2.1 1.6.1 4.7.1s3.5 0 4.7-.1c1.1-.1 1.7-.2 2.1-.4.5-.2.9-.4 1.3-.8.4-.4.6-.8.8-1.3.2-.4.3-1 .4-2.1.1-1.2.1-1.6.1-4.7s0-3.5-.1-4.7c-.1-1.1-.2-1.7-.4-2.1-.2-.5-.4-.9-.8-1.3-.4-.4-.8-.6-1.3-.8-.4-.2-1-.3-2.1-.4C15.5 4 15.1 4 12 4Zm0 3a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 1.8a3.2 3.2 0 1 0 0 6.4 3.2 3.2 0 0 0 0-6.4Zm5.2-3.1a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4Z" />
                </svg>
              )}
              {key === 'linkedin' && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20.4 2H3.6C2.7 2 2 2.7 2 3.6v16.8c0 .9.7 1.6 1.6 1.6h16.8c.9 0 1.6-.7 1.6-1.6V3.6c0-.9-.7-1.6-1.6-1.6ZM8 19H5V9.5h3V19ZM6.5 8.2a1.7 1.7 0 1 1 0-3.5 1.7 1.7 0 0 1 0 3.5ZM19 19h-3v-4.6c0-1.1 0-2.5-1.5-2.5s-1.8 1.2-1.8 2.4V19h-3V9.5h2.9v1.3c.4-.8 1.4-1.5 2.8-1.5 3 0 3.6 2 3.6 4.6V19Z" />
                </svg>
              )}
              {key === 'facebook' && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.3v7A10 10 0 0 0 22 12Z" />
                </svg>
              )}
              {key === 'web' && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm7.9 9h-3.4a15.7 15.7 0 0 0-1.4-6.2A8 8 0 0 1 19.9 11ZM12 4c.9 1.2 2.1 3.6 2.4 7H9.6c.3-3.4 1.5-5.8 2.4-7ZM8.9 4.8A15.7 15.7 0 0 0 7.5 11H4.1a8 8 0 0 1 4.8-6.2ZM4.1 13h3.4c.1 2.4.6 4.5 1.4 6.2A8 8 0 0 1 4.1 13ZM12 20c-.9-1.2-2.1-3.6-2.4-7h4.8c-.3 3.4-1.5 5.8-2.4 7Zm3.1-.8c.8-1.7 1.3-3.8 1.4-6.2h3.4a8 8 0 0 1-4.8 6.2Z" />
                </svg>
              )}
              {key === 'wikipedia' && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M1 5h6.2v.9l-1.3.2c-.3 0-.4.2-.3.5l3.6 8.6 1.9-4.3-2-4.4c-.2-.3-.3-.4-.7-.4l-.9-.1V5h5.6v.9l-1 .2c-.4 0-.5.2-.3.6l1.4 3.2 1.2-2.9c.2-.5.1-.8-.4-.9l-.9-.1V5H23v.9l-1.2.2c-.5.1-.7.3-1 .9L16.4 19h-.9l-2.7-6-2.7 6h-.9L4.4 6.9c-.2-.6-.5-.7-1-.8L1 5.9V5Z" />
                </svg>
              )}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .card {
    scroll-snap-align: start;
    flex: 0 0 min(78vw, 20rem);
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    align-content: start;
    gap: 0.5rem;
    padding: var(--space-3);
    border-radius: var(--radius-card);
    color: var(--ink);
    min-height: 22rem;
    transition: transform 160ms var(--ease-out), box-shadow 160ms var(--ease-out);
  }
  .card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-1);
  }
  .card--olive {
    background-color: var(--olive);
    color: var(--cream);
  }
  .card--sky {
    background-color: var(--sky);
  }
  .card--brick {
    background-color: var(--brick);
    color: var(--cream);
  }

  .card-media {
    display: grid;
    place-items: start end;
    min-height: 8.5rem;
    margin-bottom: var(--space-1);
  }
  .card-photo {
    width: 100%;
    aspect-ratio: 4 / 3;
  }
  .card-photo img {
    object-position: center top;
    display: block;
  }
  .card-symbol {
    width: 4.5rem;
    height: auto;
    opacity: 0.9;
  }

  .card-name {
    font-size: var(--text-h3);
    font-weight: 800;
    line-height: 1.15;
  }
  .card-credential {
    font-size: var(--text-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.85;
  }
  .card-bio {
    font-size: var(--text-small);
    line-height: 1.5;
  }

  /* Iconos de redes: trazo sencillo, color heredado, al pie de la tarjeta */
  .card-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin-top: var(--space-1);
    padding: 0;
  }
  .card-links a {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: var(--border) currentColor;
    color: inherit;
    opacity: 0.85;
    transition: opacity 160ms var(--ease-out), background-color 160ms var(--ease-out);
  }
  .card-links a:hover,
  .card-links a:focus-visible {
    opacity: 1;
    background-color: rgba(255, 255, 255, 0.14);
  }
  .card-links svg {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
  }
</style>
