---
/**
 * Descripción corta + widget de compra (sección 2 del orden fijo, FR-004).
 * Continuación directa del hero: sin título grande propio. Es la primera
 * sección de <main>, o sea la "cortina" opaca que tapa el hero al subir.
 *
 * Pretix es el único dueño de precios/tipos de boleta (FR-008); esta
 * sección implementa el contrato pretix-embed.md al pie de la letra.
 */
import {
  PRETIX_EVENT_URL,
  pretixReady,
  WAITLIST_ENDPOINT,
  EVENTALIST_CAMPAIGN,
  waitlistReady,
} from '../config';
import { t } from '../ui';
import LogoSymbol from '../assets/logo/logo-symbol.svg';

/* `pretixReady` (config.ts) decide tienda o formulario. La hoja de estilos
   y el script del widget los pone EventLayout en la cabecera del documento. */
const live = pretixReady;

/* Base del despliegue: para enlazar la política de datos */
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---

<section id="boletas" class="tickets">
  <div class="container tickets-grid">
    <div class="tickets-intro">
      {/* Las comillas del logo, en crema y espejadas: "miran" hacia la tienda */}
      <LogoSymbol class="tickets-eyes" aria-hidden="true" />
      <p class="eyebrow">{t('tickets.heading')}</p>
      <h2 class="tickets-title">{t('tickets.title')}</h2>
      <p class="tickets-free">{t('tickets.freeNote')}</p>
    </div>
    <div class="tickets-widget">
      {
        live ? (
          <>
            <pretix-widget event={PRETIX_EVENT_URL}>
              {/* Fallback oficial: esto es lo que se ve sin JS o con el widget bloqueado (FR-011/018) */}
              <div class="pretix-widget-info-message">
                <p>{t('tickets.widgetFallback')}</p>
                <a href={PRETIX_EVENT_URL} target="_blank" rel="noopener">
                  {t('tickets.widgetLink')} →
                </a>
              </div>
            </pretix-widget>
          </>
        ) : (
          <>
            <p class="tickets-soon">{t('tickets.soon')}</p>
            {/* Lista de interesados (solo mientras no exista la tienda). El
                envío es JSON al endpoint de Eventalist, así que requiere JS:
                el botón nace deshabilitado y el script lo activa. */}
            <form
              class="waitlist"
              method="POST"
              data-waitlist
              data-endpoint={WAITLIST_ENDPOINT}
              data-campaign={EVENTALIST_CAMPAIGN}
              data-msg-sending={t('waitlist.sending')}
              data-msg-success={t('waitlist.success')}
              data-msg-error={t('waitlist.error')}
              data-msg-network={t('waitlist.errorNetwork')}
              data-msg-toomany={t('waitlist.errorTooMany')}
              data-msg-consent={t('waitlist.errorConsent')}
              data-label-email={t('waitlist.fieldEmail')}
              data-label-phone={t('waitlist.fieldPhone')}
              data-label-first_name={t('waitlist.fieldName')}
              data-label-consent_accepted={t('waitlist.fieldConsent')}
            >
              <label>
                <span>{t('waitlist.name')}</span>
                <input type="text" name="first_name" autocomplete="given-name" maxlength="100" />
              </label>
              <label>
                <span>{t('waitlist.phone')}</span>
                <input type="tel" name="phone" autocomplete="tel" inputmode="tel" />
              </label>
              <label>
                <span>{t('waitlist.email')}</span>
                <input type="email" name="email" required autocomplete="email" inputmode="email" />
              </label>
              {/* Honeypot antispam: fuera de pantalla (no display:none), vacío para humanos */}
              <div class="waitlist-hp" aria-hidden="true">
                <label>
                  Sitio web
                  <input type="text" name="website_url" tabindex="-1" autocomplete="off" />
                </label>
              </div>
              {/* Autorización previa, expresa e informada: casilla propia,
                  desmarcada por defecto (Ley 1581 de 2012, Ley 2300 de 2023) */}
              <label class="waitlist-consent">
                <input type="checkbox" name="consent_accepted" value="si" required />
                <span>
                  {t('waitlist.consent')}{' '}
                  <a href={`${base}tratamiento-de-datos/`} target="_blank" rel="noopener">{t('waitlist.consentLink')}</a>.
                </span>
              </label>
              <button type="submit" class="waitlist-submit" disabled>
                {t('waitlist.submit')}
              </button>
              <p class="waitlist-note" data-waitlist-note role="status" aria-live="polite">
                {t('waitlist.privacy')}
              </p>
              <noscript>
                <p class="waitlist-note">{t('waitlist.noscript')}</p>
              </noscript>
            </form>
          </>
        )
      }
    </div>
  </div>
</section>

<script>
  // Envío al endpoint de Eventalist (guía de integración): JSON, sin
  // autenticación, el navegador pone el Origin. Respuestas: 200 aceptado;
  // 400 errores por campo; 403 origen no registrado; 429 demasiados intentos.
  const form = document.querySelector<HTMLFormElement>('[data-waitlist]');
  const note = document.querySelector<HTMLElement>('[data-waitlist-note]');
  const submit = form?.querySelector<HTMLButtonElement>('button[type=submit]');
  if (form && note && submit && form.dataset.endpoint && form.dataset.campaign) {
    submit.disabled = false; // hay JS: el formulario puede enviarse
    const d = form.dataset;
    type State = 'idle' | 'sending' | 'success' | 'error';
    const say = (text: string, state: State = 'idle') => {
      note.textContent = text;
      note.dataset.state = state;
    };
    // data-label-email → dataset.labelEmail; data-label-first_name → labelFirst_name
    const labelFor = (field: string) => d[`label${field[0]!.toUpperCase()}${field.slice(1)}`] ?? '';
    const showErrors = (errors: Record<string, unknown>) => {
      const lines = Object.entries(errors).map(([field, msgs]) => {
        const text = ([] as unknown[]).concat(msgs).join(' ');
        const label = field === 'non_field_errors' ? '' : labelFor(field);
        return label ? `${label}: ${text}` : text;
      });
      say(lines.join(' ') || d.msgError!, 'error');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const consent = form.elements.namedItem('consent_accepted') as HTMLInputElement | null;
      if (!consent?.checked) {
        say(d.msgConsent!, 'error');
        return;
      }
      const payload = {
        campaign: d.campaign,
        first_name: String(data.get('first_name') ?? '').trim(),
        email: String(data.get('email') ?? '').trim(),
        phone: String(data.get('phone') ?? '').trim(),
        language: 'es',
        consent_accepted: consent.checked, // estado real de la casilla, nunca un true fijo
        website_url: String(data.get('website_url') ?? ''),
      };

      submit.disabled = true;
      say(d.msgSending!, 'sending');
      try {
        const res = await fetch(d.endpoint!, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const body: unknown = await res.json().catch(() => ({}));
        if (res.status === 200) {
          form.reset();
          say(d.msgSuccess!, 'success');
        } else if (res.status === 400 && body && typeof body === 'object') {
          showErrors(body as Record<string, unknown>);
        } else if (res.status === 429) {
          say(d.msgToomany!, 'error');
        } else {
          say(d.msgError!, 'error');
        }
      } catch {
        say(d.msgNetwork!, 'error');
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>

<style>
  /* Bloque terracota: el mensaje en tinta, la tienda en su tarjeta blanca
     y las comillas del logo en crema, mirando la tienda (manual pág. 6). */
  .tickets {
    position: relative;
    z-index: 1;
    background-color: var(--terracotta);
    color: var(--ink);
    padding-block: var(--space-6);
  }

  .tickets-grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--space-5);
    align-items: start;
  }

  /* La tienda es larga: la columna del texto se pega bajo el header con la
     altura de la pantalla y centra su contenido, así el mensaje viaja por
     la mitad del viewport mientras se recorre la lista, hasta que la
     propia celda de la cuadrícula lo frena al llegar al fondo. Si la
     tienda es más corta que la pantalla, la columna mide lo que ella. */
  .tickets-intro {
    display: grid;
    gap: var(--space-2);
    align-content: center;
    order: 2; /* en desktop: formulario a la izquierda, texto a la derecha */
    position: sticky;
    top: var(--header-h);
    align-self: stretch;
    max-height: calc(100vh - var(--header-h));
  }
  .tickets-widget {
    order: 1;
  }
  .tickets-eyes {
    width: clamp(7rem, 5rem + 6vw, 11rem);
    height: auto;
    color: var(--cream);
    transform: scaleX(-1); /* miran a la izquierda, donde está la tienda */
    margin-bottom: var(--space-2);
  }
  .tickets-intro .eyebrow {
    color: var(--ink);
  }
  .tickets-title {
    font-size: var(--text-h2);
    max-width: 16ch;
  }
  .tickets-free {
    font-size: var(--text-small);
    font-weight: 600;
    max-width: 40ch;
    padding-top: var(--space-2);
    border-top: var(--border) rgba(33, 8, 4, 0.35);
  }

  .tickets-widget {
    min-height: 12rem;
    border: var(--border) var(--ink);
    border-radius: var(--radius-card);
    padding: var(--space-4);
    background-color: #fff;
  }

  .tickets-soon {
    font-size: var(--text-h3);
    font-weight: 700;
    line-height: 1.4;
    color: var(--brick);
    text-wrap: balance;
  }

  /* --- Formulario de interesados --- */
  .waitlist {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: var(--border) var(--ink);
  }
  .waitlist label {
    display: grid;
    gap: 0.3rem;
    font-size: var(--text-small);
    font-weight: 700;
  }
  .waitlist input {
    font: inherit;
    padding: 0.6em 0.8em;
    border: var(--border) var(--ink);
    border-radius: 0;
    background-color: var(--cream);
    color: var(--ink);
  }
  .waitlist input:focus-visible {
    outline: 3px solid var(--terracotta);
    outline-offset: 0;
  }
  .waitlist-hp {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  /* Casilla legal: discreta (texto pequeño, sin negrita), pero legible */
  .waitlist label.waitlist-consent {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem;
    align-items: start;
    font-size: var(--text-label);
    font-weight: 400;
    line-height: 1.5;
    opacity: 0.85;
  }
  .waitlist-consent input {
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.1rem;
    accent-color: var(--terracotta);
  }
  .waitlist-consent a {
    font-weight: 400;
    text-underline-offset: 0.2em;
  }
  .waitlist-submit {
    justify-self: start;
    padding: 0.75em 1.5em;
    font-weight: 800;
    background-color: var(--ink);
    color: var(--cream);
    border: var(--border) var(--ink);
    border-radius: 0;
    transition: background-color 160ms var(--ease-out);
  }
  .waitlist-submit:hover:not(:disabled) {
    background-color: var(--brick);
    border-color: var(--brick);
  }
  .waitlist-submit:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  /* Mensaje de estado: en reposo, nota discreta; al enviar, bloque sólido
     de color (oliva = listo, ladrillo = error) con texto en crema. */
  .waitlist-note {
    font-size: var(--text-small);
    opacity: 0.75;
    margin: 0;
  }
  .waitlist-note[data-state='sending'] {
    opacity: 1;
    font-weight: 700;
  }
  .waitlist-note[data-state='success'],
  .waitlist-note[data-state='error'] {
    opacity: 1;
    font-weight: 700;
    padding: 0.85em 1.1em;
    color: var(--cream);
  }
  .waitlist-note[data-state='success'] {
    background-color: var(--olive);
  }
  .waitlist-note[data-state='error'] {
    background-color: var(--brick);
  }

  .pretix-widget-info-message {
    display: grid;
    gap: var(--space-2);
  }
  .pretix-widget-info-message a {
    font-weight: 800;
    color: var(--brick);
  }

  @media (max-width: 63.9rem) {
    .tickets-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    /* apilado: primero el contexto, luego el formulario; sin pegado */
    .tickets-intro {
      order: 1;
      position: static;
      align-self: auto;
      align-content: start;
      max-height: none;
    }
    .tickets-widget {
      order: 2;
    }
  }
</style>

<style is:global>
  /* --- Widget de Pretix (v2) ----------------------------------------
     Pretix pinta la lista de productos en el DOM de la página (sin shadow
     DOM) con clases `pretix-widget-*`, y su guía autoriza sobrescribirlas.
     Este bloque es global porque Astro no puede scopear lo que inyecta
     el widget. Solo alcanza la lista; el checkout va en un iframe de
     Pretix y se ajusta desde su panel. Todo bajo `.tickets-widget` para
     no tocar nada más. Estructura verificada con la tienda real el 2026-09-08. */

  .tickets-widget {
    /* Colores de marca que el widget lee de sus propias variables */
    --pretix-brand-primary: var(--brick);
    --pretix-brand-primary-darken-5: var(--ink);
    --pretix-brand-danger: var(--brick);
    --pretix-brand-success: var(--olive);
  }

  /* El widget trae su propio marco gris; la tarjeta blanca ya es el marco */
  .tickets-widget .pretix-widget {
    margin: 0;
    padding: 0;
    border: 0;
    min-height: 0;
    font-family: inherit;
    font-size: var(--text-body);
    line-height: 1.5;
    color: var(--ink);
  }

  /* Categoría como etiqueta (eyebrow), no como título que compite */
  .tickets-widget .pretix-widget-category {
    margin: 0;
  }
  .tickets-widget .pretix-widget-category + .pretix-widget-category {
    margin-top: var(--space-4);
  }
  .tickets-widget .pretix-widget-category-name {
    margin: 0 0 var(--space-1);
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brick);
  }
  .tickets-widget .pretix-widget-category-description {
    margin: 0 0 var(--space-2);
    font-size: var(--text-small);
  }

  /* Cada producto es un bloque: filete de tinta arriba, aire adentro.
     El primero cierra contra la etiqueta y el último contra el botón. */
  .tickets-widget .pretix-widget-item {
    border-top: var(--border) var(--ink);
  }
  .tickets-widget .pretix-widget-category-items > .pretix-widget-item:last-child {
    border-bottom: var(--border) var(--ink);
  }
  .tickets-widget .pretix-widget-item-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    row-gap: var(--space-1);
    column-gap: var(--space-2);
    padding: var(--space-2) 0;
  }
  /* Selectores con `>`: pesan más que las reglas de modo móvil del widget
     (`.pretix-widget.pretix-widget-mobile .pretix-widget-item-price-col`),
     que si no ganan y parten precio y contador en dos filas. */
  .tickets-widget .pretix-widget-item-row > .pretix-widget-item-info-col,
  .tickets-widget .pretix-widget-item-row > .pretix-widget-item-price-col,
  .tickets-widget .pretix-widget-item-row > .pretix-widget-item-availability-col {
    float: none;
    width: auto;
    min-width: 0;
    padding: 0;
    margin: 0;
  }
  .tickets-widget .pretix-widget-item-row > .pretix-widget-item-info-col {
    flex: 1 1 100%;
  }
  .tickets-widget .pretix-widget-item-title {
    display: block;
    font-weight: 800;
    font-size: var(--text-h3);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .tickets-widget .pretix-widget-item-description {
    margin-top: 0.35em;
    font-size: var(--text-small);
    line-height: 1.45;
    opacity: 0.85;
  }
  .tickets-widget .pretix-widget-item-description p {
    margin: 0;
  }

  /* Precio a la izquierda, en negrita; el tachado pequeño y apagado */
  .tickets-widget .pretix-widget-item-row > .pretix-widget-item-price-col {
    flex: 1 1 auto;
    text-align: left;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .tickets-widget .pretix-widget-pricebox-original-price {
    display: block;
    font-size: var(--text-small);
    font-weight: 600;
    opacity: 0.6;
  }
  .tickets-widget .pretix-widget-pricebox-new-price {
    text-decoration: none;
    color: var(--brick);
  }
  .tickets-widget .pretix-widget-pricebox-tax {
    font-size: var(--text-small);
    font-weight: 400;
    opacity: 0.75;
  }

  /* Contador y estados a la derecha */
  .tickets-widget .pretix-widget-item-row > .pretix-widget-item-availability-col {
    flex: 0 0 auto;
    margin-left: auto;
    text-align: right;
  }
  .tickets-widget .pretix-widget-availability-unavailable,
  .tickets-widget .pretix-widget-availability-gone {
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brick);
  }
  .tickets-widget .pretix-widget-item-count-group {
    display: inline-flex;
  }
  .tickets-widget .pretix-widget-item-count-group button.pretix-widget-btn-default {
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: var(--border) var(--ink);
    border-radius: 0;
    /* Terracota velada sobre blanco: señala que aquí se suman boletas sin
       competir con el botón de compra; al pasar el mouse se llena. */
    background-color: rgba(212, 91, 48, 0.28);
    color: var(--ink);
    font-weight: 800;
    font-size: 1.125rem;
    line-height: 1;
    cursor: pointer;
    transition: background-color 160ms var(--ease-out);
  }
  .tickets-widget .pretix-widget-item-count-group button.pretix-widget-btn-default:hover,
  .tickets-widget .pretix-widget-item-count-group button.pretix-widget-btn-default:focus-visible {
    background-color: var(--terracotta);
    color: var(--ink);
  }
  .tickets-widget .pretix-widget-item-count-group input.pretix-widget-item-count-multiple {
    width: 3.25rem;
    height: 2.75rem;
    padding: 0;
    border: var(--border) var(--ink);
    border-left: 0;
    border-right: 0;
    border-radius: 0;
    background-color: #fff;
    color: var(--ink);
    font-family: inherit;
    font-weight: 700;
    font-size: 1rem;
    text-align: center;
    box-shadow: none;
  }
  .tickets-widget .pretix-widget-item-count-group input.pretix-widget-item-count-multiple:focus {
    outline: 2px solid var(--terracotta);
    outline-offset: -2px;
  }
  .tickets-widget .pretix-widget-item-count-single-label {
    text-align: right;
  }

  /* Botón de compra: el mismo CTA del sitio, a todo el ancho */
  .tickets-widget .pretix-widget form > .pretix-widget-action {
    width: 100%;
    margin: var(--space-3) 0 0;
    padding: 0;
  }
  .tickets-widget .pretix-widget-action button {
    width: 100%;
    padding: 0.95em 1.7em;
    background-color: var(--terracotta);
    color: var(--ink);
    font-family: inherit;
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 0.01em;
    border: var(--border) var(--terracotta);
    border-radius: 0;
    cursor: pointer;
    transition: transform 160ms var(--ease-out), background-color 160ms var(--ease-out),
      box-shadow 160ms var(--ease-out);
  }
  .tickets-widget .pretix-widget-action button:hover,
  .tickets-widget .pretix-widget-action button:focus-visible {
    background-color: var(--brick);
    border-color: var(--brick);
    color: var(--cream);
    transform: translateY(-2px);
    box-shadow: var(--shadow-1);
  }
  .tickets-widget .pretix-widget-action button:active {
    transform: none;
  }

  .tickets-widget .pretix-widget-attribution {
    padding: var(--space-2) 0 0;
    font-size: 0.75rem;
    opacity: 0.6;
  }
  .tickets-widget .pretix-widget-attribution a {
    color: inherit;
  }

  @media (prefers-reduced-motion: reduce) {
    .tickets-widget .pretix-widget-action button,
    .tickets-widget .pretix-widget-item-count-group button.pretix-widget-btn-default {
      transition: none;
      transform: none;
    }
  }
</style>
