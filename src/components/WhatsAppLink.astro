---
/**
 * Enlace a WhatsApp de Eventalist para dudas de compra (2026-10-08). El logo
 * de WhatsApp va en tinta dentro de un bloque de color de esquinas rectas,
 * como el resto de la marca: crema sobre el terracota de la sección de
 * boletas, terracota sobre la tinta del pie (`tone="dark"`). Sin el verde
 * de WhatsApp y sin botones flotantes.
 * Cada clic se mide en GA4 como `contact` (src/measurement/tags.ts), con el
 * lugar en `data-contact`.
 */
import { WHATSAPP_URL } from '../config';

interface Props {
  label: string;
  where: string;
  tone?: 'light' | 'dark';
}
const { label, where, tone = 'light' } = Astro.props;
---

<a class:list={['wa-link', `wa-link--${tone}`]} href={WHATSAPP_URL} target="_blank" rel="noopener" data-contact={where}>
  <span class="wa-mark" aria-hidden="true">
    <svg viewBox="0 0 24 24" focusable="false">
      <path
        fill="currentColor"
        d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.87 9.87 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91A9.84 9.84 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.23 8.23 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24a8.2 8.2 0 0 1 5.83 2.42 8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.16.25-.64.81-.78.97-.15.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.43-.06-.13-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.22-.16-.47-.28Z"
      ></path>
    </svg>
  </span>
  <span class="wa-label">{label}</span>
</a>

<style>
  .wa-link {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    font-weight: 800;
    text-decoration: none;
  }
  .wa-link--light {
    color: var(--ink);
  }
  .wa-link--dark {
    color: var(--cream);
  }
  .wa-mark {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.25em;
    height: 2.25em;
    background-color: var(--cream);
    color: var(--ink);
    transition: background-color 160ms var(--ease-out), color 160ms var(--ease-out);
  }
  .wa-link--dark .wa-mark {
    background-color: var(--terracotta);
  }
  .wa-mark svg {
    width: 1.3em;
    height: 1.3em;
  }
  .wa-label {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }
  .wa-link:hover .wa-mark,
  .wa-link:focus-visible .wa-mark {
    background-color: var(--ink);
    color: var(--cream);
  }
  .wa-link--dark:hover .wa-mark,
  .wa-link--dark:focus-visible .wa-mark {
    background-color: var(--cream);
    color: var(--ink);
  }
</style>
