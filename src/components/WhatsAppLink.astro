---
/**
 * Enlace a WhatsApp de Eventalist para dudas de compra (2026-10-08). El logo
 * de WhatsApp va en tinta dentro de un bloque de color de esquinas rectas,
 * como el resto de la marca: crema sobre el terracota de la sección de
 * boletas, terracota sobre la tinta del pie (`tone="dark"`). Sin el verde
 * de WhatsApp y sin botones flotantes. `variant="button"`: botón con marco
 * en tinta y fondo crema, para el bloque de dudas bajo la tienda.
 * Cada clic se mide en GA4 como `contact` (src/measurement/tags.ts), con el
 * lugar en `data-contact`.
 */
import { WHATSAPP_URL } from '../config';
import { WHATSAPP_ICON_PATH } from '../data/whatsapp-icon';

interface Props {
  label: string;
  where: string;
  tone?: 'light' | 'dark';
  variant?: 'inline' | 'button';
}
const { label, where, tone = 'light', variant = 'inline' } = Astro.props;
---

<a class:list={['wa-link', `wa-link--${tone}`, variant === 'button' && 'wa-link--button']} href={WHATSAPP_URL} target="_blank" rel="noopener" data-contact={where}>
  <span class="wa-mark" aria-hidden="true">
    <svg viewBox="0 0 24 24" focusable="false">
      <path
        fill="currentColor"
        d={WHATSAPP_ICON_PATH}
      ></path>
    </svg>
  </span>
  <span class="wa-label">{label}</span>
</a>

<style>
  .wa-link {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    font-weight: 800;
    text-decoration: none;
  }
  .wa-link--light {
    color: var(--ink);
  }
  .wa-link--dark {
    color: var(--cream);
  }
  .wa-mark {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.25em;
    height: 2.25em;
    background-color: var(--cream);
    color: var(--ink);
    transition: background-color 160ms var(--ease-out), color 160ms var(--ease-out);
  }
  .wa-link--dark .wa-mark {
    background-color: var(--terracotta);
  }
  .wa-mark svg {
    width: 1.3em;
    height: 1.3em;
  }
  .wa-label {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }
  .wa-link:hover .wa-mark,
  .wa-link:focus-visible .wa-mark {
    background-color: var(--ink);
    color: var(--cream);
  }
  /* Botón: marco en tinta y fondo crema; el logo va suelto, sin cuadrito */
  .wa-link--button {
    padding: 0.5em 0.85em;
    gap: 0.5em;
    border: var(--border) var(--ink);
    background-color: var(--cream);
    color: var(--ink);
    white-space: nowrap;
    transition: background-color 160ms var(--ease-out), color 160ms var(--ease-out);
  }
  .wa-link--button .wa-mark {
    width: auto;
    height: auto;
    background: none;
    color: inherit;
  }
  .wa-link--button .wa-label {
    text-decoration: none;
  }
  .wa-link--button:hover,
  .wa-link--button:focus-visible {
    background-color: var(--ink);
    color: var(--cream);
  }
  .wa-link--button:hover .wa-mark,
  .wa-link--button:focus-visible .wa-mark {
    background: none;
    color: inherit;
  }
  .wa-link--dark:hover .wa-mark,
  .wa-link--dark:focus-visible .wa-mark {
    background-color: var(--cream);
    color: var(--ink);
  }
</style>
