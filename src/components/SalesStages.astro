---
/**
 * Calendario de venta junto a la tienda: tres planos que se tocan (fórmula
 * visual §1 y §6). El de la etapa vigente va en cielo, un poco más alto que
 * los otros, con la cifra del día en serif; los demás, en crema, y el que ya
 * cerró, más velado. Las fechas salen de event.ts; la etapa vigente y los
 * días que quedan de la 2 se calculan en el build y el script los recalcula
 * en el navegador.
 */
import { salesStages } from '../data/event';
import { tFor, type UiKey } from '../ui';
import { langOf, localeOf } from '../i18n';

const t = tFor(Astro.url.pathname);

const DAY = 86_400_000;
/* Cada cambio de etapa, a las 0:00 de Bogotá del primer día de la siguiente */
const at = (iso: string) => Date.parse(`${iso}T00:00:00-05:00`);
const switches = [at(salesStages.stage2Start), at(salesStages.stage3Start)];
const currentAt = (now: number) => 1 + switches.filter((s) => now >= s).length;
const current = currentAt(Date.now());
/* La cuenta es la del precio de la etapa 2 */
const daysLeft = Math.ceil((switches[1]! - Date.now()) / DAY);

const fmt = new Intl.DateTimeFormat(localeOf(langOf(Astro.url.pathname)), { timeZone: 'America/Bogota', day: 'numeric', month: 'long' });
const parts = (iso: string) => {
  const p = fmt.formatToParts(new Date(`${iso}T12:00:00-05:00`));
  return {
    day: p.find((x) => x.type === 'day')?.value ?? '',
    month: p.find((x) => x.type === 'month')?.value ?? '',
  };
};

const stages: { n: number; label: UiKey; prefix: UiKey; date: { day: string; month: string }; product: UiKey; note: UiKey }[] = [
  { n: 1, label: 'stages.stage1', prefix: 'stages.until', date: parts(salesStages.stage1End), product: 'stages.stage1Product', note: 'stages.stage1Note' },
  { n: 2, label: 'stages.stage2', prefix: 'stages.until', date: parts(salesStages.stage2End), product: 'stages.stage2Product', note: 'stages.stage2Note' },
  { n: 3, label: 'stages.stage3', prefix: 'stages.from', date: parts(salesStages.stage3Start), product: 'stages.stage3Product', note: 'stages.stage3Note' },
];
const status = (n: number) => (n === current ? t('stages.now') : n < current ? t('stages.closed') : '');

/* Con un día se dice "último día"; de dos en adelante, la cuenta */
const countdown = (n: number) => (n === 1 ? t('stages.lastDay') : t('stages.daysLeft').replace('{n}', String(n)));
---

<div
  class="stages"
  data-stages
  data-switches={switches.join(',')}
  data-days-left={t('stages.daysLeft')}
  data-last-day={t('stages.lastDay')}
  data-now={t('stages.now')}
  data-closed={t('stages.closed')}
>
  <p class="eyebrow stages-heading">{t('stages.heading')}</p>
  <ol class="stages-list" role="list">
    {
      stages.map((s) => (
        <li class="stage" data-stage={s.n} data-current={s.n === current || undefined} data-past={s.n < current || undefined}>
          <p class="stage-label">
            <span>{t(s.label)}</span>
            <span class="stage-now" data-stage-now>{status(s.n)}</span>
          </p>
          <p class="stage-date">
            <span class="stage-prefix">{t(s.prefix)}</span>
            <span class="stage-day">{s.date.day}</span>
            <span class="stage-month">{s.date.month}</span>
          </p>
          <p class="stage-product">{t(s.product)}</p>
          <p class="stage-note">{t(s.note)}</p>
          {s.n === 2 && (
            <p class="stage-count" data-stage-count hidden={current !== 2}>
              {current === 2 ? countdown(daysLeft) : ''}
            </p>
          )}
        </li>
      ))
    }
  </ol>
</div>

<script>
  // El HTML trae el estado del build; aquí se pone al día con la hora real
  // del visitante (la página se publica una vez y vive semanas).
  const root = document.querySelector<HTMLElement>('[data-stages]');
  if (root) {
    const DAY = 86_400_000;
    const now = Date.now();
    const switches = (root.dataset.switches ?? '').split(',').map(Number);
    const live = 1 + switches.filter((s) => now >= s).length;
    root.querySelectorAll<HTMLElement>('.stage').forEach((el) => {
      const n = Number(el.dataset.stage);
      el.toggleAttribute('data-current', n === live);
      el.toggleAttribute('data-past', n < live);
      const label = el.querySelector<HTMLElement>('[data-stage-now]');
      if (label) label.textContent = n === live ? (root.dataset.now ?? '') : n < live ? (root.dataset.closed ?? '') : '';
    });
    const count = root.querySelector<HTMLElement>('[data-stage-count]');
    if (count) {
      const daysLeft = Math.ceil(((switches[1] ?? 0) - now) / DAY);
      count.hidden = live !== 2;
      if (daysLeft === 1) count.textContent = root.dataset.lastDay ?? '';
      else if (daysLeft > 1) count.textContent = (root.dataset.daysLeft ?? '').replace('{n}', String(daysLeft));
    }
  }
</script>

<style>
  .stages {
    display: grid;
    gap: var(--space-2);
    max-width: 60ch;
  }
  .stages-heading {
    color: var(--ink);
  }
  /* Tres planos que comparten arista, sin aire entre ellos */
  .stages-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: end;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stage {
    display: grid;
    gap: 0.35em;
    padding: var(--space-2);
    background-color: var(--cream);
    color: var(--ink);
    /* El que viene, un poco velado; nunca gris */
    --stage-fade: 0.75;
  }
  /* El que ya cerró, más velado todavía */
  .stage[data-past] {
    --stage-fade: 0.55;
  }
  /* El vigente: cielo y unos milímetros más alto que el vecino (§1) */
  .stage[data-current] {
    background-color: var(--sky);
    padding-top: calc(var(--space-2) + var(--space-1));
    --stage-fade: 1;
  }
  .stage-label {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5em;
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: var(--stage-fade);
  }
  .stage-now {
    color: var(--ink);
  }
  .stage-now:empty {
    display: none;
  }
  /* Cifra y mes con la misma anatomía que la fecha del hero ("5–8" +
     "noviembre 2026"): grotesca negra en línea de base con la etiqueta */
  .stage-date {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.5em;
    opacity: var(--stage-fade);
  }
  .stage-prefix {
    flex-basis: 100%;
    font-size: var(--text-small);
    font-weight: 600;
  }
  .stage-day {
    flex-shrink: 0;
    white-space: nowrap;
    font-weight: 800;
    font-size: clamp(1.8rem, 1.2rem + 1.6vw, 2.6rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .stage-month {
    font-size: var(--text-label);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .stage-product {
    margin-top: 0.4em;
    font-size: var(--text-body);
    font-weight: 800;
    line-height: 1.2;
    opacity: var(--stage-fade);
  }
  .stage-note,
  .stage-count {
    font-size: var(--text-small);
    line-height: 1.4;
    opacity: var(--stage-fade);
  }
  /* Los días que quedan: plano claro con tinta encima, como el sello
     "Aún no disponible" de la tienda. Nada de ladrillo sobre cielo. */
  .stage-count {
    justify-self: start;
    margin-top: 0.35em;
    padding: 0.5em 0.75em;
    background-color: var(--cream);
    color: var(--ink);
    font-weight: 700;
  }
  .stage-count:empty,
  .stage-count[hidden] {
    display: none;
  }

  @media (max-width: 30rem) {
    .stages-list {
      grid-template-columns: 1fr;
    }
    .stage[data-current] {
      padding-top: var(--space-2);
    }
  }
</style>
