---
/**
 * Carrusel de panelistas (patrón 8.5): scroll-snap nativo + flechas con
 * scrollBy(). Sin librerías. Cierra con CTA (estrategia de CTA del spec).
 *
 * Tarjetas compactas por defecto; "Leer más" en cualquiera expande todas
 * (una sola altura de fila) y vuelven a encogerse cuando la sección sale
 * de la pantalla. Transición corta y lineal, sin rebotes.
 */
import { t } from '../ui';
import { speakers } from '../data/speakers';
import CtaButton from './CtaButton.astro';
import SpeakerCard from './SpeakerCard.astro';

const tones = ['olive', 'sky', 'brick'] as const;

/* Subtítulo del banco aprobado (spec §2) */
const subtitle = 'Escuchar a quienes estuvieron allí también es hacer memoria.';
---

<section id="speakers" class="speakers" data-reveal>
  <div class="container">
    <div class="speakers-head">
      <p class="eyebrow">{t('nav.speakers')}</p>
      <h2>{subtitle}</h2>
      <div class="speakers-arrows">
        <button type="button" data-carousel-prev aria-label={t('speakers.prev')}>←</button>
        <button type="button" data-carousel-next aria-label={t('speakers.next')}>→</button>
      </div>
    </div>
  </div>
  <div class="speakers-track-wrap">
    <ul class="speakers-track container" role="list" data-carousel>
      {
        speakers.map((speaker, i) => (
          <li>
            <SpeakerCard speaker={speaker} tone={tones[i % tones.length]!} />
          </li>
        ))
      }
    </ul>
  </div>
  <div class="container speakers-cta">
    <CtaButton />
  </div>
</section>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Flechas del carrusel: scrollBy nativo; smooth solo si el usuario lo permite.
  const track = document.querySelector<HTMLElement>('[data-carousel]');
  if (track) {
    const step = () => {
      const card = track.querySelector('li');
      return (card?.getBoundingClientRect().width ?? 320) + 20;
    };
    const scroll = (dir: 1 | -1) =>
      track.scrollBy({ left: dir * step(), behavior: reduced ? 'auto' : 'smooth' });
    document.querySelector('[data-carousel-prev]')?.addEventListener('click', () => scroll(-1));
    document.querySelector('[data-carousel-next]')?.addEventListener('click', () => scroll(1));
  }

  // Tarjetas compactas / expandidas (todas a la vez).
  const section = document.querySelector<HTMLElement>('#speakers');
  if (section) {
    section.dataset.collapsible = '';
    const bios = Array.from(section.querySelectorAll<HTMLElement>('[data-bio]'));
    const toggles = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-card-toggle]'));
    let expanded = false;

    const setExpanded = (open: boolean) => {
      if (open === expanded) return;
      expanded = open;
      section.toggleAttribute('data-expanded', open);
      for (const bio of bios) {
        if (open) {
          bio.classList.add('is-open');
          bio.style.maxHeight = '4.5em';
          // dos frames: que el navegador registre el punto de partida antes de animar
          requestAnimationFrame(() =>
            requestAnimationFrame(() => {
              bio.style.maxHeight = `${bio.scrollHeight}px`;
            }),
          );
        } else {
          bio.style.maxHeight = `${bio.scrollHeight}px`;
          requestAnimationFrame(() =>
            requestAnimationFrame(() => {
              bio.style.maxHeight = '4.5em';
            }),
          );
        }
      }
      for (const btn of toggles) {
        btn.setAttribute('aria-expanded', String(open));
        btn.textContent = open ? btn.dataset.less! : btn.dataset.more!;
      }
    };

    // Al cerrar la transición: soltar la altura fija (abierto) o restaurar
    // el recorte de tres líneas con puntos suspensivos (cerrado).
    for (const bio of bios) {
      bio.addEventListener('transitionend', () => {
        if (expanded) {
          bio.style.maxHeight = '';
        } else {
          bio.classList.remove('is-open');
          bio.style.maxHeight = '';
        }
      });
    }
    if (reduced) {
      // Sin transición: el transitionend no llega, así que se resuelve de inmediato.
      for (const bio of bios) {
        new MutationObserver(() => {
          if (!expanded) bio.classList.remove('is-open');
          bio.style.maxHeight = '';
        }).observe(bio, { attributes: true, attributeFilter: ['style'] });
      }
    }

    for (const btn of toggles) btn.addEventListener('click', () => setExpanded(!expanded));

    // Se encogen solas cuando la sección sale de la pantalla.
    new IntersectionObserver(
      (entries) => {
        for (const e of entries) if (!e.isIntersecting && expanded) setExpanded(false);
      },
      { threshold: 0 },
    ).observe(section);
  }
</script>

<style>
  .speakers {
    position: relative;
    z-index: 1;
    background-color: var(--cream);
    padding-block: var(--space-6);
  }

  .speakers-head {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .speakers-head .eyebrow {
    grid-column: 1 / -1;
    color: var(--brick);
  }
  h2 {
    font-size: var(--text-h2);
    max-width: 24ch;
  }

  .speakers-arrows {
    display: flex;
    gap: var(--space-1);
  }
  .speakers-arrows button {
    width: 2.75rem;
    height: 2.75rem;
    border: var(--border) var(--ink);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    font-size: 1.1rem;
    transition: background-color 160ms var(--ease-out), color 160ms var(--ease-out);
  }
  .speakers-arrows button:hover {
    background-color: var(--ink);
    color: var(--cream);
  }
  /* Sin JS las flechas no operan: se ocultan y el track sigue siendo scrolleable */
  html:not(.js-reveal) .speakers-arrows {
    display: none;
  }

  .speakers-track {
    display: flex;
    gap: 20px;
    list-style: none;
    padding-block: 4px;
    overflow-x: auto;
    overflow-y: hidden; /* sin scroll-container vertical: la rueda sigue moviendo la página */
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: var(--terracotta) transparent;
  }
  .speakers-track li {
    display: contents;
  }

  .speakers-cta {
    margin-top: var(--space-4);
  }

  @media (max-width: 47.9rem) {
    .speakers-head {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
