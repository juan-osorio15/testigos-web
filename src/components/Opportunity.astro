---
/**
 * "Qué es" (antes "La Oportunidad", FR-004): el argumento largo, ya abajo
 * de quién, cuándo, dónde y precio (decisión del 2026-09-18: primero lo
 * urgente, el que quiera profundizar llega aquí). Primera edición: sin
 * testimonios ni ediciones anteriores. Título, párrafo, los cuatro puntos
 * a la vista (quien llegó hasta aquí quiere leer; decisión del
 * 2026-09-18) y el remate. Se conserva el id #oportunidad para los
 * enlaces del header y de fuera.
 */
import { tFor } from '../ui';

const t = tFor(Astro.url.pathname);
/* Textos en ui.ts (opp.*); la pregunta es del banco aprobado (spec §2) */
const copy = {
  eyebrow: t('opp.eyebrow'),
  heading: t('opp.heading'),
  lead: t('opp.lead'),
  points: [t('opp.point1'), t('opp.point2'), t('opp.point3'), t('opp.point4')],
  closing: t('opp.closing'),
};
---

<section id="oportunidad" class="opp" data-reveal>
  <div class="container opp-inner">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2>{copy.heading}</h2>
    <p class="opp-lead">{copy.lead}</p>
    <ul class="opp-points" role="list">
      {copy.points.map((point) => <li>{point}</li>)}
    </ul>
    <p class="opp-closing">{copy.closing}</p>
  </div>
</section>

<style>
  .opp {
    position: relative;
    z-index: 1;
    background-color: var(--cream);
    color: var(--ink);
    padding-block: var(--space-6);
  }
  .opp-inner {
    display: grid;
    gap: var(--space-3);
  }
  .opp-inner > * {
    max-width: 54rem;
  }
  .opp .eyebrow {
    color: var(--brick);
  }
  h2 {
    font-size: var(--text-h2);
  }
  .opp-lead {
    font-size: var(--text-lead);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .opp-points {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
    font-size: var(--text-body);
    line-height: 1.55;
  }
  .opp-points li {
    padding-left: 1.4rem;
    position: relative;
  }
  /* Marcador: bloque sólido de marca, no bullet genérico */
  .opp-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.65rem;
    height: 0.65rem;
    background-color: var(--terracotta);
  }
  .opp-points li:nth-child(2)::before {
    background-color: var(--sky);
  }
  .opp-points li:nth-child(3)::before {
    background-color: var(--olive);
  }
  .opp-points li:nth-child(4)::before {
    background-color: var(--brick);
  }
  .opp-closing {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-h3);
    color: var(--brick);
    margin-top: var(--space-2);
  }
</style>
