---
/**
 * "Qué es" (antes "La Oportunidad", FR-004): el argumento largo, ya abajo
 * de quién, cuándo, dónde y precio (decisión del 2026-09-18: primero lo
 * urgente, el que quiera profundizar llega aquí). Primera edición: sin
 * testimonios ni ediciones anteriores. Título, párrafo, los cuatro puntos
 * a la vista (quien llegó hasta aquí quiere leer; decisión del
 * 2026-09-18) y el remate. Se conserva el id #oportunidad para los
 * enlaces del header y de fuera.
 */
const copy = {
  eyebrow: 'Primera edición',
  /* Pregunta del banco aprobado (spec §2) */
  heading: 'Una oportunidad de escuchar de primera mano a quienes estuvieron allí cuando la historia estaba ocurriendo.',
  lead: 'Los hechos que marcaron al país tienen testigos de primera fila: los reporteros que los cubrieron. Durante cuatro días, algunos de los grandes nombres del periodismo colombiano se sientan a contar lo que vieron, cómo lo contaron y qué nos enseña ese pasado para lo que viene.',
  points: [
    'Lo que estaba detrás de las noticias, lo que no salió en televisión, las decisiones que tuvieron que tomar y las historias que quedaron fuera.',
    'Conversatorios cercanos, sin tarima lejana: preguntas y desacuerdos incluidos.',
    'Historia y oficio de primera mano, con nombres, fechas y medios sobre la mesa.',
    'Villa de Leyva: un pueblo que invita a quedarse conversando después de cada sesión.',
  ],
  closing: 'Es la primera edición. Nadie te lo va a contar: ¡hay que estar!',
};
---

<section id="oportunidad" class="opp" data-reveal>
  <div class="container opp-inner">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2>{copy.heading}</h2>
    <p class="opp-lead">{copy.lead}</p>
    <ul class="opp-points" role="list">
      {copy.points.map((point) => <li>{point}</li>)}
    </ul>
    <p class="opp-closing">{copy.closing}</p>
  </div>
</section>

<style>
  .opp {
    position: relative;
    z-index: 1;
    background-color: var(--cream);
    color: var(--ink);
    padding-block: var(--space-6);
  }
  .opp-inner {
    display: grid;
    gap: var(--space-3);
  }
  .opp-inner > * {
    max-width: 54rem;
  }
  .opp .eyebrow {
    color: var(--brick);
  }
  h2 {
    font-size: var(--text-h2);
  }
  .opp-lead {
    font-size: var(--text-lead);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .opp-points {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
    font-size: var(--text-body);
    line-height: 1.55;
  }
  .opp-points li {
    padding-left: 1.4rem;
    position: relative;
  }
  /* Marcador: bloque sólido de marca, no bullet genérico */
  .opp-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.65rem;
    height: 0.65rem;
    background-color: var(--terracotta);
  }
  .opp-points li:nth-child(2)::before {
    background-color: var(--sky);
  }
  .opp-points li:nth-child(3)::before {
    background-color: var(--olive);
  }
  .opp-points li:nth-child(4)::before {
    background-color: var(--brick);
  }
  .opp-closing {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-h3);
    color: var(--brick);
    margin-top: var(--space-2);
  }
</style>
