---
/**
 * Venue (sección 6): dirección SIEMPRE en texto plano + mapa real de
 * Google embebido con loading="lazy" (opción válida del brief §6; el
 * embed básico por iframe es gratuito y no requiere API key) + botón
 * "Cómo llegar" con deep link por sede (FR-006).
 */
import { t } from '../ui';
import { venues } from '../data/event';

const heading = 'Dos sedes, a pocas cuadras';

/* Centrado en la sede principal (conversatorios); Casa Museo queda a
   pocas cuadras y tiene su propio deep link en la tarjeta. */
const mapSrc =
  'https://www.google.com/maps?q=' +
  encodeURIComponent('Hospedería Duruelo, Villa de Leyva, Boyacá') +
  '&hl=es&z=16&output=embed';
---

<section id="lugar" class="venue" data-reveal>
  <div class="container">
    <p class="eyebrow">{t('nav.venue')}</p>
    <h2>{heading}</h2>
    <div class="venue-grid">
      <div class="venue-map">
        <iframe
          src={mapSrc}
          title={t('venue.mapTitle')}
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
      <div class="venue-cards">
        {
          venues.map((venue, i) => (
            <article class="venue-card">
              <p class:list={['venue-num', i === 0 ? 'venue-num--olive' : 'venue-num--brick']}>
                {i + 1}
              </p>
              <h3>{venue.name}</h3>
              <p class="venue-role">{venue.role}</p>
              <p class="venue-address">{venue.address}</p>
              <a class="venue-directions" href={venue.mapsUrl} target="_blank" rel="noopener">
                {t('venue.directions')} →
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .venue {
    position: relative;
    z-index: 1;
    background-color: var(--cream);
    padding-block: var(--space-6);
    border-top: var(--border) var(--ink);
  }
  .venue .eyebrow {
    color: var(--brick);
  }
  h2 {
    font-size: var(--text-h2);
    margin-block: var(--space-1) var(--space-4);
  }

  .venue-grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--space-4);
    align-items: start;
  }

  .venue-map {
    border: var(--border) var(--ink);
    border-radius: var(--radius-card);
    overflow: hidden;
    background-color: var(--cream);
  }
  .venue-map iframe {
    display: block;
    width: 100%;
    aspect-ratio: 6 / 5;
    border: 0;
  }

  .venue-cards {
    display: grid;
    gap: var(--space-3);
  }
  .venue-card {
    display: grid;
    gap: 0.4rem;
    padding: var(--space-3);
    border: var(--border) var(--ink);
    border-radius: var(--radius-card);
    background-color: #fff;
  }
  .venue-num {
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    color: var(--cream);
    font-weight: 800;
  }
  .venue-num--olive {
    background-color: var(--olive);
  }
  .venue-num--brick {
    background-color: var(--brick);
  }
  h3 {
    font-size: var(--text-h3);
  }
  .venue-role {
    font-size: var(--text-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--brick);
  }
  .venue-address {
    font-size: var(--text-body);
  }
  .venue-directions {
    justify-self: start;
    margin-top: var(--space-1);
    font-weight: 800;
    color: var(--brick);
    text-decoration: none;
    border-bottom: 2px solid var(--terracotta);
    transition: color 160ms var(--ease-out);
  }
  .venue-directions:hover {
    color: var(--terracotta);
  }

  @media (max-width: 63.9rem) {
    .venue-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
