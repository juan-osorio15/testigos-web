---
/**
 * Venue (sección 6): dirección SIEMPRE en texto plano + mapa real de
 * Google embebido con loading="lazy" (el embed básico por iframe es
 * gratuito y no requiere API key) + botón "Cómo llegar" por sede (FR-006).
 *
 * Un iframe por sede, apilados: se muestra el de la card sobre la que el
 * visitante pasa el mouse / enfoca / toca (mejora progresiva; sin JS se ve
 * la sede principal). Sede 1 = Hospedería Duruelo, sede 2 = Casa Museo.
 */
import { t } from '../ui';
import { venues } from '../data/event';

const heading = 'Dos sedes, a pocas cuadras';

const mapQueries: Record<string, string> = {
  duruelo: 'Hospedería Duruelo, Villa de Leyva, Boyacá',
  'casa-museo': 'Casa Museo Antonio Nariño, Villa de Leyva, Boyacá',
};

const mapSrc = (id: string) =>
  'https://www.google.com/maps?q=' + encodeURIComponent(mapQueries[id]!) + '&hl=es&z=16&output=embed';
---

<section id="lugar" class="venue" data-reveal>
  <div class="container">
    <p class="eyebrow">{t('nav.venue')}</p>
    <h2>{heading}</h2>
    <div class="venue-grid">
      <div class="venue-maps">
        {
          venues.map((venue, i) => (
            <div
              class:list={['venue-map', { 'is-active': i === 0 }]}
              data-venue-map={venue.id}
            >
              <iframe
                src={mapSrc(venue.id)}
                title={`Mapa de Google: ${venue.name}`}
                loading="lazy"
                allowfullscreen
                referrerpolicy="no-referrer-when-downgrade"
              />
            </div>
          ))
        }
      </div>
      <div class="venue-cards">
        {
          venues.map((venue, i) => (
            <article
              class:list={['venue-card', { 'is-active': i === 0 }]}
              data-venue-card={venue.id}
            >
              <p class:list={['venue-num', i === 0 ? 'venue-num--brick' : 'venue-num--olive']}>
                {i + 1}
              </p>
              <h3>{venue.name}</h3>
              <p class="venue-role">{venue.role}</p>
              <p class="venue-address">{venue.address}</p>
              <a class="venue-directions" href={venue.mapsUrl} target="_blank" rel="noopener">
                {t('venue.directions')} →
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  // El mapa visible sigue a la card activa: hover, foco de teclado o tap.
  const maps = document.querySelectorAll<HTMLElement>('[data-venue-map]');
  const cards = document.querySelectorAll<HTMLElement>('[data-venue-card]');
  const activate = (id: string) => {
    maps.forEach((m) => m.classList.toggle('is-active', m.dataset.venueMap === id));
    cards.forEach((c) => c.classList.toggle('is-active', c.dataset.venueCard === id));
  };
  cards.forEach((card) => {
    const id = card.dataset.venueCard!;
    card.addEventListener('mouseenter', () => activate(id));
    card.addEventListener('focusin', () => activate(id));
    card.addEventListener('click', () => activate(id));
  });
</script>

<style>
  .venue {
    position: relative;
    z-index: 1;
    background-color: var(--cream);
    padding-block: var(--space-6);
    border-top: var(--border) var(--ink);
  }
  .venue .eyebrow {
    color: var(--brick);
  }
  h2 {
    font-size: var(--text-h2);
    margin-block: var(--space-1) var(--space-4);
  }

  .venue-grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--space-4);
    align-items: start;
  }

  /* Mapas apilados en la misma celda; solo el activo es visible */
  .venue-maps {
    display: grid;
    border: var(--border) var(--ink);
    border-radius: var(--radius-card);
    overflow: hidden;
    background-color: var(--cream);
  }
  .venue-map {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition: opacity 220ms var(--ease-out), visibility 220ms;
  }
  .venue-map.is-active {
    opacity: 1;
    visibility: visible;
  }
  .venue-map iframe {
    display: block;
    width: 100%;
    aspect-ratio: 6 / 5;
    border: 0;
  }

  .venue-cards {
    display: grid;
    gap: var(--space-3);
  }
  .venue-card {
    display: grid;
    gap: 0.4rem;
    padding: var(--space-3);
    border: var(--border) var(--ink);
    border-radius: var(--radius-card);
    background-color: #fff;
    transition: border-color 160ms var(--ease-out), box-shadow 160ms var(--ease-out);
  }
  /* La card activa señala qué mapa se está viendo */
  .venue-card.is-active {
    border-color: var(--terracotta);
    box-shadow: inset 0 0 0 1px var(--terracotta);
  }
  .venue-num {
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    color: var(--cream);
    font-weight: 800;
  }
  .venue-num--brick {
    background-color: var(--brick);
  }
  .venue-num--olive {
    background-color: var(--olive);
  }
  h3 {
    font-size: var(--text-h3);
  }
  .venue-role {
    font-size: var(--text-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--brick);
  }
  .venue-address {
    font-size: var(--text-body);
  }
  .venue-directions {
    justify-self: start;
    margin-top: var(--space-1);
    font-weight: 800;
    color: var(--brick);
    text-decoration: none;
    border-bottom: 2px solid var(--terracotta);
    transition: color 160ms var(--ease-out);
  }
  .venue-directions:hover {
    color: var(--terracotta);
  }

  @media (max-width: 63.9rem) {
    .venue-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
