---
/**
 * Hero fijo con cortina (patrón 8.1). Composición: collage de bloques de
 * color a ángulo recto, calcado del afiche y de la valla del manual (pág. 6):
 * terracota con titular en tinta · crema con el logo · mosaico con las
 * caras de los panelistas, cada una con su nombre en franja de tinta ·
 * franja azul cielo con fecha, lugar, contador y CTA.
 * Las caras son lo más vendedor del encuentro (decisión del 2026-09-18),
 * por eso van arriba, en el lugar que antes ocupaba la foto de la casa.
 * Sin bordes redondeados. Sin fondo café. Sin header encima: el logo y el
 * CTA ya viven aquí; el header baja cuando el contenido llega arriba.
 */
import { Image } from 'astro:assets';
import { tFor } from '../ui';
import { event } from '../data/event';
import CtaButton from './CtaButton.astro';
import LogoLockup from '../assets/logo/logo-lockup.svg';
import { heroTile } from '../seo/hero';
import { speakersFor } from '../data/speakers';
import { langOf } from '../i18n';
import { speakerPath } from '../routes';

const t = tFor(Astro.url.pathname);
const lang = langOf(Astro.url.pathname);

/* Escalera de caras, como en el afiche: tres arriba, cuatro en medio y
   cinco abajo, alineadas a la derecha sobre una grilla de siete columnas,
   de modo que cada fila se come un escalón más del terracota. Doce
   panelistas con foto, en el orden editorial de speakers.ts; si algún día
   hay más, el hero muestra los primeros y el carrusel los tiene todos.
   En móvil la escalera no aplica: cuatro columnas a lo ancho. */
const STAIR = [3, 4, 5] as const;
const COLS = 7;
const withPhoto = speakersFor(lang).filter((s) => s.photo !== null);
const tiles = STAIR.flatMap((n, r) =>
  Array.from({ length: n }, (_, k) => ({
    speaker: withPhoto[STAIR.slice(0, r).reduce((a, b) => a + b, 0) + k]!,
    /* fila 1 es el bloque del logo; las caras van de la 2 a la 4 */
    row: r + 2,
    col: COLS - n + k + 1,
  })),
).filter((t) => t.speaker);

/* Slogan aprobado (spec §2), una línea por salto (ui.ts); el nombre del
   evento va en el h1 para SEO/AT y el eslogan es el display visible. */
const slogan = t('hero.slogan').split('\n');

/* Contador: días, horas, minutos y segundos hasta el 5 de noviembre a las
   0:00 de Bogotá. Valor de build como punto de partida; el script lo
   recalcula en el navegador y avanza cada segundo. */
const secondsToStart = Math.max(
  0,
  Math.floor((Date.parse(`${event.startDate}T00:00:00-05:00`) - Date.now()) / 1000),
);
const initial = {
  d: Math.floor(secondsToStart / 86_400),
  h: Math.floor((secondsToStart % 86_400) / 3_600),
  m: Math.floor((secondsToStart % 3_600) / 60),
  s: secondsToStart % 60,
};
const pad = (n: number) => String(n).padStart(2, '0');
/* Etiquetas singular|plural por unidad, para el script */
const units = {
  d: [t('hero.unitDay'), t('hero.unitDays')],
  h: [t('hero.unitHour'), t('hero.unitHours')],
  m: [t('hero.unitMinute'), t('hero.unitMinutes')],
  s: [t('hero.unitSecond'), t('hero.unitSeconds')],
};
const plural = (u: keyof typeof units, n: number) => units[u][n === 1 ? 0 : 1];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-fixed">
    <div class="hero-head">
      <div class="hero-head-inner">
        <LogoLockup class="hero-brand" aria-hidden="true" />
        <p class="eyebrow hero-tagline">{t('hero.tagline')}</p>
        <h1 id="hero-title">
          <span class="sr-only">Testigos de la Memoria: </span>
          {slogan.map((line) => <span class="hero-line">{line}</span>)}
        </h1>
        <p class="hero-note">
          <span class="hero-note-line">
            <span>{t('hero.edition')}</span>
            <span class="hero-after-sep">{t('hero.capacity')}</span>
          </span>
          <span class="hero-note-line">{t('hero.format')}</span>
        </p>
        <p class="hero-pitch">{t('hero.pitch')}</p>
      </div>
    </div>
    <div class="hero-side">
      <div class="hero-watch-block">
        <LogoLockup class="hero-logo" aria-hidden="true" />
      </div>
      <ul class="hero-faces" role="list" aria-label={t('nav.speakers')}>
        {
          tiles.map(({ speaker, row, col }) => (
            <li style={`--r: ${row}; --c: ${col}`}>
              <a
                class="hero-tile"
                href={speakerPath(speaker.slug)}
                aria-label={speaker.name}
                style={speaker.photoFocus && `--photo-focus: ${speaker.photoFocus}`}
              >
                <span class="hero-tile-inner">
                  <span class="hero-tile-front">
                    <span class:list={['grain', 'hero-tile-photo', speaker.photoTreatment && `hero-tile-photo--${speaker.photoTreatment}`]}>
                      {/* LCP: `priority` = eager + fetchpriority high; widths y sizes
                          de src/seo/hero.ts, los mismos del <link rel="preload"> */}
                      <Image
                        src={speaker.photo!}
                        alt=""
                        widths={[...heroTile.widths]}
                        sizes={heroTile.sizes}
                        priority
                      />
                    </span>
                    <span class="hero-tile-name">{speaker.name}</span>
                  </span>
                  {/* Dorso al pasar el mouse: la misma foto (mismo srcset, ya en
                      caché) como duotono oliva apagado, y encima el nombre,
                      la credencial y el llamado a la ficha */}
                  <span class="hero-tile-back" aria-hidden="true">
                    <span class="duotone hero-tile-ghost">
                      <Image
                        src={speaker.photo!}
                        alt=""
                        widths={[...heroTile.widths]}
                        sizes={heroTile.sizes}
                        loading="lazy"
                      />
                    </span>
                    <span class="hero-tile-back-text">
                      <span class="hero-tile-back-name">{speaker.name}</span>
                      <span class="hero-tile-back-credential">{speaker.credential}</span>
                      <span class="hero-tile-back-cta">{t('hero.tileCta')}</span>
                    </span>
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="hero-strip">
      <p class="hero-fact hero-date">
        <span class="hero-fact-num">5–8</span>
        <span class="hero-fact-label">
          <span>{t('hero.month')}</span>
          <span class="hero-after-sep">{t('hero.place')}</span>
        </span>
      </p>
      <p
        class="hero-count"
        data-countdown
        data-start={event.startDate}
        data-end={event.endDate}
        data-units={JSON.stringify(units)}
        data-today={t('hero.countdownToday')}
        data-live={t('hero.countdownLive')}
        aria-label={t('hero.countdownAria')}
      >
        <span class="hero-fact">
          <span class="hero-fact-num" data-unit="d">{initial.d}</span>
          <span class="hero-fact-label" data-unit-label="d">{plural('d', initial.d)}</span>
        </span>
        <span class="hero-fact">
          <span class="hero-fact-num" data-unit="h">{pad(initial.h)}</span>
          <span class="hero-fact-label" data-unit-label="h">{plural('h', initial.h)}</span>
        </span>
        <span class="hero-fact">
          <span class="hero-fact-num" data-unit="m">{pad(initial.m)}</span>
          <span class="hero-fact-label" data-unit-label="m">{plural('m', initial.m)}</span>
        </span>
        <span class="hero-fact">
          <span class="hero-fact-num" data-unit="s">{pad(initial.s)}</span>
          <span class="hero-fact-label" data-unit-label="s">{plural('s', initial.s)}</span>
        </span>
      </p>
      <CtaButton />
    </div>
  </div>
  <div class="hero-spacer"></div>
  <div class="hero-sentinel" data-header-sentinel aria-hidden="true"></div>
</section>

<script>
  // Contador hasta el inicio, con hora de Bogotá, actualizado cada segundo.
  // Sin JS queda el valor calculado en el build.
  const box = document.querySelector<HTMLElement>('[data-countdown]');
  if (box && box.dataset.start && box.dataset.end && box.dataset.units) {
    const start = Date.parse(`${box.dataset.start}T00:00:00-05:00`);
    const end = Date.parse(`${box.dataset.end}T23:59:59-05:00`);
    const units = JSON.parse(box.dataset.units) as Record<string, [string, string]>;
    const nums = new Map<string, HTMLElement>();
    const labels = new Map<string, HTMLElement>();
    box.querySelectorAll<HTMLElement>('[data-unit]').forEach((el) => nums.set(el.dataset.unit!, el));
    box.querySelectorAll<HTMLElement>('[data-unit-label]').forEach((el) => labels.set(el.dataset.unitLabel!, el));
    const pad = (n: number) => String(n).padStart(2, '0');
    const set = (u: string, n: number, padded: boolean) => {
      const num = nums.get(u);
      const label = labels.get(u);
      if (num) num.textContent = padded ? pad(n) : String(n);
      if (label) label.textContent = units[u][n === 1 ? 0 : 1];
    };
    /* Devuelve true mientras haya cuenta regresiva que mostrar */
    const tick = (): boolean => {
      const now = Date.now();
      const total = Math.floor((start - now) / 1000);
      if (total > 0) {
        set('d', Math.floor(total / 86_400), false);
        set('h', Math.floor((total % 86_400) / 3_600), true);
        set('m', Math.floor((total % 3_600) / 60), true);
        set('s', total % 60, true);
        return true;
      }
      box.textContent = now < start + 86_400_000 ? box.dataset.today! : box.dataset.live!;
      box.classList.add('hero-count--text');
      box.hidden = now > end;
      return false;
    };
    if (tick()) {
      const id = window.setInterval(() => {
        if (!tick()) window.clearInterval(id);
      }, 1000);
    }
  }
</script>

<style>
  .hero-fixed {
    position: fixed;
    inset: 0;
    z-index: 0;
    display: grid;
    /* Siete columnas iguales: el logo ocupa las tres de la derecha en la
       primera fila y las caras bajan en escalera (3 · 4 · 5) pegadas al
       borde derecho. Lo que la escalera no cubre es terracota: el fondo. */
    grid-template-columns: repeat(7, minmax(0, 1fr));
    grid-template-rows: repeat(4, minmax(0, 1fr)) auto;
    background-color: var(--terracotta);
    color: var(--ink);
    overflow: hidden;
    /* Mientras el aviso de cookies está a la vista, el hero se recorta lo
       que mide el aviso (ConsentNotice publica --consent-h): la franja
       azul con el contador y el CTA queda entera, justo encima. */
    height: calc(100svh - var(--consent-h, 0px));
  }

  .hero-spacer {
    height: 100svh;
  }
  /* Centinela del header: ocupa el primer quinto del recorrido del hero.
     Cuando sale del viewport (scroll ≈ 20 %), el header baja. */
  .hero {
    position: relative;
  }
  .hero-sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 20svh;
    pointer-events: none;
  }

  /* Bloque terracota: el titular en tinta, como la valla. Ocupa el
     rincón superior izquierdo que la escalera deja libre (tres columnas
     por tres filas); el escalón inferior queda en terracota vacío. */
  .hero-head {
    grid-column: 1 / 4;
    grid-row: 1 / 4;
    min-height: 0;
    display: grid;
    align-content: center;
    /* El bloque queda pegado al gutter izquierdo (alineado con el "5–8" de
       la franja) y crece hacia la escalera: el titular se agranda con el
       ancho disponible en vez de dejar terracota vacío en medio */
    padding: var(--space-3) var(--space-2) var(--space-3) var(--gutter);
  }
  .hero-head-inner {
    display: grid;
    /* Los espacios y el titular escalan también con la altura de la
       ventana: en pantallas bajas el bloque no se come la franja azul */
    gap: clamp(0.75rem, 3.2svh, 3rem);
    width: 100%;
  }

  /* Logo pequeño solo en móvil, donde no hay bloque crema con el lockup */
  .hero-brand {
    display: none;
    width: 72px;
    height: auto;
    color: var(--ink);
  }

  .hero-tagline {
    color: var(--ink);
  }

  /* Un escalón menor que antes: el bloque es más angosto y las caras
     comparten el protagonismo */
  h1 {
    /* Escala con el ancho del bloque (tres columnas de siete: 3.7vw da
       para "de Colombia, contada" en una línea) y con la altura de la
       ventana, para que las cuatro líneas llenen el terracota */
    font-size: min(clamp(2rem, 3.7vw - 0.2rem, 5rem), 6.6svh);
    font-weight: 800;
    display: grid;
  }
  .hero-line {
    display: block;
  }
  /* Última línea en crema, misma grotesca que el resto (decisión del
     2026-09-18: menos tipografías en el hero; el contraste lo da el color) */
  .hero-line:last-child {
    color: var(--cream);
  }

  /* Datos en dos líneas de peso parejo: "edición · aforo" y el formato. */
  .hero-note {
    margin-top: var(--space-1);
    display: grid;
    gap: 0.3em;
    font-size: clamp(0.8125rem, 0.7rem + 0.3vw, 1rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink);
    opacity: 0.85;
  }
  .hero-note-line {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.6em;
    row-gap: 0.2em;
  }
  .hero-note-line > span {
    white-space: nowrap;
  }
  /* El punto viaja con la frase que le sigue: nunca queda colgado al final
     de una línea si el texto se parte. */
  .hero-after-sep::before {
    content: '· ';
    font-weight: 500;
  }
  /* Frase antojadora bajo los datos: llena el terracota que la escalera
     deja libre en escritorio. En móvil no va: allí el bloque ya es alto y
     las caras y la franja deben quedar cerca. */
  /* En crema, como el remate del titular; nombra Villa de Leyva para que
     nadie llegue a las boletas creyendo que el encuentro es en Bogotá */
  .hero-pitch {
    font-size: clamp(1.1rem, 0.8rem + 0.8vw, 1.7rem);
    font-weight: 500;
    line-height: 1.4;
    max-width: 32ch;
    text-wrap: pretty;
    color: var(--cream);
  }
  /* En ventanas bajas (portátiles pequeños) el bloque no da para la frase
     sin desbordar sus tres filas: se omite */
  @media (max-height: 46rem) {
    .hero-pitch {
      display: none;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* En escritorio el contenedor y la lista no pintan nada: el bloque del
     logo y cada tile son hijos directos de la grilla del hero. */
  .hero-side,
  .hero-faces,
  .hero-faces li {
    display: contents;
  }
  /* Bloque crema con el logo completo, como la valla del manual: las dos
     columnas de la derecha en la primera fila, encima de la escalera. El
     logo va pegado a la derecha con el mismo gutter de la franja, así su
     borde derecho coincide con el del botón de comprar. */
  .hero-watch-block {
    grid-column: 6 / -1;
    grid-row: 1;
    min-height: 0;
    background-color: var(--cream);
    display: grid;
    align-content: center;
    justify-content: end;
    padding: var(--space-2) var(--gutter) var(--space-2) var(--space-3);
  }
  .hero-logo {
    /* Manda la altura de la fila; el ancho sigue la proporción del lockup */
    height: min(15svh, 11rem);
    width: auto;
    max-width: 100%;
    color: var(--ink);
  }

  /* Mosaico: doce tiles que se tocan, sin márgenes (fórmula §1). Cada
     tile es foto b/n con grano arriba y el nombre en franja de tinta
     debajo, como en el afiche: nunca texto sobre la foto (§8). */
  .hero-faces {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hero-tile {
    /* Posición en la escalera (--r/--c los pone cada <li>) */
    grid-row: var(--r);
    grid-column: var(--c);
    display: block;
    position: relative;
    min-height: 0;
    color: var(--cream);
    text-decoration: none;
    perspective: 1000px;
  }
  /* Carta de dos caras: el frente es la foto con el nombre; el dorso, un
     bloque oliva. Gira sobre su eje vertical al pasar el mouse o al
     recibir el foco; en pantallas táctiles no hay giro, solo el enlace. */
  .hero-tile-inner {
    position: relative;
    display: grid;
    height: 100%;
    min-height: 0;
    transform-style: preserve-3d;
    transition: transform 560ms var(--ease-out);
  }
  .hero-tile-front {
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    min-height: 0;
    backface-visibility: hidden;
  }
  /* En escritorio el frente es solo la cara: el nombre vive en el dorso
     (al pasar el mouse). En móvil, sin hover, la franja con el nombre
     vuelve a aparecer. */
  .hero-tile-name {
    display: none;
  }
  .hero-tile-back {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: end;
    overflow: hidden;
    background-color: var(--olive);
    color: var(--cream);
    transform: rotateY(180deg);
    backface-visibility: hidden;
  }
  /* La cara como fantasma: duotono oliva muy apagado, para que el nombre
     en crema se lea encima sin esfuerzo */
  .hero-tile-ghost {
    --duotone-tint: var(--olive);
    position: absolute;
    inset: 0;
  }
  .hero-tile-ghost :global(img) {
    height: 100%;
    object-position: var(--photo-focus, 50% 22%);
    opacity: 0.32;
  }
  .hero-tile-back-text {
    position: relative;
    display: grid;
    gap: 0.25em;
    padding: 0.6em 0.7em;
  }
  .hero-tile-back-name {
    font-size: clamp(0.85rem, 0.6rem + 0.7vw, 1.15rem);
    font-weight: 800;
    line-height: 1.1;
    text-wrap: balance;
  }
  .hero-tile-back-credential {
    font-size: clamp(0.55rem, 0.45rem + 0.3vw, 0.7rem);
    font-weight: 700;
    line-height: 1.25;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.9;
  }
  .hero-tile-back-cta {
    margin-top: 0.35em;
    font-size: clamp(0.55rem, 0.45rem + 0.3vw, 0.7rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 1px;
  }
  @media (hover: hover) {
    .hero-tile:hover .hero-tile-inner {
      transform: rotateY(180deg);
    }
  }
  .hero-tile:focus-visible .hero-tile-inner {
    transform: rotateY(180deg);
  }
  /* Sin movimiento: el dorso aparece por fundido, sin giro */
  @media (prefers-reduced-motion: reduce) {
    .hero-tile-inner {
      transition: none;
      transform-style: flat;
    }
    .hero-tile-back {
      transform: none;
      opacity: 0;
      transition: opacity 200ms var(--ease-out);
    }
    .hero-tile:hover .hero-tile-inner,
    .hero-tile:focus-visible .hero-tile-inner {
      transform: none;
    }
    .hero-tile:hover .hero-tile-back,
    .hero-tile:focus-visible .hero-tile-back {
      opacity: 1;
    }
  }
  .hero-tile-photo {
    display: block;
    min-height: 0;
  }
  .hero-tile-photo :global(img) {
    display: block;
    height: 100%;
    /* Recorte apaisado: la cara queda en el tercio superior del original,
       salvo que el panelista traiga su propio punto (photoFocus) */
    object-position: var(--photo-focus, 50% 22%);
    transition: filter 200ms var(--ease-out);
  }
  /* Ajustes por original (ver photoTreatment en speakers.ts) */
  .hero-tile-photo--soft :global(img) {
    filter: grayscale(1) sepia(0.18) contrast(1.02) brightness(0.97);
  }
  .hero-tile-photo--plain :global(img) {
    filter: sepia(0.08);
  }
  .hero-tile-photo--plain::after {
    opacity: 0.45;
  }
  .hero-tile-name {
    align-content: center;
    min-height: 2.6em;
    padding: 0.25em 0.5em;
    background-color: var(--ink);
    font-size: clamp(0.65rem, 0.5rem + 0.45vw, 0.85rem);
    font-weight: 700;
    line-height: 1.15;
    text-align: center;
    letter-spacing: 0.02em;
    text-wrap: balance;
  }
  .hero-tile:focus-visible {
    outline: 2px solid var(--cream);
    outline-offset: -2px;
  }

  /* Franja azul cielo: a la izquierda fecha y lugar, a la derecha el
     contador y el CTA. Dos "hechos" con la misma anatomía: cifra grande
     en Archivo 800 y etiqueta en caps, alineados por la línea base. */
  .hero-strip {
    grid-column: 1 / -1;
    grid-row: 5;
    background-color: var(--sky);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-2) var(--gutter);
  }
  .hero-fact {
    display: flex;
    align-items: baseline;
    gap: 0.5em;
  }
  .hero-fact-num {
    flex-shrink: 0;
    white-space: nowrap;
    font-weight: 800;
    font-size: clamp(2rem, 1.2rem + 1.7vw, 2.9rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .hero-fact-label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.6em;
    row-gap: 0.2em;
    font-size: clamp(0.8125rem, 0.65rem + 0.25vw, 0.9375rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .hero-fact-label > span {
    white-space: nowrap;
  }
  .hero-fact-label .hero-after-sep::before {
    content: '· ';
    font-weight: 500;
  }
  /* Contador: cuatro unidades con la misma anatomía de la fecha */
  .hero-count {
    margin-left: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.7em;
    row-gap: 0.3em;
  }
  /* Sin cifra (hoy empieza / en curso): la frase toma el estilo de etiqueta */
  .hero-count--text {
    font-size: var(--text-label);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

