---
/**
 * Hero fijo con cortina (patrón 8.1). Composición: collage de bloques de
 * color a ángulo recto, calcado del afiche y de la valla del manual (pág. 6):
 * terracota con titular en tinta · crema con el logo · mosaico con las
 * caras de los panelistas, cada una con su nombre en franja de tinta ·
 * franja azul cielo con fecha, lugar, contador y CTA.
 * Las caras son lo más vendedor del encuentro (decisión del 2026-09-18),
 * por eso van arriba, en el lugar que antes ocupaba la foto de la casa.
 * Sin bordes redondeados. Sin fondo café. Sin header encima: el logo y el
 * CTA ya viven aquí; el header baja cuando el contenido llega arriba.
 */
import { Image } from 'astro:assets';
import { t } from '../ui';
import { event } from '../data/event';
import CtaButton from './CtaButton.astro';
import LogoLockup from '../assets/logo/logo-lockup.svg';
import { heroTile } from '../seo/hero';
import { speakers } from '../data/speakers';
import { speakerPath } from '../routes';

/* Mosaico 4×3: los doce panelistas con foto, en el orden editorial de
   speakers.ts. Si algún día hay más de doce, el hero muestra los primeros
   y el carrusel los tiene todos. */
const tiles = speakers.filter((s) => s.photo !== null).slice(0, 12);

/* Slogan aprobado (spec §2); el nombre del evento va en el h1 para SEO/AT
   y el eslogan es el display visible. */
const slogan = ['La historia reciente', 'de Colombia, contada', 'por quienes', 'la viven de frente.'];

/* Contador: días, horas, minutos y segundos hasta el 5 de noviembre a las
   0:00 de Bogotá. Valor de build como punto de partida; el script lo
   recalcula en el navegador y avanza cada segundo. */
const secondsToStart = Math.max(
  0,
  Math.floor((Date.parse(`${event.startDate}T00:00:00-05:00`) - Date.now()) / 1000),
);
const initial = {
  d: Math.floor(secondsToStart / 86_400),
  h: Math.floor((secondsToStart % 86_400) / 3_600),
  m: Math.floor((secondsToStart % 3_600) / 60),
  s: secondsToStart % 60,
};
const pad = (n: number) => String(n).padStart(2, '0');
/* Etiquetas singular|plural por unidad, para el script */
const units = {
  d: [t('hero.unitDay'), t('hero.unitDays')],
  h: [t('hero.unitHour'), t('hero.unitHours')],
  m: [t('hero.unitMinute'), t('hero.unitMinutes')],
  s: [t('hero.unitSecond'), t('hero.unitSeconds')],
};
const plural = (u: keyof typeof units, n: number) => units[u][n === 1 ? 0 : 1];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-fixed">
    <div class="hero-head">
      <div class="hero-head-inner">
        <LogoLockup class="hero-brand" aria-hidden="true" />
        <p class="eyebrow hero-tagline">{t('hero.tagline')}</p>
        <h1 id="hero-title">
          <span class="sr-only">Testigos de la Memoria: </span>
          {slogan.map((line) => <span class="hero-line">{line}</span>)}
        </h1>
        <p class="hero-note">
          <span class="hero-note-line">
            <span>{t('hero.edition')}</span>
            <span class="hero-after-sep">{t('hero.capacity')}</span>
          </span>
          <span class="hero-note-line">{t('hero.format')}</span>
        </p>
      </div>
    </div>
    <div class="hero-side">
      <div class="hero-watch-block">
        <LogoLockup class="hero-logo" aria-hidden="true" />
      </div>
      <ul class="hero-faces" role="list" aria-label={t('nav.speakers')}>
        {
          tiles.map((speaker) => (
            <li>
              <a class="hero-tile" href={speakerPath(speaker.slug)}>
                <span class="hero-tile-inner">
                  <span class="hero-tile-front">
                    <span class:list={['grain', 'hero-tile-photo', speaker.photoTreatment && `hero-tile-photo--${speaker.photoTreatment}`]}>
                      {/* LCP: `priority` = eager + fetchpriority high; widths y sizes
                          de src/seo/hero.ts, los mismos del <link rel="preload"> */}
                      <Image
                        src={speaker.photo!}
                        alt=""
                        widths={[...heroTile.widths]}
                        sizes={heroTile.sizes}
                        priority
                      />
                    </span>
                    <span class="hero-tile-name">{speaker.name}</span>
                  </span>
                  {/* Dorso al pasar el mouse: la misma foto (mismo srcset, ya en
                      caché) como duotono terracota apagado, y encima el nombre,
                      la credencial y el llamado a la ficha */}
                  <span class="hero-tile-back" aria-hidden="true">
                    <span class="duotone hero-tile-ghost">
                      <Image
                        src={speaker.photo!}
                        alt=""
                        widths={[...heroTile.widths]}
                        sizes={heroTile.sizes}
                        loading="lazy"
                      />
                    </span>
                    <span class="hero-tile-back-text">
                      <span class="hero-tile-back-name">{speaker.name}</span>
                      <span class="hero-tile-back-credential">{speaker.credential}</span>
                      <span class="hero-tile-back-cta">{t('hero.tileCta')}</span>
                    </span>
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="hero-strip">
      <p class="hero-fact hero-date">
        <span class="hero-fact-num">5–8</span>
        <span class="hero-fact-label">
          <span>noviembre 2026</span>
          <span class="hero-after-sep">{t('hero.place')}</span>
        </span>
      </p>
      <p
        class="hero-count"
        data-countdown
        data-start={event.startDate}
        data-end={event.endDate}
        data-units={JSON.stringify(units)}
        data-today={t('hero.countdownToday')}
        data-live={t('hero.countdownLive')}
        aria-label={t('hero.countdownAria')}
      >
        <span class="hero-fact">
          <span class="hero-fact-num" data-unit="d">{initial.d}</span>
          <span class="hero-fact-label" data-unit-label="d">{plural('d', initial.d)}</span>
        </span>
        <span class="hero-fact">
          <span class="hero-fact-num" data-unit="h">{pad(initial.h)}</span>
          <span class="hero-fact-label" data-unit-label="h">{plural('h', initial.h)}</span>
        </span>
        <span class="hero-fact">
          <span class="hero-fact-num" data-unit="m">{pad(initial.m)}</span>
          <span class="hero-fact-label" data-unit-label="m">{plural('m', initial.m)}</span>
        </span>
        <span class="hero-fact">
          <span class="hero-fact-num" data-unit="s">{pad(initial.s)}</span>
          <span class="hero-fact-label" data-unit-label="s">{plural('s', initial.s)}</span>
        </span>
      </p>
      <CtaButton />
    </div>
  </div>
  <div class="hero-spacer"></div>
  <div class="hero-sentinel" data-header-sentinel aria-hidden="true"></div>
</section>

<script>
  // Contador hasta el inicio, con hora de Bogotá, actualizado cada segundo.
  // Sin JS queda el valor calculado en el build.
  const box = document.querySelector<HTMLElement>('[data-countdown]');
  if (box && box.dataset.start && box.dataset.end && box.dataset.units) {
    const start = Date.parse(`${box.dataset.start}T00:00:00-05:00`);
    const end = Date.parse(`${box.dataset.end}T23:59:59-05:00`);
    const units = JSON.parse(box.dataset.units) as Record<string, [string, string]>;
    const nums = new Map<string, HTMLElement>();
    const labels = new Map<string, HTMLElement>();
    box.querySelectorAll<HTMLElement>('[data-unit]').forEach((el) => nums.set(el.dataset.unit!, el));
    box.querySelectorAll<HTMLElement>('[data-unit-label]').forEach((el) => labels.set(el.dataset.unitLabel!, el));
    const pad = (n: number) => String(n).padStart(2, '0');
    const set = (u: string, n: number, padded: boolean) => {
      const num = nums.get(u);
      const label = labels.get(u);
      if (num) num.textContent = padded ? pad(n) : String(n);
      if (label) label.textContent = units[u][n === 1 ? 0 : 1];
    };
    /* Devuelve true mientras haya cuenta regresiva que mostrar */
    const tick = (): boolean => {
      const now = Date.now();
      const total = Math.floor((start - now) / 1000);
      if (total > 0) {
        set('d', Math.floor(total / 86_400), false);
        set('h', Math.floor((total % 86_400) / 3_600), true);
        set('m', Math.floor((total % 3_600) / 60), true);
        set('s', total % 60, true);
        return true;
      }
      box.textContent = now < start + 86_400_000 ? box.dataset.today! : box.dataset.live!;
      box.classList.add('hero-count--text');
      box.hidden = now > end;
      return false;
    };
    if (tick()) {
      const id = window.setInterval(() => {
        if (!tick()) window.clearInterval(id);
      }, 1000);
    }
  }
</script>

<style>
  .hero-fixed {
    position: fixed;
    inset: 0;
    z-index: 0;
    display: grid;
    /* Terracota ≈ 45 %, columna del logo y las caras ≈ 55 % */
    grid-template-columns: minmax(0, 9fr) minmax(0, 11fr);
    grid-template-rows: 1fr auto;
    grid-template-areas:
      'head side'
      'strip strip';
    background-color: var(--cream);
    color: var(--ink);
    overflow: hidden;
  }

  .hero-spacer {
    height: 100svh;
  }
  /* Centinela del header: ocupa el primer quinto del recorrido del hero.
     Cuando sale del viewport (scroll ≈ 20 %), el header baja. */
  .hero {
    position: relative;
  }
  .hero-sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 20svh;
    pointer-events: none;
  }

  /* Bloque terracota: el titular en tinta, como la valla */
  .hero-head {
    grid-area: head;
    background-color: var(--terracotta);
    display: grid;
    align-content: center;
    padding: var(--space-4) var(--gutter);
  }
  .hero-head-inner {
    display: grid;
    /* Los espacios y el titular escalan también con la altura de la
       ventana: en pantallas bajas el bloque no se come la franja azul */
    gap: clamp(1.25rem, 3.6svh, 2.5rem);
    max-width: 30rem;
    width: 100%;
    /* Un poco más a la izquierda que el .container de las secciones:
       un tercio del margen sobrante del max-width global (el gutter ya
       lo pone el padding del bloque) */
    margin-left: max(0px, calc((100vw - var(--max-width)) / 3));
  }

  /* Logo pequeño solo en móvil, donde no hay bloque crema con el lockup */
  .hero-brand {
    display: none;
    width: 72px;
    height: auto;
    color: var(--ink);
  }

  .hero-tagline {
    color: var(--ink);
  }

  /* Un escalón menor que antes: el bloque es más angosto y las caras
     comparten el protagonismo */
  h1 {
    font-size: min(clamp(2rem, 0.9rem + 3.4vw, 3.6rem), 6.5svh);
    font-weight: 800;
    display: grid;
  }
  .hero-line {
    display: block;
  }
  /* Acento serif editorial en la última línea — eco del wordmark */
  .hero-line:last-child {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--cream);
  }

  /* Datos en dos líneas de peso parejo: "edición · aforo" y el formato. */
  .hero-note {
    margin-top: var(--space-1);
    display: grid;
    gap: 0.25em;
    font-size: var(--text-label);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink);
    opacity: 0.85;
  }
  .hero-note-line {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.6em;
    row-gap: 0.2em;
  }
  .hero-note-line > span {
    white-space: nowrap;
  }
  /* El punto viaja con la frase que le sigue: nunca queda colgado al final
     de una línea si el texto se parte. */
  .hero-after-sep::before {
    content: '· ';
    font-weight: 500;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Columna derecha: crema con el logo arriba + mosaico de caras abajo */
  .hero-side {
    grid-area: side;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    min-height: 0;
  }
  /* Bloque crema con el logo completo, como la valla del manual. */
  .hero-watch-block {
    background-color: var(--cream);
    display: grid;
    place-content: center;
    padding: var(--space-3) var(--space-4);
  }
  .hero-logo {
    width: min(clamp(200px, 22vw, 340px), 24svh);
    height: auto;
    color: var(--ink);
  }

  /* Mosaico: doce tiles que se tocan, sin márgenes (fórmula §1). Cada
     tile es foto b/n con grano arriba y el nombre en franja de tinta
     debajo, como en el afiche: nunca texto sobre la foto (§8). */
  .hero-faces {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: minmax(0, 1fr);
    list-style: none;
    margin: 0;
    padding: 0;
    min-height: 0;
    background-color: var(--ink);
  }
  .hero-faces li {
    display: grid;
    min-height: 0;
  }
  .hero-tile {
    display: block;
    position: relative;
    min-height: 0;
    color: var(--cream);
    text-decoration: none;
    perspective: 1000px;
  }
  /* Carta de dos caras: el frente es la foto con el nombre; el dorso, un
     bloque terracota. Gira sobre su eje vertical al pasar el mouse o al
     recibir el foco; en pantallas táctiles no hay giro, solo el enlace. */
  .hero-tile-inner {
    position: relative;
    display: grid;
    height: 100%;
    min-height: 0;
    transform-style: preserve-3d;
    transition: transform 560ms var(--ease-out);
  }
  .hero-tile-front {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    min-height: 0;
    backface-visibility: hidden;
  }
  .hero-tile-back {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: end;
    overflow: hidden;
    background-color: var(--terracotta);
    color: var(--ink);
    transform: rotateY(180deg);
    backface-visibility: hidden;
  }
  /* La cara como fantasma: duotono terracota muy apagado, para que el
     nombre en tinta se lea encima sin esfuerzo */
  .hero-tile-ghost {
    --duotone-tint: var(--terracotta);
    position: absolute;
    inset: 0;
  }
  .hero-tile-ghost :global(img) {
    height: 100%;
    object-position: 50% 22%;
    opacity: 0.32;
  }
  .hero-tile-back-text {
    position: relative;
    display: grid;
    gap: 0.25em;
    padding: 0.6em 0.7em;
  }
  .hero-tile-back-name {
    font-size: clamp(0.85rem, 0.6rem + 0.7vw, 1.15rem);
    font-weight: 800;
    line-height: 1.1;
    text-wrap: balance;
  }
  .hero-tile-back-credential {
    font-size: clamp(0.55rem, 0.45rem + 0.3vw, 0.7rem);
    font-weight: 700;
    line-height: 1.25;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.9;
  }
  .hero-tile-back-cta {
    margin-top: 0.35em;
    font-size: clamp(0.55rem, 0.45rem + 0.3vw, 0.7rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 1px;
  }
  @media (hover: hover) {
    .hero-tile:hover .hero-tile-inner {
      transform: rotateY(180deg);
    }
  }
  .hero-tile:focus-visible .hero-tile-inner {
    transform: rotateY(180deg);
  }
  /* Sin movimiento: el dorso aparece por fundido, sin giro */
  @media (prefers-reduced-motion: reduce) {
    .hero-tile-inner {
      transition: none;
      transform-style: flat;
    }
    .hero-tile-back {
      transform: none;
      opacity: 0;
      transition: opacity 200ms var(--ease-out);
    }
    .hero-tile:hover .hero-tile-inner,
    .hero-tile:focus-visible .hero-tile-inner {
      transform: none;
    }
    .hero-tile:hover .hero-tile-back,
    .hero-tile:focus-visible .hero-tile-back {
      opacity: 1;
    }
  }
  .hero-tile-photo {
    display: block;
    min-height: 0;
  }
  .hero-tile-photo :global(img) {
    display: block;
    height: 100%;
    /* Recorte apaisado: la cara queda en el tercio superior del original */
    object-position: 50% 22%;
    transition: filter 200ms var(--ease-out);
  }
  /* Ajustes por original (ver photoTreatment en speakers.ts) */
  .hero-tile-photo--soft :global(img) {
    filter: grayscale(1) sepia(0.18) contrast(1.02) brightness(0.97);
  }
  .hero-tile-photo--plain :global(img) {
    filter: sepia(0.08);
  }
  .hero-tile-photo--plain::after {
    opacity: 0.45;
  }
  .hero-tile-name {
    display: grid;
    align-content: center;
    min-height: 2.6em;
    padding: 0.25em 0.5em;
    background-color: var(--ink);
    font-size: clamp(0.65rem, 0.5rem + 0.45vw, 0.85rem);
    font-weight: 700;
    line-height: 1.15;
    text-align: center;
    letter-spacing: 0.02em;
    text-wrap: balance;
  }
  .hero-tile:focus-visible {
    outline: 2px solid var(--cream);
    outline-offset: -2px;
  }

  /* Franja azul cielo: a la izquierda fecha y lugar, a la derecha el
     contador y el CTA. Dos "hechos" con la misma anatomía: cifra grande
     en Archivo 800 y etiqueta en caps, alineados por la línea base. */
  .hero-strip {
    grid-area: strip;
    background-color: var(--sky);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-2) var(--gutter);
  }
  .hero-fact {
    display: flex;
    align-items: baseline;
    gap: 0.5em;
  }
  .hero-fact-num {
    flex-shrink: 0;
    white-space: nowrap;
    font-weight: 800;
    font-size: clamp(1.8rem, 1.2rem + 1.6vw, 2.6rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .hero-fact-label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.6em;
    row-gap: 0.2em;
    font-size: var(--text-label);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .hero-fact-label > span {
    white-space: nowrap;
  }
  .hero-fact-label .hero-after-sep::before {
    content: '· ';
    font-weight: 500;
  }
  /* Contador: cuatro unidades con la misma anatomía de la fecha */
  .hero-count {
    margin-left: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.9em;
    row-gap: 0.3em;
  }
  /* Sin cifra (hoy empieza / en curso): la frase toma el estilo de etiqueta */
  .hero-count--text {
    font-size: var(--text-label);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  @media (max-width: 63.9rem) {
    /* En móvil el hero fluye con la página en lugar de quedar fijo: así
       nunca recorta la franja azul con el contador y el CTA en pantallas
       bajas ni detrás de la barra del navegador. Sigue llenando la
       primera pantalla cuando cabe. */
    .hero-fixed {
      position: relative;
      inset: auto;
      min-height: 100svh;
      overflow: visible;
      grid-template-columns: 1fr;
      /* El texto va arriba; la foto absorbe la altura sobrante en
         celulares altos (más tejado y buganvilias), en vez de dejar
         aire vacío alrededor del texto */
      grid-template-rows: auto minmax(0, 1fr) auto;
      grid-template-areas:
        'head'
        'side'
        'strip';
    }
    .hero-spacer {
      display: none;
    }
    .hero-head {
      align-content: start;
      padding: var(--space-3) var(--gutter);
    }
    .hero-head-inner {
      max-width: none;
      margin-left: 0;
      gap: var(--space-2);
    }
    /* Logo en crema: contrasta con el texto en tinta del bloque */
    .hero-brand {
      display: block;
      margin-bottom: var(--space-1);
      color: var(--cream);
    }
    h1 {
      font-size: min(clamp(1.7rem, 0.9rem + 5vw, 2.6rem), 6svh);
    }
    /* En móvil el logo pequeño del bloque terracota basta: el mosaico
       ocupa la columna entera, cuatro caras por fila */
    .hero-watch-block {
      display: none;
    }
    .hero-side {
      grid-template-rows: minmax(0, 1fr);
    }
    /* Las filas reparten la altura sobrante del hero (celulares altos);
       en los bajos, cada foto conserva al menos un recorte casi cuadrado */
    .hero-tile-inner,
    .hero-tile-front {
      height: 100%;
    }
    .hero-tile-photo {
      min-height: 19vw;
    }
    .hero-tile-name {
      font-size: 0.6rem;
      padding-inline: 0.25em;
    }
    /* Franja compacta: datos apilados y CTA a lo ancho, siempre visible */
    .hero-strip {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.4rem;
      padding: var(--space-2) var(--gutter);
    }
    .hero-fact-num {
      font-size: 1.5rem;
    }
    /* Mes y lugar apilados junto a la cifra, sin punto entre líneas */
    .hero-date .hero-fact-label {
      flex-direction: column;
      row-gap: 0.15em;
    }
    .hero-date .hero-after-sep::before {
      content: none;
    }
    /* Contador en cuatro columnas, etiqueta bajo cada cifra */
    .hero-count {
      margin-left: 0;
      display: grid;
      grid-template-columns: repeat(4, auto);
      justify-content: start;
      column-gap: 1.1rem;
      row-gap: 0;
    }
    .hero-count .hero-fact {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.15em;
    }
    .hero-count .hero-fact-label {
      font-size: 0.7rem;
      letter-spacing: 0.08em;
    }
    .hero-strip :global(.cta) {
      justify-self: stretch;
