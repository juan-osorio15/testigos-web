---
/**
 * FAQs (sección 7): <details>/<summary> nativo — accesible y funcional
 * sin JS (FR-018). Cierra con el CTA final de la página.
 */
import { t } from '../ui';
import { faqs } from '../data/faqs';
import CtaButton from './CtaButton.astro';

const heading = 'Preguntas frecuentes';
const closing = 'Nos vemos en Villa de Leyva.';
---

<section id="faq" class="faq" data-reveal>
  <div class="container faq-inner">
    <p class="eyebrow">{t('nav.faq')}</p>
    <h2>{heading}</h2>
    <div class="faq-list">
      {
        faqs.map((faq) => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))
      }
    </div>
    <div class="faq-cta">
      <p class="faq-closing">{closing}</p>
      <CtaButton />
    </div>
  </div>
</section>

<style>
  .faq {
    position: relative;
    z-index: 1;
    background-color: var(--cream);
    padding-block: var(--space-6);
    border-top: var(--border) var(--ink);
  }
  .faq-inner {
    display: grid;
    gap: var(--space-2);
    max-width: 54rem;
  }
  .faq .eyebrow {
    color: var(--brick);
  }
  h2 {
    font-size: var(--text-h2);
    margin-bottom: var(--space-3);
  }

  .faq-list {
    display: grid;
  }
  .faq-item {
    border-top: var(--border) rgba(33, 8, 4, 0.25);
  }
  .faq-item:last-child {
    border-bottom: var(--border) rgba(33, 8, 4, 0.25);
  }
  summary {
    padding: var(--space-2) 0;
    font-weight: 800;
    font-size: var(--text-body);
    cursor: pointer;
    list-style-position: outside;
  }
  summary::marker {
    color: var(--terracotta);
  }
  .faq-item[open] summary {
    color: var(--brick);
  }
  .faq-item p {
    padding: 0 0 var(--space-2) 1.1rem;
    max-width: 65ch;
  }

  .faq-cta {
    margin-top: var(--space-4);
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }
  .faq-closing {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-h3);
    color: var(--brick);
  }
</style>
