---
/**
 * ÚNICO botón de compra del sitio (FR-010): mismo destino (#boletas),
 * mismo estilo y el mismo texto, 'cta.buy', en todas partes (2026-10-17).
 */
import { tFor } from '../ui';
import { sectionHref } from '../links';

interface Props {
  variant?: 'header' | 'inline';
}

const { variant = 'inline' } = Astro.props;
const t = tFor(Astro.url.pathname);
const href = sectionHref(Astro.url.pathname, 'boletas');
---

<a href={href} class:list={['cta', { 'cta--header': variant === 'header' }]}>
  {t('cta.buy')}
</a>
