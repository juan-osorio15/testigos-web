---
/**
 * ÚNICO botón de compra del sitio (FR-010): mismo texto (ui['cta.buy']),
 * mismo destino (#boletas), en header y cierres de sección.
 * Prohibido pasarle texto: el contrato data-schemas lo fija.
 */
import { t } from '../ui';

interface Props {
  variant?: 'header' | 'inline';
}

const { variant = 'inline' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---

<a href={`${base}#boletas`} class:list={['cta', { 'cta--header': variant === 'header' }]}>
  {t('cta.buy')}
</a>
