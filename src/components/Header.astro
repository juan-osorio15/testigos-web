---
/**
 * Header de dos estados (patrón 8.2): una sola franja que cambia como unidad.
 * Sobre el hero no existe: el logo y el CTA ya viven en el propio hero.
 * Cuando el contenido llega arriba, baja como una franja crema sólida.
 * La clase `.is-solid` la alterna el IntersectionObserver de EventLayout;
 * las páginas sin hero la reciben desde el servidor (`solid`) y sin JS el
 * fallback <noscript> lo deja visible, sólido y legible siempre.
 */
import { tFor } from '../ui';
import { sectionHref } from '../links';
import CtaButton from './CtaButton.astro';
import LogoLockup from '../assets/logo/logo-lockup.svg';

const t = tFor(Astro.url.pathname);

interface Props {
  /** Página sin hero: el header nace visible y sólido, sin animación de entrada. */
  solid?: boolean;
}

const { solid = false } = Astro.props;

/* Anclas con la base del despliegue delante ("/#agenda"): así el nav
   también funciona desde subpáginas como /tratamiento-de-datos/. */
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const navItems = [
  /* Mismo orden que la portada (2026-09-18): "Qué es" va después del lugar */
  { href: sectionHref(Astro.url.pathname, 'speakers'), label: t('nav.speakers') },
  { href: sectionHref(Astro.url.pathname, 'agenda'), label: t('nav.schedule') },
  { href: sectionHref(Astro.url.pathname, 'lugar'), label: t('nav.venue') },
  /* Hoteles aliados (2026-10-01): queremos que la gente llegue a ellos */
  { href: sectionHref(Astro.url.pathname, 'hospedaje'), label: t('nav.lodging') },
  { href: sectionHref(Astro.url.pathname, 'oportunidad'), label: t('nav.opportunity') },
];
---

<noscript>
  <style>
    header[data-header] {
      background-color: var(--cream);
      color: var(--ink);
      box-shadow: var(--shadow-1);
      transform: none;
      visibility: visible;
    }
  </style>
</noscript>

<header data-header class:list={[{ 'is-solid': solid }]}>
  <div class="header-inner">
    <a href={import.meta.env.BASE_URL} class="brand">
      <LogoLockup class="brand-logo" width={72} height={44} aria-hidden="true" />
      <span class="brand-name">Testigos de la Memoria</span>
    </a>
    <nav aria-label={t('nav.aria')} class="nav" id="site-nav">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="header-actions">
      <CtaButton variant="header" />
      {/* Menú estándar (2026-10-15): en pantallas sin espacio para los
          enlaces, un botón "Menú" los despliega bajo la franja */}
      <button
        type="button"
        class="menu-toggle"
        aria-controls="site-nav"
        aria-expanded="false"
        data-menu-toggle
        data-label-open={t('nav.menu')}
        data-label-close={t('nav.close')}
        aria-label={t('nav.menu')}
      >
        <span class="menu-icon" aria-hidden="true"></span>
        <span class="menu-text">{t('nav.menu')}</span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('header[data-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  if (header && toggle) {
    const setOpen = (open: boolean) => {
      header.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '');
    };
    toggle.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
    header.querySelectorAll('.nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (header.classList.contains('is-open') && !header.contains(e.target as Node)) setOpen(false);
    });
    // Si el header se recoge (vuelta al hero), el menú se cierra con él
    new MutationObserver(() => {
      if (!header.classList.contains('is-solid')) setOpen(false);
    }).observe(header, { attributes: true, attributeFilter: ['class'] });
  }
</script>

<style>
  /* Sobre el hero el header está recogido fuera de pantalla (arriba).
     Al llegar el contenido, baja como una sola franja crema, con la
     misma curva de salida del resto del sitio. `visibility` evita que
     el nav oculto reciba foco o clics. */
  header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--header-h);
    color: var(--ink);
    background-color: var(--cream);
    box-shadow: var(--shadow-1);
    transform: translateY(-100%);
    visibility: hidden;
    transition:
      transform 320ms var(--ease-out),
      visibility 0s linear 320ms;
  }
  header.is-solid {
    transform: none;
    visibility: visible;
    transition-delay: 0s;
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: 100%;
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .brand-logo {
    width: 104px;
    height: auto;
  }
  /* Nombre textual del enlace del logo: para lectores y buscadores */
  .brand-name {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .nav {
    display: flex;
    gap: clamp(0.9rem, 2vw, 1.75rem);
    margin-inline: auto;
    font-size: 1rem;
    font-weight: 700;
  }
  .nav a {
    position: relative;
    white-space: nowrap;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    padding-block: 0.2em;
    transition: border-color 160ms var(--ease-out);
  }
  .nav a:hover {
    border-bottom-color: var(--terracotta);
  }
  /* Punto de sección actual (scrollspy): a la izquierda de la palabra,
     posicionado en absoluto para no agregar espacio, en el color del texto */
  .nav a.is-active::before {
    content: '';
    position: absolute;
    left: -0.7em;
    top: 50%;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background-color: currentColor;
    transform: translateY(-50%);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
  }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: 0.5em;
    padding: 0.55em 0.8em;
    border: var(--border) var(--ink);
    border-radius: 0;
    background: none;
    color: var(--ink);
    font-weight: 800;
    font-size: 1rem;
    cursor: pointer;
  }
  .menu-toggle:hover,
  .menu-toggle:focus-visible {
    background-color: var(--ink);
    color: var(--cream);
  }
  /* Tres rayas en CSS: la de en medio es la caja, las otras sus sombras;
     abierto, dos rayas cruzadas */
  .menu-icon {
    position: relative;
    width: 1.1em;
    height: 2px;
    background-color: currentColor;
    box-shadow:
      0 -0.35em 0 currentColor,
      0 0.35em 0 currentColor;
  }
  header.is-open .menu-icon {
    box-shadow: none;
    background-color: transparent;
  }
  header.is-open .menu-icon::before,
  header.is-open .menu-icon::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: currentColor;
    transform: rotate(45deg);
  }
  header.is-open .menu-icon::after {
    transform: rotate(-45deg);
  }

  /* Con las etiquetas estándar (2026-10-15) los cinco enlaces, el logo y
     el CTA caben juntos desde ~960 px; por debajo los enlaces pasan al
     panel que despliega el botón "Menú". */
  @media (max-width: 60rem) {
    .nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      margin: 0;
      padding: var(--space-1) var(--gutter) var(--space-2);
      background-color: var(--cream);
      box-shadow: var(--shadow-1);
      font-size: 1.125rem;
    }
    header.is-open .nav {
      display: flex;
    }
    .nav a {
      padding-block: 0.8em;
      border-bottom: 1px solid rgba(33, 8, 4, 0.12);
    }
    .nav a:last-child {
      border-bottom: 0;
    }
    .nav a.is-active::before {
      display: none;
    }
    .menu-toggle {
      display: inline-flex;
    }
  }
  /* Celulares: el botón queda en solo icono para que quepa con logo y CTA */
  @media (max-width: 30rem) {
    .header-inner {
      gap: var(--space-2);
    }
    .brand-logo {
      width: 84px;
    }
    .header-actions {
      gap: var(--space-1);
    }
    .header-actions :global(.cta--header) {
      padding-inline: 1em;
    }
    .menu-text {
      display: none;
    }
    .menu-toggle {
      padding: 0.6em 0.7em;
      min-height: 2.75rem;
    }
  }
  @media (max-width: 23.4rem) {
    .brand-logo {
      width: 70px;
    }
    .header-actions :global(.cta--header) {
      padding-inline: 0.75em;
    }
    .menu-toggle {
      padding-inline: 0.55em;
    }
  }
</style>
