---
/**
 * Header de dos estados (patrón 8.2): una sola franja que cambia como unidad.
 * Sobre el hero: translúcido, elementos claros. Después: sólido crema, tinta.
 * La clase `.is-solid` la alterna el IntersectionObserver de EventLayout;
 * sin JS, el fallback <noscript> lo deja sólido y legible siempre.
 */
import { t, type Locale } from '../i18n/ui';
import { localePath, alternateUrl, otherLocale } from '../i18n/routes';
import CtaButton from './CtaButton.astro';
import LogoLockup from '../assets/logo/logo-lockup.svg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const navItems = [
  { href: '#oportunidad', label: t('nav.opportunity', locale) },
  { href: '#speakers', label: t('nav.speakers', locale) },
  { href: '#agenda', label: t('nav.schedule', locale) },
  { href: '#lugar', label: t('nav.venue', locale) },
  { href: '#faq', label: t('nav.faq', locale) },
];
---

<noscript>
  <style>
    header[data-header] {
      background-color: var(--cream);
      color: var(--ink);
      box-shadow: var(--shadow-1);
    }
  </style>
</noscript>

<header data-header>
  <div class="header-inner">
    <a href={localePath(locale)} class="brand">
      <LogoLockup class="brand-logo" width={72} height={44} aria-hidden="true" />
      <span class="brand-name">Testigos de la Memoria</span>
    </a>
    <nav aria-label={t('nav.aria', locale)} class="nav">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="header-actions">
      <details class="lang">
        <summary aria-label={t('lang.label', locale)}>
          <svg
            class="lang-globe"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="9"></circle>
            <ellipse cx="12" cy="12" rx="4" ry="9"></ellipse>
            <path d="M3.6 9h16.8M3.6 15h16.8"></path>
          </svg>
          <span class="lang-code">{locale.toUpperCase()}</span>
          <span class="lang-caret" aria-hidden="true">▾</span>
        </summary>
        <ul class="lang-menu" role="list">
          <li>
            <span class="lang-option is-current" aria-current="true" lang={locale}>
              {locale === 'es' ? 'Español' : 'English'}
            </span>
          </li>
          <li>
            <a
              class="lang-option"
              href={alternateUrl(locale)}
              hreflang={otherLocale(locale)}
              lang={otherLocale(locale)}
              data-lang-link
            >
              {otherLocale(locale) === 'es' ? 'Español' : 'English'}
            </a>
          </li>
        </ul>
      </details>
      <CtaButton locale={locale} variant="header" />
    </div>
  </div>
</header>

<style>
  header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--header-h);
    color: var(--cream);
    background-color: rgba(33, 8, 4, 0.28);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px); /* única excepción del brief §9: legibilidad sobre el hero */
    transition:
      background-color 220ms var(--ease-out),
      color 220ms var(--ease-out),
      box-shadow 220ms var(--ease-out);
  }
  header.is-solid {
    color: var(--ink);
    background-color: var(--cream);
    box-shadow: var(--shadow-1);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: 100%;
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .brand-logo {
    width: 72px;
    height: auto;
  }
  /* Nombre textual del enlace del logo: para lectores y buscadores */
  .brand-name {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .nav {
    display: flex;
    gap: clamp(0.9rem, 2vw, 1.6rem);
    margin-inline: auto;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .nav a {
    text-decoration: none;
    border-bottom: 2px solid transparent;
    padding-block: 0.2em;
    transition: border-color 160ms var(--ease-out);
  }
  .nav a:hover {
    border-bottom-color: var(--terracotta);
  }

  .header-actions {
    display: flex;
    align-items: center;
    /* El CTA de compra es el protagonista: el selector de idioma guarda distancia */
    gap: var(--space-4);
    margin-left: auto;
  }

  .lang {
    position: relative;
  }
  .lang summary {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    cursor: pointer;
    list-style: none;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.35em 0.2em;
  }
  .lang summary::-webkit-details-marker {
    display: none;
  }
  .lang-globe {
    width: 1.1rem;
    height: 1.1rem;
  }
  .lang-caret {
    font-size: 0.7em;
    transition: transform 160ms var(--ease-out);
  }
  .lang[open] .lang-caret {
    transform: rotate(180deg);
  }

  /* Panel siempre sólido y legible, en ambos estados del header */
  .lang-menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    min-width: 9rem;
    margin: 0;
    padding: 0.4rem;
    list-style: none;
    display: grid;
    background-color: var(--cream);
    color: var(--ink);
    border: var(--border) var(--ink);
    border-radius: 12px;
    box-shadow: var(--shadow-1);
  }
  .lang-option {
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.5em 0.7em;
    border-radius: 8px;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }
  .lang-option.is-current {
    font-weight: 800;
  }
  .lang-option.is-current::after {
    content: '';
    width: 0.45em;
    height: 0.45em;
    border-radius: 999px;
    background-color: var(--terracotta);
  }
  a.lang-option:hover {
    background-color: var(--ink);
    color: var(--cream);
  }

  @media (max-width: 47.9rem) {
    .nav {
      display: none; /* móvil: logo + idioma + CTA; las secciones se alcanzan por scroll */
    }
  }
</style>
