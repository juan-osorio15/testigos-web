---
/**
 * Header de dos estados (patrón 8.2): una sola franja que cambia como unidad.
 * Sobre el hero no existe: el logo y el CTA ya viven en el propio hero.
 * Cuando el contenido llega arriba, baja como una franja crema sólida.
 * La clase `.is-solid` la alterna el IntersectionObserver de EventLayout;
 * las páginas sin hero la reciben desde el servidor (`solid`) y sin JS el
 * fallback <noscript> lo deja visible, sólido y legible siempre.
 */
import { t } from '../ui';
import { sectionHref } from '../links';
import CtaButton from './CtaButton.astro';
import LogoLockup from '../assets/logo/logo-lockup.svg';

interface Props {
  /** Página sin hero: el header nace visible y sólido, sin animación de entrada. */
  solid?: boolean;
}

const { solid = false } = Astro.props;

/* Anclas con la base del despliegue delante ("/#agenda"): así el nav
   también funciona desde subpáginas como /tratamiento-de-datos/. */
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const navItems = [
  { href: sectionHref(Astro.url.pathname, 'oportunidad'), label: t('nav.opportunity') },
  { href: sectionHref(Astro.url.pathname, 'speakers'), label: t('nav.speakers') },
  { href: sectionHref(Astro.url.pathname, 'agenda'), label: t('nav.schedule') },
  { href: sectionHref(Astro.url.pathname, 'lugar'), label: t('nav.venue') },
  { href: sectionHref(Astro.url.pathname, 'faq'), label: t('nav.faq') },
];
---

<noscript>
  <style>
    header[data-header] {
      background-color: var(--cream);
      color: var(--ink);
      box-shadow: var(--shadow-1);
      transform: none;
      visibility: visible;
    }
  </style>
</noscript>

<header data-header class:list={[{ 'is-solid': solid }]}>
  <div class="header-inner">
    <a href={import.meta.env.BASE_URL} class="brand">
      <LogoLockup class="brand-logo" width={72} height={44} aria-hidden="true" />
      <span class="brand-name">Testigos de la Memoria</span>
    </a>
    <nav aria-label={t('nav.aria')} class="nav">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="header-actions">
      <CtaButton variant="header" />
    </div>
  </div>
</header>

<style>
  /* Sobre el hero el header está recogido fuera de pantalla (arriba).
     Al llegar el contenido, baja como una sola franja crema, con la
     misma curva de salida del resto del sitio. `visibility` evita que
     el nav oculto reciba foco o clics. */
  header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--header-h);
    color: var(--ink);
    background-color: var(--cream);
    box-shadow: var(--shadow-1);
    transform: translateY(-100%);
    visibility: hidden;
    transition:
      transform 320ms var(--ease-out),
      visibility 0s linear 320ms;
  }
  header.is-solid {
    transform: none;
    visibility: visible;
    transition-delay: 0s;
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: 100%;
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .brand-logo {
    width: 72px;
    height: auto;
  }
  /* Nombre textual del enlace del logo: para lectores y buscadores */
  .brand-name {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .nav {
    display: flex;
    gap: clamp(0.9rem, 2vw, 1.6rem);
    margin-inline: auto;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .nav a {
    position: relative;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    padding-block: 0.2em;
    transition: border-color 160ms var(--ease-out);
  }
  .nav a:hover {
    border-bottom-color: var(--terracotta);
  }
  /* Punto de sección actual (scrollspy): a la izquierda de la palabra,
     posicionado en absoluto para no agregar espacio, en el color del texto */
  .nav a.is-active::before {
    content: '';
    position: absolute;
    left: -0.7em;
    top: 50%;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background-color: currentColor;
    transform: translateY(-50%);
  }

  .header-actions {
    display: flex;
    align-items: center;
    margin-left: auto;
  }

  @media (max-width: 47.9rem) {
    .nav {
      display: none; /* móvil: logo + CTA; las secciones se alcanzan por scroll */
    }
  }
</style>
