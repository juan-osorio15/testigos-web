---
/**
 * Header de dos estados (patrón 8.2): una sola franja que cambia como unidad.
 * Sobre el hero: translúcido, elementos claros. Después: sólido crema, tinta.
 * La clase `.is-solid` la alterna el IntersectionObserver de EventLayout;
 * sin JS, el fallback <noscript> lo deja sólido y legible siempre.
 */
import { t } from '../ui';
import CtaButton from './CtaButton.astro';
import LogoLockup from '../assets/logo/logo-lockup.svg';

/* Anclas con la base del despliegue delante ("/#agenda"): así el nav
   también funciona desde subpáginas como /tratamiento-de-datos/. */
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const navItems = [
  { href: `${base}#oportunidad`, label: t('nav.opportunity') },
  { href: `${base}#speakers`, label: t('nav.speakers') },
  { href: `${base}#agenda`, label: t('nav.schedule') },
  { href: `${base}#lugar`, label: t('nav.venue') },
  { href: `${base}#faq`, label: t('nav.faq') },
];
---

<noscript>
  <style>
    header[data-header] {
      background-color: var(--cream);
      color: var(--ink);
      box-shadow: var(--shadow-1);
    }
  </style>
</noscript>

<header data-header>
  <div class="header-inner">
    <a href={import.meta.env.BASE_URL} class="brand">
      <LogoLockup class="brand-logo" width={72} height={44} aria-hidden="true" />
      <span class="brand-name">Testigos de la Memoria</span>
    </a>
    <nav aria-label={t('nav.aria')} class="nav">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="header-actions">
      <CtaButton variant="header" />
    </div>
  </div>
</header>

<style>
  /* El hero es claro (bloques crema/terracota/cielo): tinta en ambos
     estados; solo cambia el fondo — transparente sobre el hero, crema
     sólido con sombra sutil al salir de él. */
  header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--header-h);
    color: var(--ink);
    background-color: transparent;
    transition:
      background-color 220ms var(--ease-out),
      box-shadow 220ms var(--ease-out);
  }
  header.is-solid {
    background-color: var(--cream);
    box-shadow: var(--shadow-1);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: 100%;
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .brand-logo {
    width: 72px;
    height: auto;
  }
  /* Nombre textual del enlace del logo: para lectores y buscadores */
  .brand-name {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .nav {
    display: flex;
    gap: clamp(0.9rem, 2vw, 1.6rem);
    margin-inline: auto;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .nav a {
    position: relative;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    padding-block: 0.2em;
    transition: border-color 160ms var(--ease-out);
  }
  .nav a:hover {
    border-bottom-color: var(--terracotta);
  }
  /* Punto de sección actual (scrollspy): a la izquierda de la palabra,
     posicionado en absoluto para no agregar espacio, en el color del texto */
  .nav a.is-active::before {
    content: '';
    position: absolute;
    left: -0.7em;
    top: 50%;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background-color: currentColor;
    transform: translateY(-50%);
  }

  .header-actions {
    display: flex;
    align-items: center;
    margin-left: auto;
  }

  @media (max-width: 47.9rem) {
    .nav {
      display: none; /* móvil: logo + CTA; las secciones se alcanzan por scroll */
    }
  }
</style>
