---
/**
 * Agenda (FR-004): una tabla por día — hora | sesión | acción.
 * Talleres: etiqueta "Entrada libre". Conversatorios: botón de compra
 * en la propia fila (decisión del usuario 2026-09-02; reemplaza al badge
 * "Con boleta" y al CTA de cierre de la sección). "Por confirmar" para
 * todo dato sin fuente (FR-005).
 */
import { t } from '../ui';
import { agenda, dayLabels, type EventDay } from '../data/agenda';
import { venueById } from '../data/event';
import { speakerBySlug } from '../data/speakers';
import CtaButton from './CtaButton.astro';

const days = Object.keys(dayLabels) as EventDay[];
const slotsByDay = (day: EventDay) => agenda.filter((s) => s.day === day);

const heading = 'Cuatro días en Villa de Leyva';
---

<section id="agenda" class="schedule" data-reveal>
  <div class="container">
    <p class="eyebrow">{t('nav.schedule')}</p>
    <h2>{heading}</h2>
    <div class="schedule-days">
      {
        days.map((day) => (
          <div class="schedule-day">
            <h3>{dayLabels[day]}</h3>
            <table>
              <tbody>
                {slotsByDay(day).map((slot) => {
                  const venue = venueById(slot.venueId);
                  const free = slot.type === 'taller';
                  const panelists = [
                    ...slot.speakerSlugs.map((s) => speakerBySlug(s).name),
                    ...((slot.tbdPanelists ?? 0) > 0 ? [t('speakers.tbd')] : []),
                  ];
                  return (
                    <tr class:list={['slot', { 'slot--free': free }]}>
                      <td class="slot-time">{slot.time ?? t('schedule.tbd')}</td>
                      <td class="slot-body">
                        <p class="slot-title">{slot.title ?? t('schedule.titleTbd')}</p>
                        {panelists.length > 0 && <p class="slot-speakers">{panelists.join(' · ')}</p>}
                        <p class="slot-venue">{venue.name}</p>
                      </td>
                      <td class="slot-action">
                        {free ? (
                          <p class="slot-badge">{t('schedule.free')}</p>
                        ) : (
                          <CtaButton variant="header" />
                        )}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .schedule {
    position: relative;
    z-index: 1;
    background-color: var(--cream);
    padding-block: var(--space-6);
    border-top: var(--border) var(--ink);
  }
  .schedule .eyebrow {
    color: var(--brick);
  }
  h2 {
    font-size: var(--text-h2);
    margin-block: var(--space-1) var(--space-4);
  }

  .schedule-days {
    display: grid;
    gap: var(--space-4);
  }
  .schedule-day h3 {
    font-weight: 800;
    font-size: var(--text-h3);
    margin-bottom: var(--space-2);
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }
  .slot > td {
    padding: var(--space-2);
    border-top: var(--border) rgba(33, 8, 4, 0.25);
    vertical-align: top;
  }
  table tr:last-child > td {
    border-bottom: var(--border) rgba(33, 8, 4, 0.25);
  }
  /* Acento sólido por tipo, en la primera celda (nunca gradiente) */
  .slot > td:first-child {
    border-left: 6px solid var(--terracotta);
  }
  .slot--free > td:first-child {
    border-left-color: var(--olive);
  }

  .slot-time {
    width: 11rem;
    font-weight: 700;
    font-size: var(--text-small);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .slot-body {
    display: grid;
    gap: 0.2rem;
  }
  .slot-title {
    font-weight: 700;
    font-size: var(--text-body);
  }
  .slot-speakers {
    font-size: var(--text-body);
  }
  .slot-venue {
    font-size: var(--text-small);
    opacity: 0.75;
  }

  .slot-action {
    width: 1%;
    white-space: nowrap;
    text-align: right;
  }
  .slot-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: var(--text-label);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.35em 0.8em;
    border: var(--border) var(--ink);
    color: var(--ink);
  }
  .slot-badge::before {
    content: '';
    width: 0.65em;
    height: 0.65em;
    background-color: var(--olive);
  }

  @media (max-width: 47.9rem) {
    table,
    tbody,
    tr,
    td {
      display: block;
      width: 100%;
    }
    .slot {
      border-top: var(--border) rgba(33, 8, 4, 0.25);
      border-left: 6px solid var(--terracotta);
      padding-block: var(--space-2);
    }
    .slot--free {
      border-left-color: var(--olive);
    }
    .slot > td,
    .slot > td:first-child {
      border: 0;
      padding: 0.2rem var(--space-2);
    }
    table tr:last-child > td {
      border: 0;
    }
    table tr:last-child {
      border-bottom: var(--border) rgba(33, 8, 4, 0.25);
    }
    .slot-time {
      width: auto;
    }
    .slot-action {
      text-align: left;
      padding-top: 0.6rem;
      padding-bottom: 0.6rem;
    }
  }
</style>
