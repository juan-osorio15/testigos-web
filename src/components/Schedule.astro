---
/**
 * Agenda (FR-004): una tabla por día — hora | sesión | acción.
 * Charlas abiertas: enlace "Quiero saber más" a /charlas-abiertas/ con la
 * marca oliva de lo gratuito. Conversatorios: botón de compra en la propia
 * fila (decisión del usuario 2026-09-02; reemplaza al badge "Con boleta" y
 * al CTA de cierre de la sección). Sin enlaces al pie de la sección: la
 * agenda ya está completa aquí (decisión del 2026-09-18). Filas compactas:
 * solo título y personas; la sede no se repite en cada fila, la dice una
 * leyenda arriba con los dos colores que marcan las filas (oliva = charla
 * abierta en la Casa Museo, terracota = conversatorio en Duruelo;
 * 2026-09-19). Las notas largas quedan para /programacion/. Todo dato sin fuente
 * (hora, sede, panelistas) se omite en vez de marcarse "por confirmar"
 * (FR-005 + decisión del usuario 2026-09-03).
 */
import { tFor } from '../ui';
import { langOf } from '../i18n';
import { agendaFor, dayLabelsFor, type EventDay } from '../data/agenda';
import { venueById } from '../data/event';
import { speakersFor } from '../data/speakers';
import { sessionHref, speakerPath } from '../routes';
import CtaButton from './CtaButton.astro';

const t = tFor(Astro.url.pathname);
const lang = langOf(Astro.url.pathname);
const agenda = agendaFor(lang);
const dayLabels = dayLabelsFor(lang);
const speakerBySlug = (slug: string) => {
  const s = speakersFor(lang).find((s) => s.slug === slug);
  if (!s) throw new Error(`Speaker desconocido: ${slug}`);
  return s;
};

/* Leyenda: cada tipo de sesión con su color, su sede y su entrada */
const legend = [
  { tone: 'olive', label: t('schedule.legendTalks'), venue: venueById('casa-museo').name },
  { tone: 'terracotta', label: t('schedule.legendPanels'), venue: venueById('duruelo').name },
] as const;

const days = Object.keys(dayLabels) as EventDay[];
const slotsByDay = (day: EventDay) => agenda.filter((s) => s.day === day);

const heading = t('schedule.heading');
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---

<section id="agenda" class="schedule" data-reveal>
  <div class="container">
    <p class="eyebrow">{t('nav.schedule')}</p>
    <h2>{heading}</h2>
    <ul class="schedule-legend" role="list">
      {
        legend.map((l) => (
          <li class:list={['legend-item', `legend-item--${l.tone}`]}>
            <span class="legend-label">{l.label}</span>
            <span class="legend-venue">{l.venue}</span>
          </li>
        ))
      }
    </ul>
    <div class="schedule-days">
      {
        days.map((day) => (
          <div class="schedule-day">
            <h3>{dayLabels[day]}</h3>
            <table>
              <tbody>
                {slotsByDay(day).map((slot) => {
                  const free = slot.type === 'charla';
                  /* Solo nombres confirmados: panelistas con tarjeta (enlazados a
                     su ficha, feature 002) e invitados. */
                  const people = slot.speakerSlugs.map(speakerBySlug);
                  const guests = slot.guests ?? [];
                  const hasPeople = people.length > 0 || guests.length > 0;
                  return (
                    <tr class:list={['slot', { 'slot--free': free }]} id={`sesion-${slot.slug}`}>
                      <td class="slot-time">{slot.time}</td>
                      <td class="slot-body">
                        <p class="slot-title">
                          <a href={`${base}${sessionHref(slot).slice(1)}`}>{slot.title}</a>
                        </p>
                        {hasPeople && (
                          <p class="slot-speakers">
                            {people.map((sp, i) => (
                              <>
                                {i > 0 && ' · '}
                                <a href={speakerPath(sp.slug)}>{sp.name}</a>
                              </>
                            ))}
                            {guests.map((g, i) => (
                              <>
                                {(people.length > 0 || i > 0) && ' · '}
                                <span>{g}</span>
                              </>
                            ))}
                          </p>
                        )}
                      </td>
                      <td class="slot-action">
                        {free ? (
                          <a class="slot-badge" href={`${base}charlas-abiertas/`}>{t('schedule.freeCta')}</a>
                        ) : (
                          <CtaButton variant="header" label="cta.secure" />
                        )}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .slot-title a,
  .slot-speakers a {
    text-decoration: none;
  }
  .slot-title a:hover,
  .slot-title a:focus-visible,
  .slot-speakers a:hover,
  .slot-speakers a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .schedule {
    position: relative;
    z-index: 1;
    background-color: var(--cream);
    padding-block: var(--space-6);
    border-top: var(--border) var(--ink);
  }
  .schedule .eyebrow {
    color: var(--brick);
  }
  h2 {
    font-size: var(--text-h2);
    margin-block: var(--space-1) var(--space-4);
  }

  /* Leyenda de colores: el mismo filo que llevan las filas, con la sede */
  .schedule-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-4);
  }
  /* Cada entrada lleva el mismo cuadrado sólido del botón "Quiero saber
     más", en el color de su tipo, delante de la etiqueta */
  .legend-item {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.5em;
    row-gap: 0.15em;
    align-items: baseline;
  }
  .legend-item::before {
    content: '';
    grid-row: 1;
    align-self: center;
    width: 0.65em;
    height: 0.65em;
    background-color: var(--terracotta);
  }
  .legend-item--olive::before {
    background-color: var(--olive);
  }
  .legend-label {
    grid-column: 2;
    font-size: var(--text-label);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .legend-venue {
    grid-column: 2;
    font-size: var(--text-small);
    opacity: 0.8;
  }
  .schedule-days {
    display: grid;
    gap: var(--space-3);
  }
  .schedule-day h3 {
    font-weight: 800;
    font-size: var(--text-h3);
    margin-bottom: var(--space-1);
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }
  .slot > td {
    padding: 0.75rem var(--space-2);
    border-top: var(--border) rgba(33, 8, 4, 0.25);
    vertical-align: middle;
  }
  /* Charlas abiertas: la fila más corta, solo título y personas */
  .slot--free > td {
    padding-block: 0.5rem;
  }
  table tr:last-child > td {
    border-bottom: var(--border) rgba(33, 8, 4, 0.25);
  }
  /* Acento sólido por tipo, en la primera celda (nunca gradiente) */
  .slot > td:first-child {
    border-left: 6px solid var(--terracotta);
  }
  .slot--free > td:first-child {
    border-left-color: var(--olive);
  }

  .slot-time {
    width: 11rem;
    font-weight: 700;
    font-size: var(--text-small);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  /* Sigue siendo celda de tabla (un display:grid la desalinearía del resto
     de la fila); el ritmo interno va por márgenes. */
  .slot-body > * + * {
    margin-top: 0.2rem;
  }
  .slot-title {
    font-weight: 700;
    font-size: var(--text-body);
  }
  .slot-speakers {
    font-size: var(--text-body);
  }

  .slot-action {
    width: 1%;
    white-space: nowrap;
    text-align: right;
  }
  .slot-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: var(--text-label);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.35em 0.8em;
    border: var(--border) var(--ink);
    color: var(--ink);
    text-decoration: none;
    transition: background-color 160ms var(--ease-out), color 160ms var(--ease-out);
  }
  .slot-badge:hover,
  .slot-badge:focus-visible {
    background-color: var(--ink);
    color: var(--cream);
  }
  .slot-badge::before {
    content: '';
    width: 0.65em;
    height: 0.65em;
    background-color: var(--olive);
  }

  @media (max-width: 47.9rem) {
    table,
    tbody,
    tr,
    td {
      display: block;
      width: 100%;
    }
    .slot {
      border-top: var(--border) rgba(33, 8, 4, 0.25);
      border-left: 6px solid var(--terracotta);
      padding-block: var(--space-2);
    }
    .slot--free {
      border-left-color: var(--olive);
    }
    .slot > td,
    .slot > td:first-child {
      border: 0;
      padding: 0.2rem var(--space-2);
    }
    table tr:last-child > td {
      border: 0;
    }
    table tr:last-child {
      border-bottom: var(--border) rgba(33, 8, 4, 0.25);
    }
    .slot-time {
      width: auto;
    }
    .slot-action {
      text-align: left;
      padding-top: 0.6rem;
      padding-bottom: 0.6rem;
    }
  }
</style>
