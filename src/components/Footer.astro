---
/**
 * Pie de página: firma del evento, quiénes organizan y quiénes apoyan,
 * y los enlaces legales. Sobre tinta, con los logos de los aliados en
 * crema monocromo (src/data/partners.ts) a una altura fija por grupo:
 * el peso de cada aliado lo marca el tamaño, no el color.
 */
import { Image } from 'astro:assets';
import { tFor } from '../ui';
import { event } from '../data/event';
import { organizerPartners, partnerGroups } from '../data/partners';
import LogoSymbol from '../assets/logo/logo-symbol.svg';
import { langOf } from '../i18n';

const t = tFor(Astro.url.pathname);
/* Las páginas interiores solo existen en español: desde /en/ no se enlazan */
const innerPages = langOf(Astro.url.pathname) === 'es';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';

/* Alto de render (px) por tamaño; el CSS fija el alto visible en rem */
const renderHeight = { lg: 216, md: 168, sm: 120 } as const;
---

<footer class="footer">
  <div class="container footer-inner">
    <LogoSymbol class="footer-symbol" aria-hidden="true" width={94} height={25} />

    <div class="footer-groups">
      <div class="footer-group">
        <p class="eyebrow">{t('footer.organizedBy')}</p>
        <div class="footer-row">
          <p class="footer-names">{event.organizers.join(' · ')}</p>
          {
            organizerPartners.map((p) => (
              <Image
                class="footer-logo footer-logo--md"
                src={p.logo}
                alt={p.name}
                height={renderHeight.md}
                loading="lazy"
              />
            ))
          }
        </div>
      </div>

      {
        partnerGroups.map((group) => (
          <div class="footer-group">
            <p class="eyebrow">{t(group.label)}</p>
            <div class="footer-row">
              {group.partners.map((p) => (
                <Image
                  class:list={['footer-logo', `footer-logo--${group.size}`, p.shape && `footer-logo--${p.shape}`]}
                  src={p.logo}
                  alt={p.name}
                  height={p.shape === 'square' ? renderHeight.md : renderHeight[group.size]}
                  loading="lazy"
                />
              ))}
            </div>
          </div>
        ))
      }
    </div>

    {
      innerPages && (
        <nav class="footer-pages" aria-label={t('footer.pagesAria')}>
          <a href={`${base}panelistas/`}>{t('footer.speakers')}</a>
          <a href={`${base}programacion/`}>{t('footer.schedule')}</a>
          <a href={`${base}charlas-abiertas/`}>{t('footer.talks')}</a>
          <a href={`${base}como-llegar/`}>{t('footer.directions')}</a>
        </nav>
      )
    }

    <p class="footer-small">
      {t('footer.rights')} · <a href={`${base}tratamiento-de-datos/`}>{t('footer.privacy')}</a> ·
      <a href={`${base}terminos-y-condiciones/`}>{t('footer.terms')}</a> ·
      <a href={`${base}tratamiento-de-datos/#cookies`} data-open-consent-prefs>{t('consent.prefsLink')}</a>
    </p>
  </div>
</footer>

<style>
  .footer {
    /* Sobre el hero fijo (z 0), como el resto de la cortina */
    position: relative;
    z-index: 1;
    background-color: var(--ink);
    color: var(--cream);
    padding-block: var(--space-5);
  }
  .footer-inner {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }
  .footer-symbol {
    width: 94px;
  }

  .footer-groups {
    display: grid;
    gap: var(--space-4);
    width: 100%;
  }
  .footer-group {
    display: grid;
    gap: var(--space-2);
  }
  .footer-group .eyebrow {
    color: var(--terracotta);
  }
  .footer-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
  }
  .footer-names {
    font-weight: 500;
    font-size: var(--text-lead);
  }

  /* Los logos ya vienen en crema; el alto fijo por grupo da la jerarquía */
  .footer-logo {
    width: auto;
    display: block;
  }
  .footer-logo--lg {
    height: clamp(4.25rem, 3rem + 2.5vw, 5.5rem);
  }
  .footer-logo--md {
    height: clamp(2.75rem, 2rem + 1.5vw, 3.5rem);
  }
  .footer-logo--sm {
    height: 2.25rem;
    opacity: 0.8;
  }
  /* Sellos cuadrados: más alto que los logotipos apaisados de su grupo */
  .footer-logo--sm.footer-logo--square {
    height: 3.5rem;
  }

  .footer-pages {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    font-size: var(--text-small);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .footer-pages a {
    text-decoration: none;
    text-underline-offset: 0.2em;
  }
  .footer-pages a:hover,
  .footer-pages a:focus-visible {
    color: var(--terracotta);
    text-decoration: underline;
  }

  .footer-small {
    font-size: var(--text-small);
    opacity: 0.7;
  }
  .footer-small a {
    text-underline-offset: 0.2em;
  }
  .footer-small a:hover {
    color: var(--terracotta);
  }
</style>
